		USERNAME="`cat /usr/local/username`"
		echo "---- zfsbootmenu-installer: debian derivative: ${USERNAME} is become admin, destroyer of systems"
		# usermod seems missing on Trixie installs.
		for GROUP in adm cdrom dip lpadmin lxd plugdev sambashare sudo; do
			adduser "${USERNAME}" "${GROUP}"
			EXIT_CODE=$?
			if test X$EXIT_CODE '!=' X0; then
				echo "$0": Could not add user $USERNAME to $GROUP >&2
				exit $EXIT_CODE
			fi
		done
		echo "${USERNAME} ALL=(ALL) NOPASSWD: ALL" >/etc/sudoers.d/"${USERNAME}"
		chown root:root /etc/sudoers.d/"${USERNAME}"
		chmod 400 /etc/sudoers.d/"${USERNAME}"
		exit 0
