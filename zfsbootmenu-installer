			;;

		creative|evo|excalibur|executive|hero-s|nas|one|prox|zero)
			exec apt install -y  slimbook-meta-$FAMILY
			;;

		*)
			echo "---- zfsbootmenu-installer: Not recognized as Slinbook device."
			;;

		esac
		exit 0
		;;

	# Core Slimbook OS installation.
	slimbook-install-chroot)
		if test X${3+set} '!=' Xset; then
			echo "$0": Need RELEASE YEAR arguments >&2
			exit 1
		fi
		RELEASE="$2"
		YEAR="$3"
		case $YEAR in
		26)
			KERNEL=linux-generic-hwe-$YEAR.04
			;;

		*)
			echo "$0": Unrecognized YEAR: $YEAR >&2
			exit 1
			;;

		esac
		"$0" slimbook-sources "$RELEASE" "$YEAR" && \
		"$0" debian-derivative-prepare && \
		"$0" slimbook-install-chroot-addl-early "$YEAR" && \
		apt install -y --no-install-recommends $KERNEL && \
		"$0" debian-derivative-install-chroot-basics
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		"$0" debian-derivative-install-chroot-more && \
		"$0" debian-derivative-install-chroot-zfs-support && \
		"$0" debian-derivative-install-chroot-zfs-config && \
		"$0" slimbook-install-chroot-addl "$YEAR" && \
		"$0" debian-derivative-install-chroot-make-user
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		"$0" slimbook-install-chroot-device-specific "$YEAR" && \
		"$0" typical-enable-auto-login
		exit $?
		;;

	# zfsbootmenu-installer hooks

	# Hook this on adding a new file, or modifying
	# a file, to the system:
	# install, upgrade, downgrade
	zbmi-post-new-hook)
		# TODO find unsigned kernel modules and
		# sign them with the MOK
		exit 0
		;;

	# Hook this on a change in the system:
	# install, upgrade, downgrade, uninstall
	zbmi-post-change-hook)
		exec "$0" follow-grub-cmdline-linux-default
		;;

	# Prints out a small shell script that only
	# calls into zfsbootmenu-installer if DPKG is
	# installing, removing, or purging.
	# We use this instead of calling drectly into
	# /usr/local/bin/zfsbootmenu-installer zbmi-post-add-hook et al
	# so that other dpkg actions like
	# configure etc do not require loading the
	# 2000-line zfsbootmenu-installer
	zbmi-print-dpkg-post-hook)
		cat <<SCRIPT
#! /bin/sh
case \$DPKG_HOOK_ACTION in
install)
	/usr/local/bin/zfsbootmenu-installer zbmi-post-new-hook &&
	/usr/local/bin/zfsbootmenu-installer zbmi-post-change-hook
	exit \$?
	;;

remove|purge)
	exec /usr/local/bin/zfsbootmenu-installer zbmi-post-change-hook
	;;

esac
exit 0
SCRIPT
		;;

	zbmi-install-dpkg-post-hook)
		"$0" mkdir-p /usr/local/lib/zfsbootmenu-installer
		"$0" zbmi-print-dpkg-post-hook > /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		chmod +x /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		exec test -x /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		;;

	################################################# distro

	################################################# Grub cmdline Linux Default

	find-grub-cmdline-linux-default-core)
		for DIR in /etc/grub.d /etc/default/grub.d; do
			cd "$DIR"
			for FILE in [0-9][0-9]_* *.cfg; do
				# Nonexistent? Maybe posix-me-harder
				# shell letting the * pass through
				# when the dir is empty.
				if test '!' -f $FILE; then
					: # skip
				else
					grep '^[ 	]*GRUB_CMDLINE_LINUX_DEFAULT[ 	]*=[ 	]*"$GRUB_CMDLINE_LINUX_DEFAULT  *[^"]*"[ 	]*$' $FILE | \
					sed -e 's@^[ 	]*GRUB_CMDLINE_LINUX_DEFAULT[ 	]*=[ 	]*"$GRUB_CMDLINE_LINUX_DEFAULT  *\([^"]*\)"[ 	]*$@\1@'
				fi
			done
		done
		;;

	find-grub-cmdline-linux-default)
		echo `"$0" find-grub-cmdline-linux-default-core`
		;;

	# Intended to be used in a package manager
	# post-install hook.
	# This changes the `org.zfsbootmenu:commandline`
	# option of the currently mounted root dataset.
	follow-grub-cmdline-linux-default)
		MY_BE="`"$0" find-current-boot-environment`"
		if test $? '!=' 0; then
			"$0" ensure logger
			logger --id=$$ --priority=user.warning 'zfsbootmenu-installer follow-grub-cmdline-linux-default: Unable to find our current boot environment'
			exit 1
		fi
		if zfs list "$MY_BE" > /dev/null 2>&1; then :; else
			"$0" ensure logger
			logger --id=$$ --priority=user.warning 'zfsbootmenu-installer follow-grub-cmdline-linux-default: Current / is not a ZFS dataset'
			exit 1
		fi
		CMDLINE="`"$0" find-grub-cmdline-linux-default`"
		SETTING='%{parent} '"$CMDLINE"
		CUR_SETTING="`zfs get -H -o value org.zfsbootmenu:commandline $MY_BE`"
		if test X"$CUR_SETTING" '!=' X"$SETTING"; then
			zfs set org.zfsbootmenu:commandline="$SETTING" "$MY_BE"
			logger --id=$$ --priority=user.debug "zfsbootmenu-installer follow-grub-cmdline-linux-default: Linux commandline for $MY_BE changed to $CMDLINE"
		fi
		exit 0
		;;

	################################################# Grub cmdline Linux Default

        ################################################# install Boot Environment

	check-distro-not-installed)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if zfs list $TANK_NAME/ROOT/"$DISTRO" > /dev/null 2>&1; then
			echo "$0": Boot environment exists: $DISTRO >&2
			echo "$0": If you want to force-reinstall it, destroy it first: >&2
			echo "$0":'     'zfs destroy -R $TANK_NAME/ZROOT/$DISTRO >&2
			exit 1
		fi
		exit 0
		;;

	# Used by AddBootEnvironment to set up
	# $WORKDIR/config from an existing
	# installation.
	prepare-work-from-existing)
		if "$0" detect-installed; then :; else
			echo "$0": not on an existing zfsbootmenu-installer system >&2
			exit 1
		fi
		"$0" mkdir-p ${WORKDIR}/config || exit 1
		rm -rf ${WORKDIR}/config/* > /dev/null 2>&1
		for FILE in /etc/hostid /etc/hostname /etc/zfs/zroot.key \
				 /usr/local/mok /usr/local/username
		do
			DSTFILE=`echo "$FILE" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
			echo $DSTFILE
			cp -R --reflink=auto $FILE ${WORKDIR}/config
			if test '!' -e ${WORKDIR}/config/$DSTFILE; then
				echo "$0": Failed to copy $FILE into workdir? >&2
				exit 1
			fi
		done
		exit 0
		;;

	# Introduce our config into the target.
	copy-config-to-new-distro)
		"$0" mkdir-p $WORKDIR/mnt/etc/zfs || exit 1
		"$0" mkdir-p $WORKDIR/mnt/usr/local/bin || exit 1
		"$0" mkdir-p $WORKDIR/mnt/usr/local/mok || exit 1
		cp $WORKDIR/config/hostid $WORKDIR/mnt/etc/hostid && \
		cp $WORKDIR/config/hostname $WORKDIR/mnt/etc/hostname && \
		cp $WORKDIR/config/zroot.key $WORKDIR/mnt/etc/zfs/zroot.key && \
		cp $WORKDIR/config/mok/MOK.priv $WORKDIR/mnt/usr/local/mok/MOK.priv && \
		cp $WORKDIR/config/mok/MOK.der $WORKDIR/mnt/usr/local/mok/MOK.der && \
		cp $WORKDIR/config/mok/MOK.pem $WORKDIR/mnt/usr/local/mok/MOK.pem && \
		cp $WORKDIR/config/username $WORKDIR/mnt/usr/local/username &&
		cp "$0" $WORKDIR/mnt/usr/local/bin/zfsbootmenu-installer
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to copy into new distro >&2
			exit $EXIT_CODE
		fi
		# Add hostname to hosts.
		printf '127.0.0.1 ' >> $WORKDIR/mnt/etc/hosts
		cat $WORKDIR/config/hostname >> $WORKDIR/mnt/etc/hosts
		echo >> $WORKDIR/mnt/etc/hosts
		# Make sure all the permissions are aight
		chmod 644 $WORKDIR/mnt/etc/hostid $WORKDIR/mnt/etc/hostname $WORKDIR/mnt/etc/hosts \
			$WORKDIR/mnt/usr/local/mok/MOK.der $WORKDIR/mnt/usr/local/mok/MOK.pem \
			$WORKDIR/mnt/usr/local/username && \
		chmod 000 $WORKDIR/mnt/etc/zfs/zroot.key && \
		chmod 600 $WORKDIR/mnt/usr/local/mok/MOK.priv && \
		chmod 755 $WORKDIR/mnt/usr/local/bin/zfsbootmenu-installer
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to chmod files in new distro >&2
			exit $EXIT_CODE
		fi
		exit 0
		;;

	# Mount the special devices into new distro.
	mount-magic-to-new-distro)
		mount -t proc proc $WORKDIR/mnt/proc && \
		mount -t sysfs sys $WORKDIR/mnt/sys && \
		mount -B /dev $WORKDIR/mnt/dev && \
		mount -t devpts pts $WORKDIR/mnt/dev/pts
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to mount magic devices in new distro >&2
			exit $EXIT_CODE
		fi
		exit 0
		;;

	# Install the given DISTRO into a new
	# $TANK_NAME/ROOT/$DISTRO dataset,
	# taking files from $WORKDIR/config
	# This does not clean up the workdir,
	# and does not unmount the dataset
	# or change its mountpoint.
	install-distro-core)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if "$0" distro check "$DISTRO"; then :; else
			echo "$0": Unknown DISTRO: $DISTRO >&2
			exit 1
		fi
		"$0" check-distro-not-installed "$DISTRO" || exit 1
		echo "---- zfsbootmenu-installer: Install '$DISTRO'."
		echo "---- zfsbootmenu-installer: Initial install."
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		zfs create -o mountpoint=$WORKDIR/mnt -o canmount=noauto \
			$TANK_NAME/ROOT/"$DISTRO" && \
		zfs mount $TANK_NAME/ROOT/"$DISTRO" && \
		"$0" distro install-outside "$DISTRO" $WORKDIR/mnt
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Initial installation failed. >&2
			exit $EXIT_CODE
		fi
		"$0" copy-config-to-new-distro || exit 1
		"$0" mount-magic-to-new-distro || exit 1
		echo "---- zfsbootmenu-installer: Chroot install."
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer \
				distro install-chroot "$DISTRO"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Chroot installation failed. >&2
			exit $EXIT_CODE
		fi
		# Do a final signing of any kernels, in case
		# the installation process screwed up the
		# ordering.
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer sign-all-kernels
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Final kernel signing failed. >&2
			exit $EXIT_CODE
		fi
		# Disable log compression: ZFS already
		# compresses them.
		echo "---- zfsbootmenu-installer: Disable log compression if possible (best effort)"
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer typical-no-compress-logs || exit 1

		exit 0
		;;

	# Wrapper function for install-distro-core.
	# Cleans up the work directory if there is
	# a failure and destroys the created dataset.
	install-distro)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if "$0" distro check "$DISTRO"; then :; else
			echo "$0": Unknown DISTRO: $DISTRO >&2
			exit 1
		fi
		"$0" check-distro-not-installed "$DISTRO" || exit 1
		if test '!' -d $WORKDIR/config; then
			echo "$0": requires $WORKDIR/config >&2
			exit 1
		fi
		"$0" install-distro-core "$DISTRO" "$TANK_NAME"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			# Clean up.
			echo "$0": Install "$DISTRO" failed, destroying. >&2
			umount -qnR $WORKDIR/mnt
			if zfs list $TANK_NAME/ROOT/"$DISTRO" > /dev/null 2>&1; then
				zfs destroy -R $TANK_NAME/ROOT/"$DISTRO" > /dev/null 2>&1
			fi
			exit $EXIT_CODE
		fi
		umount -qnR $WORKDIR/mnt
		zfs set mountpoint=/ $TANK_NAME/ROOT/"$DISTRO"
		zfs set org.zfsbootmenu:active=on $TANK_NAME/ROOT/"$DISTRO"
		sync
		echo "---- zfsbootmenu-installer: Enabled '$DISTRO' Boot Environment."
		exit 0
		;;

        ################################################# install Boot Environment

	clean-up-work)
		umount -qnR $WORKDIR/mnt > /dev/null 2>&1
		rm -rf $WORKDIR > /dev/null 2>&1
		exit 0
		;;

	sign-all-kernels)
		"$0" ensure sbsign || exit 1
		"$0" ensure sbverify || exit 1
		cd /boot
		for KERNEL in vmlinuz* vmlinux* linux* linuz* kernel*;
		do
			# POSIX specifies that globs that
			# match nothing will be passed
			# through.
			# If the file doesn't exist, it is
			# a glob that didn't match and we
			# should skip it.
			if test '!' -e "$KERNEL"; then
				# skip
				:
			# skip symbolic links
			elif test -L "$KERNEL"; then
				:
			# skip already-signed
			elif sbverify --cert /usr/local/mok/MOK.pem "$KERNEL" > /dev/null 2>&1; then
				:
			else
				echo "---- zfsbootmenu-installer: Sign /boot/$KERNEL"
				if sbsign --key /usr/local/mok/MOK.priv --cert /usr/local/mok/MOK.pem "$KERNEL" --output "$KERNEL";
				then
					:
				else
					echo "$0": Failed to sign /boot/$KERNEL >&2
					exit 1
				fi
			fi
		done
		exit 0
		;;

	select-vdev)
		printf 'single\nmirror\nraidz1\nraidz2\nraidz3\n' | fzf --layout=reverse-list --no-sort --no-input --border --border-label='Select ZFS Pool Type' --preview="$0"' preview-vdev {}'
		exit 0
		;;

	preview-vdev)
		case $2 in
			single)
				cat <<DESC
Create a pool with just one disk.
You can expand this later to 'mirror' with 'zpool attach'.
DESC
				;;

			mirror)
				cat <<DESC
Create a pool with 2 or 3 disks which can tolerate the
loss of all but one disk, i.e. RAID1.
You can expand this later with more mirrored disks with
'zpool attach', or expand to a RAID10 by adding another
mirror with 'zpool add ${TANK_NAME} mirror'.
DESC
				;;

			raidz1)
				cat <<DESC
Create a pool with 3 or more disks, which can tolerate
the loss of up to one disk, i.e. RAID5.
DESC
				;;

			raidz2)
				cat <<DESC
Create a pool with 4 or more disks, which can tolerate
the loss of up to two disks, i.e. RAID6.
DESC
				;;

			raidz3)
				cat <<DESC
Create a pool with 5 or more disks, which can tolerate
the loss of up to three disks.
DESC
				;;

			*)
				echo "$0": Unknown vdev type: $2 >&2
				exit 1
				;;

		esac
		exit 0
		;;

	select-disks)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires REASON DANGER arguments >&2
			exit 1
		fi
		REASON="$2"
		DANGER="$3"
		"$0" lsdisk |  fzf --layout=reverse-list --no-input --border --multi --border-label='Select disks '"$REASON" --preview="$0"' preview-disk {} '"$DANGER"
		exit 0
		;;

	lsdisk)
		"$0" ensure lsblk > /dev/null 2>&1
		lsblk -e 7 -o PATH,TYPE -nPd | grep '"disk"$'  | sed -e 's/^PATH="//' -e 's/".*$//'
		exit 0
		;;

	describe-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure lsblk > /dev/null 2>&1
		echo 'Disk: ' $DISK
		printf 'Model: '; lsblk -nd -o MODEL $DISK
		printf 'Serial: '; lsblk -nd -o SERIAL $DISK
		printf 'Size: '; lsblk -nd -o SIZE $DISK
		printf 'Connection: '; lsblk -nd -o TRAN $DISK
		exit 0
		;;

	preview-disk)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires DISK DANGER arguments >&2
			exit 1
		fi
		DISK="$2"
		DANGER="$3"
		"$0" describe-disk "$DISK"
		cat <<HELP

Press [tab] to select/deselect, [enter] to finish selection
Press [esc] twice to abort
HELP
		if test X"$DANGER" '=' Xyes; then
			cat <<DANGER

SELECTED DISKS WILL BE FORMATTED AND LOSE ALL THEIR DATA.
DANGER
		fi
		exit 0
		;;

	# Check if the given vdev option in $2 has
	# the correct number of disks in $3... onwards
	# Exit code 0 if OK, non-zero otherwise.
	check-vdev-num-disks)
		VDEV=$2
		shift
		shift
		case $VDEV in
			single)
				if test $# -eq 1; then
					:
				else
					echo "$0": "'"single"'" pool requires exactly one disk >&2
					exit 1
				fi
				;;

			mirror)
				if test $# -eq 2 || test $# -eq 3; then
					:
				else
					echo "$0": "'"mirror"'" pool requires two or three disks >&2
					exit 1
				fi
				;;

			raidz1)
				if test $# -ge 3; then
					:
				else
					echo "$0": "'"raidz1"'" pool requires at least three disks >&2
					exit 1
				fi
				;;

			raidz2)
				if test $# -ge 4; then
					:
				else
					echo "$0": "'"raidz2"'" pool requires at least four disks >&2
					exit 1
				fi
				;;

			raidz3)
				if test $# -ge 5; then
					:
				else
					echo "$0": "'"raidz3"'" pool requires at least five disks >&2
					exit 1
				fi
				;;

			*)
				echo "$0": Unrecognized vdev type: $VDEV >&2
				exit 1
				;;
		esac
		exit 0
		;;

	# Ask user to select a vdev pool option,
	# and disks to put in it.
	select-vdev-disks)
		VDEV=`"$0" select-vdev`
		# Did user cancel?
		if "$0" preview-vdev "$VDEV" > /dev/null 2>&1; then
			:
		else
			exit 1
		fi
		# Assumes device paths don't have spaces T.T
		DISKS="`"$0" select-disks "to install in '$VDEV'" yes`"
		if "$0" check-vdev-num-disks $VDEV $DISKS; then
			:
		else
			exit 1
		fi
		echo $VDEV $DISKS
		exit 0
		;;

	################################################# Initialize Interview

	# The part of Initialize where it
	# asks what the user wants.
	initialize-interview)
		"$0" mkdir-p $WORKDIR/config || exit 1
		"$0" ensure cracklib-check || exit 1
		"$0" ensure grep || exit 1
		"$0" ensure whiptail || exit 1

		"$0" initialize-interview-hostname && \
		"$0" initialize-interview-username && \
		"$0" initialize-interview-password
		if test $? '!=' 0; then
			exit 1
		fi

		"$0" select-vdev-disks > $WORKDIR/config/vdev_disks
		if test $? '!=' 0; then
			exit 1
		fi
		"$0" select-distro > $WORKDIR/config/distro
		if "$0" distro check "`cat $WORKDIR/config/distro`"; then :; else
			exit 1
		fi

		"$0" initialize-prepare-vdev-disks
		"$0" initialize-interview-to-confirm

		exit 0
		;;

	initialize-interview-hostname)
		whiptail --inputbox 'Enter machine name (hostname)' 0 0 2> $WORKDIR/config/hostname
		if test $? '!=' 0; then
			exit 1
		fi
		if grep '^[A-Za-z0-9][-A-Za-z0-9_.]*$' $WORKDIR/config/hostname > /dev/null 2>&1; then :; else
			whiptail --msgbox 'Machine name must start with basic Latin letter or digit, and cannot be empty.

Beyond the first character, you can also use . - _
Spaces are not allowed.' 0 0
			exec "$0" initialize-interview-hostname
		fi
		exit 0
		;;

	initialize-interview-username)
		whiptail --inputbox 'Enter user name' 0 0 2> $WORKDIR/config/username
		if test $? '!=' 0; then
			exit 1
		fi
		if grep '^[A-Za-z0-9][-A-Za-z0-9_.]*$' $WORKDIR/config/username > /dev/null 2>&1; then :; else
			whiptail --msgbox 'User name must start with basic Latin letter or digit, and cannot be empty.
It is not your real name.

Beyond the first character, you can also use . - _
Spaces are not allowed.' 0 0
			exec "$0" initialize-interview-username
		fi
		exit 0
		;;

	initialize-interview-password)
		whiptail --title 'Create your password' --passwordbox 'XXXXXXXXXXXXXXXXXXX' 0 0 '' 2> $WORKDIR/config/zroot.key
		if test $? '!=' 0; then
			exit 1
		fi

		# ZFS requires at least 8 bytes
		LEN=`cat $WORKDIR/config/zroot.key | wc --bytes`
		if test $LEN -lt 8; then
			whiptail --msgbox 'Password must be at least 8 characters!' 0 0
			exec "$0" initialize-interview-password
		fi

		# Check against cracklib, otherwise PAM pam_unix will
		# complain later in the actual installation.
		cat $WORKDIR/config/zroot.key | cracklib-check > $WORKDIR/config/cracklib-whine
		if grep ': OK$' $WORKDIR/config/cracklib-whine > /dev/null 2>&1; then :; else
			# Not OK.
			COMPLAINT="`cat $WORKDIR/config/cracklib-whine | grep -o ':[^:]*$'`"
			rm -rf $WORKDIR/config/cracklib-whine > /dev/null 2>&1
			whiptail --msgbox 'Password insecure'"$COMPLAINT" 0 0
			exec "$0" initialize-interview-password
		fi
		rm -rf $WORKDIR/config/cracklib-whine > /dev/null 2>&1

		whiptail --title 'Re-enter same password' --passwordbox "XXXXXXXXXXXXXXXXXXX" 0 0 '' 2> $WORKDIR/config/zroot2.key
		if test $? '!=' 0; then
			exit 1
		fi
		if cmp -s $WORKDIR/config/zroot.key $WORKDIR/config/zroot2.key; then :; else
			whiptail --msgbox 'Passwords do not match!
Please try again.' 0 0
			exec "$0" initialize-interview-password
		fi
		rm $WORKDIR/config/zroot2.key
		# whiptail on my system doesn't add a newline.
		echo >> $WORKDIR/config/zroot.key
		exit 0
		;;

	# Create a to-confirm file from the
	# data we gathered in `initialize-interview`
	initialize-interview-to-confirm)
		rm -rf $WORKDIR/to-confirm > /dev/null 2>&1
		echo hostname:  "`cat $WORKDIR/config/hostname`" >> $WORKDIR/to-confirm
		echo username:  "`cat $WORKDIR/config/username`" >> $WORKDIR/to-confirm
		echo distro: "`cat $WORKDIR/config/distro`" >> $WORKDIR/to-confirm

		IS_VDEV_FLAG=yes
		for WORD in `cat $WORKDIR/config/vdev_disks`; do
			if test $IS_VDEV_FLAG '=' yes; then
				echo 'zpool:' "$WORD" >> $WORKDIR/to-confirm
				echo >> $WORKDIR/to-confirm
				echo ANY DATA ON THESE DISKS WILL BE DESTROYED. >> $WORKDIR/to-confirm

				IS_VDEV_FLAG=no
			else
				echo >> $WORKDIR/to-confirm
				"$0" describe-disk "$WORD" >> $WORKDIR/to-confirm
			fi
		done
		exit 0
		;;

	# Split the vdev_disks file into
	# vdev and disks, and convert every
	# disk into by-id
	initialize-prepare-vdev-disks)
		rm -rf $WORKDIR/config/vdev $WORKDIR/config/disks > /dev/null 2>&1
		IS_VDEV_FLAG=yes
		for WORD in `cat $WORKDIR/config/vdev_disks`; do
			if test $IS_VDEV_FLAG '=' yes; then
				echo $WORD > $WORKDIR/config/vdev
				IS_VDEV_FLAG=no
			else
				"$0" get-disk-id "$WORD" >> $WORKDIR/config/disks
			fi
		done
		exit 0
		;;

	################################################# Initialize Interview

	################################################# Initialize Processing

	initialize-processing)
		echo "---- zfsbootmenu-installer: Initialize: Begin."
		if test '!' -f /etc/hostid; then
			# See: https://github.com/zbm-dev/zfsbootmenu/discussions/465
			zgenhostid 0x00bab10c
		fi
		cp /etc/hostid $WORKDIR/config/hostid
		"$0" create-mok-inner "`cat $WORKDIR/config/hostname`" $WORKDIR/config/mok && \
		"$0" initialize-submit-mok && \
		"$0" prepare-esp-in-work && \
		"$0" initialize-format-disks && \
		"$0" initialize-find-parts
		if test $? '!=' 0; then
			exit 1
		fi
		DISTRO="`cat $WORKDIR/config/distro`"
		"$0" initialize-zpool-create && \
		"$0" install-distro-core "$DISTRO"
		if test $? '!=' 0; then
			exit 1
		fi
		umount -qnR $WORKDIR/mnt
		zfs set mountpoint=/ $TANK_NAME/ROOT/"$DISTRO"
		zfs set org.zfsbootmenu:active=on $TANK_NAME/ROOT/"$DISTRO"
		zpool set bootfs=$TANK_NAME/ROOT/"$DISTRO" $TANK_NAME
		sync
		zpool export $TANK_NAME
		sync
		sleep 1
		udevadm trigger
		echo "---- zfsbootmenu-installer: Installed '$DISTRO' into $TANK_NAME"
		cat <<MSG

Congratulations, installation has completed!

NOTE!

When you next restart your new system, the
"MOK Management" interface will appear.

You can then "Enrol MOK" there.
Select that, then "Continue" and enter your password.

This registers your Machine Operator Key (MOK) so
you can run bootloaders, kernels, and kernel modules
that you install, while the machine has Secure Boot
enabled.

You can also "Enroll key from disk" and search for
"MOK.cer", which is a certificate of your Machine
Operator Key.

When booting, you will be asked to
"Enter passphrase for 'zroot'".
This is where you enter your password.
The password will not be displayed, not even as
asterisks, but it will be checked, just type it in
and trust it.
MSG
		exit 0
		;;

	initialize-submit-mok)
		"$0" ensure mokutil || exit 1
		# pipe the password in.
		cat $WORKDIR/config/zroot.key $WORKDIR/config/zroot.key | \
		mokutil --import $WORKDIR/config/mok/MOK.der > /dev/null
		exit $?
		;;

	initialize-format-disks)
		exec "$0" format-disks `cat $WORKDIR/config/disks`
		;;

	# Find the partition names that we will put
	# into the pool, and load $WORKDIR/config/parts
	# We always set the ZFS pool member as the
	# second partition of the disk.
	initialize-find-parts)
		echo "---- zfsbootmenu-installer: Initialize: Preparing parts file."
		"$0" ensure lsblk || exit 1
		rm -rf $WORKDIR/config/parts > /dev/null 2>&1
		for DISK in `cat $WORKDIR/config/disks`; do
			"$0" initialize-find-part-try \
				"$DISK"-part2 \
				"$DISK"p2 \
				"$DISK"2 >> $WORKDIR/config/parts
			if test $? '!=' 0; then
				echo "$0": Unable to find parttion 2 of $DISK >&2
				exit 1
			fi
		done
		exit 0
		;;

	# This iterates over each of its arguments,
	# printing the first argument it finds that
	# is a block device that is a partition.
	initialize-find-part-try)
		if test X${2+set} '!=' Xset; then
			# out of arguments.
			exit 1
		fi
		shift
		TRY_PART="$1"
		lsblk -o TYPE -nd "$TRY_PART" > $WORKDIR/thing-type
		if test $? '=' 0; then
			# is some kind of block device,
			# but is it a 'part'?
			if test "`cat $WORKDIR/thing-type`" '=' "part"; then
				rm -rf $WORKDIR/thing-type > /dev/null 2>&1
				echo "$TRY_PART"
				# found it, stop processing.
				exit 0
			fi
		fi
		rm -rf $WORKDIR/thing-type > /dev/null 2&1

		# Above check failed, move to next.
		shift
		# Some shells might make "$@" into
		# "" if there are no more arguments.
		if X${1+set} '!=' Xset; then
			# out of arguments.
			exit 1
		fi
		# tail call optimization considered awesome
		exec "$0" initialize-find-part-try "$@"
		;;

	initialize-zpool-create)
		"$0" ensure whiptail || exit 1
		whiptail --msgbox 'About to create ZFS Pool.

On some Live CD environments, a pop-up may appear,
telling you that something went wrong with the system.

It is benign and you can ignore it.
Installation will continue successfully regardless.
' 0 0
		# Put the zroot.key in the expected place.
		"$0" mkdir-p /etc/zfs || exit 1
		cp $WORKDIR/config/zroot.key /etc/zfs/zroot.key
		chmod 000 /etc/zfs/zroot.key
		if test "`cat $WORKDIR/config/vdev`" '=' single; then
			zpool create -f \
				-o ashift=12 \
				-O compression=lz4 \
				-O acltype=posixacl \
				-O xattr=sa \
				-O relatime=on \
				-O encryption=aes-256-gcm \
				-O keylocation=file:///etc/zfs/zroot.key \
				-O keyformat=passphrase \
				-O org.zfsbootmenu:commandline='quiet splash' \
				-o autotrim=on \
				-o compatibility=openzfs-2.2 \
				-m none $TANK_NAME \
				`cat $WORKDIR/config/parts`
			EXIT_CODE=$?
		else
			zpool create -f \
				-o ashift=12 \
				-O compression=lz4 \
				-O acltype=posixacl \
				-O xattr=sa \
				-O relatime=on \
				-O encryption=aes-256-gcm \
				-O keylocation=file:///etc/zfs/zroot.key \
				-O keyformat=passphrase \
				-O org.zfsbootmenu:commandline='quiet splash' \
				-o autotrim=on \
				-o compatibility=openzfs-2.2 \
				-m none $TANK_NAME \
				`cat $WORKDIR/config/vdev` \
				`cat $WORKDIR/config/parts`
			EXIT_CODE=$?
		fi
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Unable to create ZFS Pool >&2
			exit 1
		fi
		sync
		zfs load-key -L file://$WORKDIR/config/zroot.key "$TANK_NAME" > /dev/null 2>&1
		zfs create -o mountpoint=none "$TANK_NAME"/ROOT
		# Create the home directory with canmount=noauto
		# at first.
		# If we create it canmount=on here (the default)
		# the dataset will be mounted now, but this is
		# executing within the Live environment and
		# replace the /home of the Live environment.
		# If the user downloaded zfsbootmenu-installer
		# to /home, it would get lost.
		# Instead, we keep `canmount=noauto` to prevent
		# it from being mounted NOW.
		# We instead do the `canmount=on` setting inside
		# the `chroot` jail, where the `/home` would be
		# truly empty.
		zfs create -o mountpoint=/home -o canmount=noauto "$TANK_NAME"/home
		echo "---- zfsbootmenu-installer: Created ZFS Pool."
		udevadm trigger
		sync
		exit 0
		;;

	################################################# Initialize Processing

	################################################# Confirmation

	confirm)
		if test '!' -f $WORKDIR/to-confirm; then
			echo "$0": need to-confirm file in wokrdir >&2
			exit 1
		fi
		SEL=`printf 'No\nYes\n' | fzf --layout=reverse-list --no-sort --no-input --border --border-label='ARE YOU SURE?' --preview="$0"' preview-confirm'`
		rm $WORKDIR/to-confirm > /dev/null 2>&1
		if test X"$SEL" '=' XYes; then
			exit 0
		else
			exit 1
		fi
		;;

	preview-confirm)
		cat $WORKDIR/to-confirm
		;;

	################################################# Confirmation

        ################################################# ESP search

	lsdisk-with-esp)
		for DISK in `"$0" lsdisk`; do
			if "$0" disk-has-esp $DISK; then
				echo $DISK
			fi
		done
		exit 0
		;;

	disk-has-esp)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK=$2
		"$0" ensure lsblk
		if lsblk -o NAME "$DISK" > /dev/null 2>&1; then :; else
			# not a disk
			exit 1
		fi
		if test X"`lsblk -e 7 -o PARTTYPENAME $DISK -n | grep 'EFI System'`" '=' X; then
			exit 1
		else
			exit 0
		fi
		;;

	get-disk-esp)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK=$2
		lsblk -e 7 -o PATH,PARTTYPENAME -nP "$DISK" | grep '"EFI System"$' | sed -e 's/^PATH="//' -e 's/".*$//'
		exit 0
		;;

	select-disk-reflash-esp)
		"$0" lsdisk-with-esp | fzf --layout=reverse-list --no-input --border --border-label='Select disk to Reflash ESP' --preview="$0"' preview-disk {} no'
		exit 0
		;;

        ################################################# ESP search

        ################################################# ESP flashing

	# Needs $WORKDIR/esp
	flash-esp-from-work)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		if test '!' -d $WORKDIR/esp; then
			echo "$0": no prepared ESP in workdir >&2
			exit 1
		fi
		DISK=$2
		ESP=`"$0" get-disk-esp "$DISK"`
		echo "---- zfsbootmenu-installer: Flashing ESP: $DISK"
		"$0" ensure rsync || exit 1
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		mount -t vfat "$ESP" $WORKDIR/mnt || exit 1
		# The `/` after `/esp` is significant!
		rsync -r $WORKDIR/esp/ $WORKDIR/mnt

		sync
		sleep 1
		umount -qnR $WORKDIR/mnt

		echo "---- zfsbootmenu-installer: ESP flashed: $DISK"
		exit 0
		;;

        ################################################# ESP flashing

        ################################################# Disk ID

	# Given a /dev/sdfoo or /dev/hdfoo or /dev/nvmefoo,
	# get the path from /dev/disk/by-id/foo
	get-disk-id)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure readlink || exit 1
		:
		NAME=`echo "$DISK" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
		for ID in /dev/disk/by-id/*; do
			if test -L "$ID"; then
				DEST=`readlink -e "$ID" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
				if test X"$DEST" '=' X"$NAME"; then
					echo "$ID"
					exit 0
				fi
			fi
		done
		echo "$DISK"
		exit 1
		;;

        ################################################# Disk ID

        ################################################# Disk formatting

	erase-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure blkdiscard
		"$0" ensure sgdisk
		"$0" ensure wipefs
		"$0" ensure udevadm

		wipefs -a "$DISK" || exit $?

		blkdiscard -f "$DISK"
		EXIT_CODE=$?
		# 0 = okay, 2 = device doesn't support TRIM
		# everything else, we treat as error.
		if test $EXIT_CODE '=' 0 -o $EXIT_CODE '=' 2; then :; else
			exit $EXIT_CODE
		fi

		sgdisk ---zap-all "$DISK" || exit $?
		sync
		sleep 1
		udevadm trigger

		exit 0
		;;

	partition-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure mkfs.vfat
		"$0" ensure sgdisk
		"$0" ensure udevadm

		# 1:1m:+512m - Create Partition 1 starting at
		# absolute offset 1Mbyte, and end it +512Mbytes
		# later.
		# 2:0:0 - Create Partition 2 starting at
		# the remaining space (the first "0") and go
		# all the way until you reach the end (the
		# second "0").
		# EFI System Partition: ef00
		# Solaris Root: bf00
		sgdisk -n "1:1m:+512m" -t "1:ef00" \
			-n "2:0:0" -t "2:bf00" "$DISK"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		sync
		sleep 1
		udevadm trigger

		DISK_BY_ID="`"$0" get-disk-id "$DISK"`"
		BOOT_PART="$DISK_BY_ID"-part1
		if test '!' -e "$BOOT_PART"; then
			echo "$0": Could not find partition 1 of $DISK: $BOOT_PART >&2
			exit 1
		fi
		mkfs.vfat -v -F32 "$BOOT_PART"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		sync
		sleep 1

		exit 0
		;;

	format-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		if test '!' -d $WORKDIR/esp; then
			echo "$0": no prepared ESP in workdir >&2
			exit 1
		fi
		DISK="$2"
		echo "---- zfsbootmenu-installer: Formatting: $DISK"
		"$0" erase-disk "$DISK" && \
		"$0" partition-disk "$DISK" && \
		"$0" flash-esp-from-work "$DISK"
		exit $?
		;;

	format-disks)
		shift
		for DISK in "$@"; do
			if "$0" format-disk "$DISK"; then :; else
				exit 1
			fi
		done
		echo "---- zfsbootmenu-installer: Formatting completed."
		exit 0
		;;

        ################################################# Disk formatting

	################################################# Boot Environment

	list-boot-environments)
		# List the bootfs first if it is a valid
		# dataset.
		BOOTFS="`zpool get bootfs -o value -H $TANK_NAME`"
		if zfs list "$BOOTFS" > /dev/null 2>&1; then
			echo "$BOOTFS"
		fi
		BOOTFS_NAME=`echo "$BOOTFS" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
		# Otherwise sort alphabetically and filter
		# out the base $TANK_NAME/ROOT dataset.
		zfs list -s name -t filesystem -H -d 1 -o name $TANK_NAME/ROOT | \
			sed -e '/^'"$TANK_NAME"'\/ROOT\/'"$BOOTFS_NAME"'$/ d' | \
			sed -e '/^'"$TANK_NAME"'\/ROOT$/ d'
		exit 0
		;;

	preview-boot-environment)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires BE argument >&2
			exit 1
		fi
		BE="$2"
		echo $BE; echo
		printf 'Created: '; zfs get -H -o value creation "$BE"
		printf 'Used: '; zfs get -H -o value used "$BE"
		if test X"`zpool get -H -o value bootfs $TANK_NAME`" '=' X"$BE"; then
			echo
			echo This is the current default Boot Environment.
		fi
		if test X"`zfs get -H -o value mounted "$BE"`" '=' Xyes; then
			echo
			echo You are running in this Boot Environment.
		fi
		exit 0
		;;

	select-boot-environment)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires REASON argument >&2
			exit 1
		fi
		REASON=$2
		"$0" list-boot-environments | fzf --layout=reverse-list --no-sort --no-input --border --border-label='Select Boot Environment '"$REASON" --preview="$0"' preview-boot-environment {}'
		exit 0
		;;

	# Determine which boot environment is the
	# currently booted one.
	find-current-boot-environment)
		"$0" ensure df
		"$0" ensure tail
		# The nice thing about using
		# df here is that it works even
		# in a chroot jail.
		df --output=source / | tail -n 1
		exit $?
		;;

	################################################# Boot Environment

        ################################################# Main Menu

	Initialize)
		"$0" initialize-interview &&
		"$0" confirm
		if test $? '!=' 0; then
			echo "---- zfsbootmenu-installer: Initialize: cancelled"
			exit 0
		fi

		"$0" initialize-processing $TANK_NAME
		EXIT_CODE=$?
		$0 clean-up-work
		exit $EXIT_CODE
		;;

	AddBootEnvironment)
		DISTRO=`"$0" select-distro "Add Boot Environment"`
		if "$0" distro check "$DISTRO"; then :; else
			echo "---- zfsbootmenu-installer: AddBootEnvironment: cancelled"
			exit 0
		fi
		"$0" check-distro-not-installed "$DISTRO" || exit 1
		echo "---- zfsbootmenu-installer: AddBootEnvironment: $DISTRO"
		"$0" prepare-work-from-existing
		if test $? '!=' 0; then
			"$0" clean-up-work
			exit 1
		fi
		"$0" install-distro $DISTRO
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

	ChangeDefaultBoot)
		NEWBOOTFS=`"$0" select-boot-environment 'to set as default'`
		if zfs list "$NEWBOOTFS" > /dev/null 2>&1; then :; else
			echo "---- zfsbootmenu-installer: ChangeDefaultBoot: cancelled"
			exit 0
		fi
		zpool set bootfs="$NEWBOOTFS" $TANK_NAME
		echo "---- zfsbootmenu-installer: ChangeDefaultBoot: Default set to $NEWBOOTFS"
		exit 0
		;;

	ReflashESP)
		DISK=`"$0" select-disk-reflash-esp`
		if "$0" disk-has-esp "$DISK"; then :; else
			echo "---- zfsbootmenu-installer: ReflashESP: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: ReflashESP: $DISK"
		"$0" prepare-esp-in-work && \
		"$0" flash-esp-from-work $DISK
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

	PrepareNewDisk)
		DISKS="`"$0" select-disks 'to format for array (Prepare New Disk)' yes`"
		OK=no
		# Assumes paths don't have spaces T.T
		for DISK in $DISKS; do
			OK=yes
			# assumes break doesn't exist yet
		done
		if test "$OK" '=' 'no'; then
			echo "---- zfsbootmenu-installer: PrepareNewDisk: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: PrepareNewDisk: $DISKS"

		"$0" mkdir-p $WORKDIR
		rm -rf $WORKDIR/to-confirm > /dev/null 2>&1
		echo ANY DATA ON THESE DISKS WILL BE DESTROYED.  > $WORKDIR/to-confirm
		for DISK in $DISKS; do
			echo >> $WORKDIR/to-confirm
			"$0" describe-disk "$DISK" >> $WORKDIR/to-confirm
		done
		if "$0" confirm; then :; else
			"$0" clean-up-work
			echo "---- zfsbootmenu-installer: PrepareNewDisk: cancelled"
			exit 0
		fi

		"$0" prepare-esp-in-work && \
		"$0" format-disks $DISKS
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

        ################################################# Main Menu

	*)
		echo "$0": Unknown sub-command: "$1" >&2
		exit 1
		;;


	esac

	exit 0
fi

if test X${EUID:-$(id -u)} '!=' X0; then
	echo "$0": not running as superuser, aborting >&2
	exit 1
fi
if test '!' -x "$0"; then
	chmod a+x "$0"
fi
if test -e $WORKDIR; then
	cat >&2 <<ERR
$0: $WORKDIR present, aborting
$0: If you are sure no other instance is running, do as superuser:
$0:     umount -qnR $WORKDIR/mnt
$0:     rm -rf $WORKDIR
ERR
	exit 1
fi

if "$0" detect-installed; then
	MAINMENU='Exit\nAbout\nAddBootEnvironment\nChangeDefaultBoot\nReflashESP\nPrepareNewDisk\n'
else
	MAINMENU='Exit\nAbout\nInitialize\n'
fi

if which fzf > /dev/null 2>&1; then :; else
	echo "---- zfsbootmenu-installer: Installing needed tools"
	if "$0" ensure fzf && "$0" ensure whiptail && "$0" ensure wget && "$0" ensure cracklib-check; then :; else
		echo "$0": Unable to ensure needed tools >&2
		exit 1
	fi
fi
FZF_DEFAULT_COMMAND=
FZF_DEFAULT_OPTS=
FZF_DEFAULT_OPTS_FILE=
FZF_API_KEY=
export FZF_DEFAULT_COMMAND
export FZF_DEFAULT_OPTS
export FZF_DEFAULT_OPTS_FILE
export FZF_API_KEY

SEL=`printf "$MAINMENU" | fzf --layout=reverse-list --no-sort --no-input --border --border-label='zfsbootmenu-installer '"$VERSION"' Main Menu'  --preview="$0"' preview-mainmenu {}'`

case $SEL in
	Initialize|AddBootEnvironment|ChangeDefaultBoot|ReflashESP|PrepareNewDisk)
		;;

	*)
		exit 0
