VERSION=1.0.0

# Convenient names.
# These are NOT intended to be modifiable.

WORKDIR="/zfsbootmenu-installer-work"
TANK_NAME=zroot

# For best portability, we assume shell functions are not supported.
# For code organization purposes, the case $1 below is effectively
# our "shell functions", and has the advantage that we can easily
# invoke them from the command line for development testing.

if test X${1+set} '=' Xset; then
	case $1 in
	--help|-h)
		cat <<HELP
[sudo] zfsbootmenu-installer

   Launches an interactive wizard for ZFSBootMenu
   installation and creation of a ZFS pool, and
   installs a supported distro as the first Boot
   Environment.

   If you are already in a ZFSBootMenu setup with a
   ZFS pool, you can add a new Boot Environment with
   an install of a supported distro, or prepare new
   disks to add or replace into your array.

   This command must be run as root.
   When initially installing, you should use an Ubuntu
   Live CD or rescue disk, or a similar Debian
   derivative with a ZFS kernel.
   Boot Environments installed by this tool will also
   have this tool (and its dependencies) installed so
   that you can add alternate Boot Environments,
   regardless of the distro in that Boot Environment.

zfsbootmenu-installer --help

   Display this help

zfsbootmenu-installer --version

   Display the version

zfsbootmenu-installer <command> <args>....

   Run an internal part of this tool; this is not
   intended for end-users.

Send bug reports to raid5atemyhomework@protonmail.com
This tool is released under an MIT license.
HELP
		exit 0
		;;
	--version|-v)
		cat <<VERSION
zfsbootmenu-installer ${VERSION}
Copyright 2026 raid5atemyhomework
This tool is released under an MIT license.
VERSION
		exit 0
		;;

	preview-mainmenu)
		case $2 in
			Initialize)
				cat <<DESC
Format one or more block devices, install ZFSBootMenu
bootloader on all of them with Secure Boot support, and
create a ZFS Pool '${TANK_NAME}' from them, then install
one supported distro:

DESC
				"$0" distro list
				;;

			AddBootEnvironment)
				cat <<DESC
Add a Boot Environment to an existing ZFS Pool named
'${TANK_NAME}' with a '${TANK_NAME}/ROOT' dataset, installing
one supported distro:

DESC
				"$0" distro list
				;;

			ChangeDefaultBoot)
				cat <<DESC
Change the Boot Environment that ZFSBootMenu will default
to booting the machine into.
DESC
				;;

			ReflashESP)
				cat <<DESC
Re-download ZFSBootMenu and install it into the EFI
System Partition of a block device.
DESC
				;;

			PrepareNewDisk)
				cat <<DESC
Format a block device, creating an EFI System Partition
on it, and re-download and install ZFSBootMenu on it.

Use this to prepare a device before adding it to your
ZFS Pool array to replace a broken device or to
increase the pool's capacity.
DESC
				;;

			Exit)
				cat <<DESC
Exit this tool.
DESC
				;;

			About)
				cat <<DESC
'zfsbootmenu-installer' is a tool to set up a ZFS
array and install a bootable GNU/Linux distro on
it, with the root as a dataset on the ZFS array
and '/home' as a separate ZFS dataset.

ZFSBootMenu is used as the bootloader, and the
installed system can be run with Secure Boot.

After initializing your system with 'Initialize',
'zfsbootmenu-installer' will also install itself
in '/usr/local/bin'.
You can then use it to install additional
GNU/Linux distros on the same ZFS array (sharing
the same '/home', and allowing you to multi-boot
between them), select the default distro to boot,
or prepare new disks to add or replace into your
array.
DESC
				;;

		esac
		exit 0
		;;

	mkdir-p)
		DIRNAME="$2"
		mkdir -p "$DIRNAME" || exit 1
		if test -d "$DIRNAME"; then :; else
			echo "$0": Unable to create "'$DIRNAME'" >&2
			exit 1
		fi
		exit 0
		;;

	################################################# Detect Installation

	detect-installed)
		if test '!' '(' -d /usr/local/mok -a \
				-f /usr/local/mok/MOK.priv -a \
				-f /usr/local/mok/MOK.pem -a \
				-f /usr/local/mok/MOK.der -a \
				-f /usr/local/username -a \
				-f /etc/zfs/zroot.key \
				')'; then
			exit 1
		fi
		if which zpool > /dev/null 2>&1; then :; else
			exit 1
		fi
		if zpool list "$TANK_NAME" > /dev/null 2>&1; then :; else
			exit 1
		fi
		exit 0
		;;

	################################################# Detect Installation

	################################################# MOK creation

	create-mok-inner)
		if test X${3+set} '!=' Xset; then
			echo "$0": Need HOSTNAME DIR arguments >&2
			exit 1
		fi
		HOSTNAME="$2"
		DIR="$3"

		"$0" mkdir-p "$DIR" || exit 1
		rm -rf "$DIR"/* > /dev/null 2>&1

		echo "---- zfsbootmenu-installer: Create Machine Owner Key (MOK)"
		cat > "$DIR"/openssl.cnf <<CFG
HOME = $DIR
RANDFILE = $DIR/.rnd
CFG
		if test '!' -f "$DIR"/openssl.cnf; then
			exit 1
		fi
		# suppress scary-looking error message.
		# Modern OSs should have a good secure CSPRNG
		# already, and also save and load the
		# entropy for that CSPRNG during startup.
		openssl rand -out "$DIR"/.rnd 1024
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi
		# mokutil and kmodsign use DER
		openssl req -config "$DIR"/openssl.cnf \
			-new -x509 -newkey rsa:2048 -nodes -days 36500 \
			-subj "/CN=${HOSTNAME} Machine Owner Key" \
			-keyout "$DIR"/MOK.priv \
			-outform DER -out "$DIR"/MOK.der
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi
		# sbsign uses PEM
		openssl x509 -inform DER -in "$DIR"/MOK.der -outform PEM -out "$DIR"/MOK.pem
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi
		# clean up
		rm -f "$DIR"/openssl.cnf > /dev/null 2>&1
		exit 0
		;;

	create-mok)
		if test -e /usr/local/mok/MOK.priv; then
			echo "$0": MOK /usr/local/mok/MOK.priv already exists. >&2
			exit 1
		fi
		exec "$0" create-mok-inner "`hostname`" /usr/local/mok
		;;

	################################################# MOK creation

	################################################# ZFSBootMenu Download

	# Downloads the latest ZFSBootMenu file and validates it
	# against the hardcoded key.
	download-validate-zbm)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need DIR argument >&2
			exit 1
		fi
		DIR="$2"

		echo "---- zfsbootmenu-installer: Download and validate ZFSBootMenu"

		rm -rf "$DIR"/* > /dev/null 2>&1
		"$0" ensure wget || exit 1
		SIGNIFY=`"$0" detect-signify "$DIR"`
		if test $? '!=' 0; then
			echo "$0": Unable to find signify tool >&2
			exit 1
		fi
		rm -rf "$DIR"/* > /dev/null 2>&1

		cd "$DIR" || exit 1
		# After this point, we cannot invoke other sub-commands
		# of zfsbootmenu-installer

		cat > zfsbootmenu.pub <<PUB
untrusted comment: ZFSBootMenu signing key public key
RWSUawlGznCLF8NxEb1EyrGpP2eIR9l7JIZgLzCdv+64uBDvfXNJm+cF
PUB

		wget --no-verbose --content-disposition https://get.zfsbootmenu.org/efi/recovery || exit 1
		wget --no-verbose --content-disposition https://get.zfsbootmenu.org/sha256.sig || exit 1
		if ${SIGNIFY} -C -p zfsbootmenu.pub -x sha256.sig *.EFI; then
			mv *.EFI zbm-unsigned.efi
		else
			echo "$0": ZFSBootMenu failed validation >&2
			exit 1
		fi
		# Clean up
		rm -f sha256.sig zfsbootmenu.pub > /dev/null 2>&1
		exit 0
		;;

	# ZFSBootMenu devs use signify, but the problem is
	# that on Debian derivatives, the tool used is called
	# `signify-openbsd` and the `signify` package is
	# something completely different.  SIGH.
	# This part detects which one to use, or tries
	# apt install `signify-openbsd` if neither is
	# found.
	detect-signify)
		TMPDIR="$2"
		for SIGNIFY in signify-openbsd signify; do
			if which ${SIGNIFY} > /dev/null 2>&1; then
				# Try creating a dummy keypair
				${SIGNIFY} -G -n -p "$TMPDIR"/zfsbootmenu-installer-dummy.pub -s "$TMPDIR"/zfsbootmenu-installer-dummy.sec > /dev/null 2>&1
				if test $? '=' 0 && test -f "$TMPDIR"/zfsbootmenu-installer-dummy.pub; then
					rm -rf "$TMPDIR"/zfsbootmenu-installer-dummy.pub "$TMPDIR"/zfsbootmenu-installer-dummy.sec > /dev/null 2>&1
					echo ${SIGNIFY}
					exit 0
				fi
				rm -rf "$TMPDIR"/zfsbootmenu-installer-dummy.pub "$TMPDIR"/zfsbootmenu-installer-dummy.sec > /dev/null 2>&1
			fi
		done
		apt install signify-openbsd > /dev/null 2>&1
		if test $? '=' 0; then
			echo signify-openbsd
			exit 0
		fi
		exit 1
		;;

	################################################# ZFSBootMenu Download

	################################################# shim-signed Download

	# Get shim-signed from the Ubuntu package.
	# Why Ubuntu's and not, say, Fedora's or
	# Debian's?
	# Because shim hardcodes some additional keys
	# during build time, and each distro will
	# include their own pubkeys for their own
	# version of shim(-signed).
	# If the distro we are installing is dependent
	# on using DKMS for OpenZFS, then all we need
	# is to configure DKMS to always sign with our
	# MOK (which we do, see dkms-mok-auto-sign),
	# so it doesn't matter whose keys are hardcoded
	# into shim.
	# Even for the distros where we compile OpenZFS,
	# the kernel module is generally set up to
	# compile with DKMS, so we still trigger sign
	# it with our own MOK.
	# However, Ubuntu does not use DKMS for its
	# OpenZFS; instead, it distributes the binary
	# directly, though the binary *is* signed by
	# Canonical.
	# Thus, we want the Canonical pubkeys in the
	# shim we use so that it passes the shim
	# hardcoded pubkey; for non-Ubuntu distros, we
	# will rely on DKMS to sign with our MOK so
	# that it also passes.
	download-validate-shim)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need DIR argument >&2
			exit 1
		fi
		DIR="$2"

		# Hardcoded.
		# As Ubuntu will eventually replace these, we
		# need to update it from:
		# https://archive.ubuntu.com/ubuntu/dists/*/main/binary-amd64/Packages.xz
		# Package: shim-signed
		SHIM_DEB="https://archive.ubuntu.com/ubuntu/pool/main/s/shim-signed/shim-signed_1.59+15.8-0ubuntu2_amd64.deb"
		SHIM_SHA256="f8ed71ce2d91a304b6d5eb84997f846f331b554578bc02dbfe78e13ad8ac81a9"

		echo "---- zfsbootmenu-installer: Download and validate shim-signed"
		rm -rf "$DIR"/* > /dev/null 2>&1
		"$0" ensure wget || exit 1
		"$0" ensure sha256sum || exit 1
		"$0" ensure ar || exit 1
		"$0" ensure xz || exit 1
		"$0" ensure tar || exit 1

		cd "$DIR"

		wget --no-verbose -O shim.deb "$SHIM_DEB" || exit 1
		echo $SHIM_SHA256 shim.deb | sha256sum -c
		if test $? '!=' 0; then
			echo "$0": shim-signed .deb validation failed >&2
			exit 1
		fi
		# Extract from shim-signed
		ar x shim.deb data.tar.xz || exit 1
		xz --decompress data.tar.xz || exit 1
		tar xf data.tar || exit 1
		rm data.tar
		# Move the files.
		mv ./usr/lib/shim/shimx64.efi.signed.latest ./shimx64.efi || exit 1
		mv ./usr/lib/shim/mmx64.efi ./mmx64.efi || exit 1
		mv ./usr/lib/shim/fbx64.efi ./fbx64.efi || exit 1
		# Clean up
		rm -rf usr etc var shim.deb > /dev/null 2>&1
		exit 0
		;;

	################################################# shim-signed Download

	################################################# Prepare a reference ESP

	print-boot-csv)
		"$0" ensure iconv
		iconv -t UCS-2 << BOOTCSV
shimx64.efi,ZFSBootMenu,,This is the boot entry for ZFSBootMenu
BOOTCSV
		;;

	prepare-esp)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need DIR argument >&2
			exit 1
		fi
		DIR="$2"
		# Needs access to MOK privkey, which should
		# be readable only to root.
		if test X${EUID:-$(id -u)} '!=' X0; then
			echo "$0": not running as superuser, aborting >&2
			exit 1
		fi

		# Look for MOK signing key.
		# Prefer the working dir path.
		if test -d ${WORKDIR}/config/mok; then
			KEYDIR=${WORKDIR}/config/mok
		elif test -d /usr/local/mok; then
			KEYDIR=/usr/local/mok
		else
			echo "$0": Cannot find MOK >&2
			exit 1
		fi

		echo "---- zfsbootmenu-installer: Prepare ESP"
		"$0" ensure sbsign
		rm -rf "$DIR"/* > /dev/null 2>&1
		"$0" mkdir-p "$DIR"/BOOT || exit 1
		"$0" mkdir-p "$DIR"/ZFSBootMenu || exit 1
		"$0" mkdir-p "$DIR"/EFI || exit 1
		"$0" download-validate-shim "$DIR"/BOOT || exit 1
		"$0" download-validate-zbm "$DIR"/ZFSBootMenu || exit 1

		echo "---- zfsbootmenu-installer: Sign ZFSBootMenu"
		sbsign --key "$KEYDIR"/MOK.priv --cert "$KEYDIR"/MOK.pem "$DIR"/ZFSBootMenu/zbm-unsigned.efi --output "$DIR"/ZFSBootMenu/grubx64.efi

		cat > "$DIR"/ZFSBootMenu/README.txt <<README
The file named 'grubx64.efi' is ***NOT*** Grub.
It is ZFSBootMenu, signed with the Machine Owner Key.
The filename 'grubx64.efi' is used because the Shim
bootloader hardcodes that filename.
This system does not use Grub and will not work with
Grub configurations and scripts.
README

		# Copy and move files around.
		cp "$KEYDIR"/MOK.der "$DIR"/EFI/MOK.cer
		cp "$DIR"/BOOT/shimx64.efi "$DIR"/ZFSBootMenu/shimx64.efi
		cp "$DIR"/BOOT/mmx64.efi "$DIR"/ZFSBootMenu/mmx64.efi
		mv "$DIR"/BOOT/shimx64.efi "$DIR"/BOOT/BOOTX64.EFI
		"$0" print-boot-csv > "$DIR"/ZFSBootMenu/BOOTX64.CSV
		mv "$DIR"/BOOT "$DIR"/ZFSBootMenu "$DIR"/EFI

		echo "---- zfsbootmenu-installer: ESP prepared"
		exit 0
		;;

	prepare-esp-in-work)
		"$0" mkdir-p $WORKDIR/esp || exit 1
		exec "$0" prepare-esp $WORKDIR/esp
		;;

	################################################# Prepare a reference ESP

	################################################# distro

	select-distro)
		if test X${2+set} '=' Xset; then
			comment=' ('"$2"')'
		else
			comment=
		fi
		"$0" distro list | fzf --layout=reverse-list --no-sort --no-input --border --border-label='Select Distro'"$comment" --preview="$0"' distro preview {}'
		exit 0
		;;

	# Supported distro code
	distro)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires SUBCOMMAND argument >&2
			exit 1
		fi
		SUBCOMMAND="$2"
		if test X"$SUBCOMMAND" '=' Xlist; then
			# This has to be updated in two
			# places: here, and in the
			# 'case "$DISTRO"'
			# Distro names must follow the
			# ZFS naming restrictions for
			# datasets: [A-Za-z0-9][-_:.A-Za-z0-9]*
			cat <<DISTROS
Ubuntu26.04
KUbuntu26.04
Debian13
DISTROS
			exit 0
		fi
		if test X${3+set} '!=' Xset; then
			echo "$0": requires SUBCOMMAND DISTRO arguments >&2
			exit 1
		fi
		DISTRO="$3"
		case "$SUBCOMMAND" in
			# For install-outside sub-command, $4 is the path.
			install-outside)
				if test X${4+set} '!=' Xset; then
					echo "$0": requires SUBCOMMAND DISTRO DIR arguments >&2
					exit 1
				fi
				DIR="$4"
				;;

			# check: Just check that the distro name is
			# valid
			# preview: output a description of the distro.
			# install-outside: Initialize the distro's
			# root files into the specified directory $4,
			# while still in the hosting OS env.
			# At minimum this should include /bin/sh.
			# install-chroot: Continue initializing the
			# distro, but now chrooted inside the BE.
			check|preview|install-chroot)
				:
				;;

			# For install-chroot, the outer driver has
			# created the files:
			#
			#     /usr/local/bin/zfsbootmenu-installer <- this file
			#     /usr/local/mok/MOK.priv <- MOK private key
			#     /usr/local/mok/MOK.pem <- MOK public key PEM format
			#     /usr/local/mok/MOK.der <- MOK public key DER format
			#     /usr/local/username <- username for UID 1000
			#     /etc/zfs/zroot.key <- passphrase for pool and user
			#     /etc/hostname <- hostname
			#     /etc/hosts <- modified to append the hostname and map it to 127.0.0.1
			#     /etc/hostid <- random hostid for this machine
			#
			# The above files are created after install-outside
			# has been run.

			*)
				echo "$0": Unknown distro sub-command: $SUBCOMMAND >&2
				exit 1
				;;

		esac
		# We define our supported distros below.
		# If we add or remove a distro, we should update
		# the list above also.
		case "$DISTRO" in
			Ubuntu26.04)
				case "$SUBCOMMAND" in
					preview)
						cat <<DESC
Ubuntu 26.04 Resolute Raccoon

Ubuntu is the Debian derivative created by Canonical, Ltd.

Installed with Ubuntu Desktop, which is Gnome Shell 50
with Canonical-branded extensions.
DESC
						;;

					install-outside)
						echo "---- zfsbootmenu-installer: Installing Ubuntu26.04"
						"$0" ensure debootstrap && debootstrap resolute "$DIR"
						exit $?
						;;

					install-chroot)
						echo "---- zfsbootmenu-installer: Installing Ubuntu26.04 (in chroot)"
						"$0" ubuntu-install-chroot-common resolute && \
						apt install -y ubuntu-desktop && \
						snap install firefox
						EXIT_CODE=$?
						if test $EXIT_CODE '!=' 0; then
							exit $EXIT_CODE
						fi
						exec "$0" typical-enable-auto-login
						;;

				esac
				;;

			KUbuntu26.04)
				case "$SUBCOMMAND" in
					preview)
						cat <<DESC
KUbuntu 26.04 Resolute Raccoon

Ubuntu is the Debian derivative created by Canonical, Ltd.
KUbuntu is the Ubuntu flavor that comes with KDE Plasma
instead of the Canonical-branded Ubuntu Desktop.

Installed with KDE Plasma.
DESC
						;;

					install-outside)
						echo "---- zfsbootmenu-installer: Installing KUbuntu26.04"
						"$0" ensure debootstrap && debootstrap resolute "$DIR"
						exit $?
						;;

					install-chroot)
						echo "---- zfsbootmenu-installer: Installing KUbuntu26.04 (in chroot)"
						"$0" ubuntu-install-chroot-common resolute
						EXIT_CODE=$?
						if test $EXIT_CODE '!=' 0; then
							exit $EXIT_CODE
						fi
						echo sddm shared/default-x-display-manager select sddm | debconf-set-selections
						apt install -y kubuntu-desktop && \
						snap install firefox
						EXIT_CODE=$?
						if test $EXIT_CODE '!=' 0; then
							exit $EXIT_CODE
						fi
						exec "$0" typical-enable-auto-login
						;;

				esac
				;;

			Debian13)
				case "$SUBCOMMAND" in
					preview)
						cat <<DESC
Debian 13 Trixie

Debian is one of the most successful GNU/Linux
distributions.

Debian 'tasksel' will be launched during
installation to let you select desktop
environments and services.

Nonfree drivers will be installed.
DESC
						;;

					install-outside)
						echo "---- zfsbootmenu-installer: Installing Debian13"
						"$0" ensure debootstrap && debootstrap trixie "$DIR"
						exit $?
						;;

					install-chroot)
						echo "---- zfsbootmenu-installer: Installing Debian13 (in chroot)"
						"$0" debian-install-chroot trixie && \
						apt install -y firmware-linux-nonfree
						exit $?
						;;

				esac
				;;

			# Unrecognized distro name
			*)
				echo "$0": Unknown distro name: $3 >&2
				exit 1
				;;

		esac
		exit 0
		;;

	debian-derivative-override-mok)
		echo "---- zfsbootmenu-installer: debian derivative: Overriding distro MOKs"
		# Ubuntu creates these /var/lib/shim-signed/mok/MOK.priv and MOK.der
		"$0" mkdir-p /var/lib/shim-signed/mok || exit 1
		cp --reflink=auto /usr/local/mok/MOK.priv /var/lib/shim-signed/mok/MOK.priv
		cp --reflink=auto /usr/local/mok/MOK.der /var/lib/shim-signed/mok/MOK.der
		chmod 600 /var/lib/shim-signed/mok/MOK.priv
		# Debian creates these /var/lib/dkms/mok.key and mok.pub
		"$0" mkdir-p /var/lib/dkms || exit 1
		cp --reflink=auto /usr/local/mok/MOK.priv /var/lib/dkms/mok.key
		cp --reflink=auto /usr/local/mok/MOK.der /var/lib/dkms/mok.pub
		chmod 600 /var/lib/dkms/mok.key
		exit 0
		;;

	# Sets up DKMS to sign with the MOK.
	# This is technically incomplete --- the distribution
	# might include closed-source (or even open-source, but
	# precompiled) kernel modules that are not signed by
	# Microsoft or Canonical (sometimes called `kmod`, but
	# `kmod` is a tool that inserts and removes kernel
	# modules from the running kernel...), and those have
	# to be signed by the MOK.
	# No idea how to automate *those*, maybe hack into
	# apt hooks?
	dkms-mok-auto-sign)
		echo "---- zfsbootmenu-installer: DKMS: setup kernel module autosign"
		"$0" mkdir-p /etc/dkms/framework.conf.d || exit 1
