	# Debian

	debian-sources-list)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need RELEASE_NAME argument >&2
			exit 1
		fi
		RELEASE_NAME="$2"
		"$0" mkdir-p /etc/apt || exit 1
		cat > /etc/apt/sources.list <<SOURCES_LIST
# Uncomment the deb-src entries if you need source packages

deb http://deb.debian.org/debian/ $RELEASE_NAME main contrib non-free-firmware
# deb-src http://deb.debian.org/debian/ $RELEASE_NAME main contrib non-free-firmware

deb http://security.debian.org/debian-security/ ${RELEASE_NAME}-security main contrib non-free-firmware
# deb-src http://security.debian.org/debian-security/ ${RELEASE_NAME}-security main contrib non-free-firmware

deb http://deb.debian.org/debian/ ${RELEASE_NAME}-updates main contrib non-free-firmware
# deb-src http://deb.debian.org/debian/ ${RELEASE_NAME}-updates main contrib non-free-firmware

deb http://deb.debian.org/debian/ ${RELEASE_NAME}-backports main contrib non-free-firmware
# deb-src http://deb.debian.org/debian/ ${RELEASE_NAME}-backports main contrib non-free-firmware
SOURCES_LIST
		exit 0
		;;

	debian-install-chroot)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires RELEASE argument>&2
			exit 1
		fi
		RELEASE="$2"
		"$0" debian-sources-list "$RELEASE" && \
		"$0" debian-derivative-prepare && \
		apt install -y --no-install-recommends \
			linux-headers-amd64 linux-image-amd64 \
			zfs-initramfs && \
		"$0" debian-derivative-install-chroot-basics
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi
		"$0" debian-derivative-install-chroot-more && \
		"$0" debian-derivative-install-chroot-zfs-support && \
		"$0" debian-derivative-install-chroot-zfs-config && \
		"$0" debian-derivative-install-chroot-make-user && \
		apt install -y tasksel
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi
		tasksel
		"$0" typical-enable-auto-login
		exit $?
		;;

	# Slimbook OS

	slimbook-download-validate)
		if test X${4+set} '!=' Xset; then
			echo "$0": Need YEAR REV HASH args >&2
			exit 1
		fi
		YEAR="$2"
		REV="$3"
		HASH="$4"

		# Are we already running inside a
		# ZFSBootMenu-managed Boot
		# Environment?
		BE="`"$0" find-current-boot-environment`"
		EXIT_CODE=$?
		if test $EXIT_CODE '=' 0 && zfs list "$BE" > /dev/null 2>&1; then
			whiptail --msgbox 'You are adding SlimbookOS '"$YEAR"' as a new Boot Environment.

Unfortunately, Slimbook OS achieves part of its look by
writing specific files to your /home directory.  Since
/home is shared between Boot Environments, this may cause
issues if you are currently using Gnome Shell or Ubuntu
Desktop, and the changes will also change the look of
other Boot Environments using Gnome Shell / Ubuntu
Desktop.  For this reason, we will not change your /home
directory at all.

To achieve the Slimbook OS look, install these Gnome
Shell extensions (doing so will affect your /home and
thus all Boot Environments using Gnome Shell / Ubuntu
Desktop):

    Dash To Panel
    Lock Keys
    Status Area Horizontal Spacing
' 0 0
		fi

		"$0" iso-download-validate-by-hash \
			"https://cloud.slimbook.net/public.php/dav/files/download/Operating%20systems/Slimbook%20OS/Slimbook%20OS%20${YEAR}/slimbookos-${YEAR}${REV}.iso" \
			"$HASH" || exit 1
		exec "$0" iso-extract-from-installer \
			casper \
			filesystem.squashfs \
			filesystem.gnome.squashfs
		;;

	slimbook-install-chroot-clean-live)
		echo "---- zfsbootmenu-installer: SlimbookOS: Mark Live packages for later removal."
		for KILL_PKG in \
				calamares-modules-slimbook-calamares3.3 \
				calamares-settings-slimbook \
				slimbook-casper-settings \
				; do
			apt-mark auto $KILL_PKG > /dev/null 2>&1
		done
		exit 0
		;;

	# Detect the Slimbook device model and install
	# corresponding packages.
	slimbook-install-chroot-device-specific)
		FAMILY="`slimbookctl info | grep '^[ 	]*family:' | sed -e 's@^[ 	]*family:[ 	]*@@'`"
		echo "---- zfsbootmenu-installer: Slimbook drivers and fixes: family: $FAMILY"
		case $FAMILY in
		elemental)
			apt install -y slimbook-meta-essential
			;;

		titan)
			apt install -y slimbook-meta-hero
			;;

		creative|evo|excalibur|executive|hero-s|nas|one|prox|zero)
			apt install -y  slimbook-meta-$FAMILY
			;;

		*)
			echo "---- zfsbootmenu-installer: Not recognized as Slinbook device."
			;;

		esac
		exit 0
		;;

	slimbook-install-chroot)
		"$0" slimbook-install-chroot-clean-live || exit 1
		"$0" iso-debian-derivative-install-chroot-nikkei 'inside' 'initramfs' || exit 1
		exec "$0" slimbook-install-chroot-device-specific
		;;

	# ISO-squashfs Installation

	# Install via the ISO-squashfs path,
	# for Debian-derivative distros.
	# This first part enables our hooks
	# into signing with the MOK, and
	# signs existing DKMS modules.
	# Call this before installing ZFS
	# inside DKMS.
	iso-debian-derivative-install-chroot-pre-zfs-dkms)
		# Mark these packages for removal.
		# We don't need no grub nor os-prober, and
		# Calamares is the sterotypical installer,
		# while Casper is a tool to create an
		# in-memory filesystem for your Live
		# environment.
		#
		# Don't remove them, because some OSs break
		# if you explicitly remove them:
		#
		# * TUXEDO-OS
		#   * tuxedo-base-files depends on grub-common,
		#     and it contains vital files like
		#     /usr/share/tuxedo/sddm-hook, which hooks
		#     at each dpkg invocation.
		#
		# Mark them as auto instead in case the
		# Live has them as manual, so that at the
		# end we do `autoremove` and remove packages,
		# but only if vital OS packages like the
		# TUXEDO-OS case above don't keep them
		# installed.
		echo "---- zfsbootmenu-installer: ISO: Debian derivative: Scheduling removal of packages unneeded for non-GRUB root-on-ZFS."
		# kernelstub is a Pop!_OS-only package, which
		# contains a simple kernel stub EFI bootloader
		# script.
		# Kill it here because ZFSBootMenu > kernelstub
		for TO_REMOVE in \
				btrfs-progs btrfsd btrfsmaintenance \
				os-prober calamares casper kernelstub \
				xfsdump xfsprogs kernelstub shim shim-signed \
				nullboot memtest86+ \
				; do
			apt-mark auto "$TO_REMOVE" > /dev/null 2>&1
		done
		apt-mark showmanual | \
		while read line; do
			case "$line" in
			grub-*|grub2-*)
				apt-mark auto "$line" > /dev/null 2>&1
				;;

			esac
		done

		# If there is a filesystem.manifest-remove,
		# mark them as auto-installed at this point.
		if test -f /filesystem.manifest-remove; then
			echo "---- zfsbootmenu-installer: ISO: Scheduling filesystem.manifest-remove packages for later removal"
			cat /filesystem.manifest-remove | \
			while read line; do
				apt-mark auto "$line" > /dev/null 2>&1
			done
			rm /filesystem.manifest-remove
		fi

		# Most LiveCDs use casper.  Disable it.
		# If these error, it's fine, we ignore it.
		systemctl disable casper-md5check.service > /dev/null 2>&1
		systemctl disable casper.service > /dev/null 2>&1

		"$0" debian-derivative-prepare || exit 1
		apt install -y --no-install-recommends dkms || exit 1
		"$0" dkms-sign-all-modules || exit 1
		apt install -y sudo debconf || exit 1
		exec dpkg-reconfigure keyboard-configuration tzdata locales
		;;

	# In between these two functions, install
	# ZFS:
	# - kernel module
	# - zpool, zfs, and other bins
	# - zfs-auto-snapshot
	# - zfs-initramfs or zfs-dracut

	# Install via the ISO-squashfs path,
	# for Debian-derivative distros.
	# This finishes up the installation,
	# including making the user, and
	# should be done after installing
	# ZFS module.
	iso-debian-derivative-install-chroot-post-zfs-dkms)
		"$0" debian-derivative-install-chroot-more || exit 1
		"$0" debian-derivative-install-chroot-zfs-config || exit 1
		"$0" debian-derivative-install-chroot-make-user || exit 1
		exit 0
		;;

	iso-debian-derivative-install-chroot-final-cleanup)
		echo "---- zfsbootmenu-installer: ISO: debian derivative: clean up unneeded packages"
		"$0" debian-derivative-eliminate-grub
		yes | apt autoremove
		yes | apt clean
		exit 0
		;;

	# Just do everything for a Live->Prod ISO install-chroot,
	# based on SELECTOR and INITRD_MAKER
	# Especially useful for ISOs that ship with a
	# filesystem.manifest-remove file.
	iso-debian-derivative-install-chroot-nikkei)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires SELECTOR INITRD_MAKER argument >&2
			exit 1
		fi
		SELECTOR="$2"
		INITRD_MAKER="$3"
		"$0" iso-debian-derivative-install-chroot-pre-zfs-dkms || exit 1
		#
		"$0" debian-derivative-install-chroot-zfs-i-choose-you "$SELECTOR" "$INITRD_MAKER" || exit 1
		#
		"$0" iso-debian-derivative-install-chroot-post-zfs-dkms || exit 1
		"$0" iso-debian-derivative-install-chroot-final-cleanup || exit 1
		"$0" typical-enable-auto-login || exit 1
		exit 0
		;;

	# Pop!_OS installation

	pop-download)
		if test X${4+set} '!=' Xset; then
			echo "$0": Need YEAR MONTH REV arguments >&2
			exit 1
		fi
		YEAR="$2"
		MONTH="$3"
		REV="$4"
		"$0" iso-download-validate \
			pop-iso-signing-key \
			"https://iso.pop-os.org/${YEAR}.${MONTH}/amd64/nvidia/${REV}/pop-os_${YEAR}.${MONTH}_amd64_nvidia_${REV}.iso" \
			"pop-os_${YEAR}.${MONTH}_amd64_nvidia_${REV}.iso" \
			"https://iso.pop-os.org/${YEAR}.${MONTH}/amd64/nvidia/${REV}/SHA256SUMS" \
			"https://iso.pop-os.org/${YEAR}.${MONTH}/amd64/nvidia/${REV}/SHA256SUMS.gpg" || exit 1
		exec "$0" iso-extract-from-installer \
			casper \
			filesystem.squashfs \
			filesystem.manifest-remove
		;;

	pop-install-chroot)
		echo "---- zfsbootmenu-installer: Removing installer and bootloader..."
		for KILL_PKG in pop-installer pop-installer-casper \
				pop-installer-session; do
			apt-mark auto $KILL_PKG > /dev/null 2>&1
		done
		"$0" iso-debian-derivative-install-chroot-nikkei 'dkms' 'initramfs' || exit 1
		exit 0
		;;

	# TUXEDO OS

	tuxedo-download)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need DATE argument >&2
			exit 1
		fi
		DATE="$2"
		"$0" iso-download-validate \
			tuxedo-iso-signing-key \
			"https://os.tuxedocomputers.com/TUXEDO-OS-$DATE.iso" \
			"TUXEDO-OS-$DATE.iso" 	\
			"https://os.tuxedocomputers.com/checksums/TUXEDO-OS-$DATE.iso.sha256" \
			"https://os.tuxedocomputers.com/checksums/TUXEDO-OS-$DATE.iso.sha256.asc"
		exec "$0" iso-extract-from-installer \
			tuxedo \
			tuxedo.amd64
		;;

	# The TUXEDO OS Live CD comes with a very
	# strange set of .list files in its
	# /etc/apt/sources.list.d/ and doesn't
	# match what is in a "real" install from
	# the same Live CD.
	# Clear out that dir and reset its contents
	# to what we have in the "real" install
	# from a virtual machine.
	tuxedo-reset-sources)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires BASE RELEASE argument >&2
			exit 1
		fi
		BASE="$2"
		RELEASE="$3"
		rm -rf /etc/apt/sources.list.d /etc/apt/sources.list > /dev/null 2>&1
		"$0" mkdir-p /etc/apt/sources.list.d || exit 1
		ln -s /usr/share/tuxedo-repository/tuxedo-computers.sources /etc/apt/sources.list.d/tuxedo-computers.sources
		cat > /etc/apt/sources.list.d/tuxedo-os-plasma.sources <<SOURCES
Types: deb
URIs: https://txos.tuxedocomputers.com/$BASE-plasma
Suites: $RELEASE $RELEASE-updates
Components: main
Signed-by: /usr/share/keyrings/tuxedo-archive-keyring.gpg
SOURCES
		cat > /etc/apt/sources.list.d/tuxedo-os.sources <<SOURCES
Types: deb
URIs: https://txos.tuxedocomputers.com/$BASE
Suites: $RELEASE
Components: main
Signed-by: /usr/share/keyrings/tuxedo-archive-keyring.gpg

Types: deb
URIs: https://txos-extra.tuxedocomputers.com/$BASE
Suites: $RELEASE
Components: main
Signed-by: /usr/share/keyrings/tuxedo-archive-keyring.gpg
SOURCES
		if test "$BASE" '=' ubuntu; then
			cat > /etc/apt/sources.list.d/tuxedo-ubuntu-mirrors.sources <<SOURCES
Types: deb
URIs: https://mirrors.tuxedocomputers.com/ubuntu/mirror/archive.ubuntu.com/ubuntu
Suites: $RELEASE $RELEASE-updates
Components: main restricted universe multiverse
Signed-by: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: https://mirrors.tuxedocomputers.com/ubuntu/mirror/security.ubuntu.com/ubuntu
Suites: $RELEASE-security
Components: main restricted universe multiverse
Signed-by: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES
		else
			echo "$0" Unknown base $BASE >&2
			exit 1
		fi

		apt update || exit 1
		exit 0
		;;

	tuxedo-install-chroot-clean-live)
		# Somehow this gets lost?  Sigh.
		cp /var/lib/flatpak/repo/config /flatpak-repo-config.bak
		cp /var/lib/flatpak/repo/flathub.trustedkeys.gpg /flatpak-repo-flathub.trustedkeys.gpg.bak
		# Clean up the dirt in the Live
		echo "---- zfsbootmenu-installer: TUXEDO-OS: Remove FLL (Live environment), Installer, and Chroot Helper"
		for FLL_SERVICE in \
				fll-adduser fll-cmdline fll-live \
				fll-locales fll-snakeoil-cert \
				fll-xdm \
				tuxedo-common-livesettings \
				tuxedo-kde-livesettings \
				; do
			yes | \
			systemctl disable $FLL_SERVICE > /dev/null 2>&1
		done
		# Do this one at a time in case package
		# names for one of them changes, we still
		# want to remove as much as possible.
		for FLL_PKG in \
				fll-live-initramfs fll-live-initscripts \
				fll-live-utils \
				tuxedo-common-livesettings \
				tuxedo-kde-livesettings \
				tuxedo-sddm-livesettings \
				calamares \
				calamares-branding-tuxedo \
				tuxedo-repair \
				virt-what \
				; do
			echo "---- zfsbootmenu-installer: TUXEDO-OS: Try remove $FLL_PKG"
			# Say yes to anything they want to
			# ask, just get it out.
			yes | apt remove "$FLL_PKG"
		done
		echo "---- zfsbootmenu-installer: TUXEDO-OS: FLL cleanup and fixing"
		# Fixups, as seen from the Tuxedo custom
		# calamares fll* scripts.
		rm /etc/sudoers.d/15_TUXEDO-OS
		rm -rf /fll > /dev/null 2>&1
		rm -f /etc/systemd/system/getty@.service > /dev/null 2>&1
		rm -f /etc/systemd/system/autovt@.service > /dev/null 2>&1
		ln -fs /lib/systemd/system/autovt@.service /etc/systemd/system/getty.target.wants/getty@tty1.service > /dev/null 2>&1
		rm -f /root/.hushlogin > /dev/null 2>&1
		rm -rf /usr/share/tuxedo/packages > /dev/null 2>&1

		# Remove existing 'tux' user and
		# make sure /home is empty
		echo "---- zfsbootmenu-installer: TUXEDO-OS: Remove 'tux' user"
		# deluser might scan /proc, which is
		# the current user's environment in
		# whatever Boot Environment or Live
		# the user is doing, and prevent
		# removal if the user has running
		# processes.
		# The current user is likely UID=1000,
		# which is also the UID of tux in
		# the TUXEDO-OS ISO image.
		# userdel is a low-level tool that
		# just removes the user entry.
		userdel tux > /dev/null 2>&1
		rm -rf /home > /dev/null 2>&1
		mkdir /home > /dev/null 2>&1

		# Real installs include these.
		echo "---- zfsbootmenu-installer: TUXEDO-OS: Ensure TUXEDO configuration."
		apt install -y tuxedo-common-settings tuxedo-base-files tuxedo-theme-plasma || exit 1

		exit 0
		;;

	tuxedo-install-chroot-final-fixup)
		cp /flatpak-repo-config.bak /var/lib/flatpak/repo/config
		cp /flatpak-repo-flathub.trustedkeys.gpg.bak /var/lib/flatpak/repo/flathub.trustedkeys.gpg
		exit 0
		;;

	tuxedo-enable-auto-login)
		USERNAME="`cat /usr/local/username`"
		# The calamares install also adds a /etc/sddm.conf
		# file.
		cat > /etc/sddm.conf <<CONF
[Autologin]
Relogin=false
Session=plasma
User=$USERNAME
CONF

		# The installed /etc/sddm.conf.d/kde_settings.conf
		# here already has an [Autologin] section on
		# TUXEDO OS 202609161651.
		# The section has an empty User=, which makes sddm
		# log into the [Last] User= in the file
		# /var/lib/sddm/state.conf
		# It also defaults Session=plasmax11, but the
		# installer modifies it to plasma if it detects
		# Wayland-compatible (which should be ~everyone)
		#
		# Now the problem is, on first installing,
		# [Last] User= is not populated yet, so we just
		# put an explicit [Autologin] User=username in
		# /etc/sddm.conf.d/kde_settings.conf
		#
		# This part is where we probe for it.
		#
		# If we fail to probe for the expected
		# kde_settings.conf, we just delete
		# kde_settings.conf (if it exists) and fall back
		# to typical.

		GOT_EXPECTED=no

		SETTINGS=/etc/sddm.conf.d/kde_settings.conf
		echo "---- zfsbootmenu-installer: TUXEDO-OS: Enable auto login"

		if test -f $SETTINGS; then
			if grep '^[ 	]*\[Autologin\][ 	]*$' $SETTINGS > /dev/null 2>&1; then
				if grep '^[ 	]*User[ 	]*=[ 	]*$' $SETTINGS > /dev/null 2>&1; then
					GOT_EXPECTED=yes
				fi
			fi
		fi

		if test $GOT_EXPECTED '=' yes; then
			echo "---- zfsbootmenu-installer: TUXEDO-OS: Filling in User= setting in $SETTINGS"
			mv $SETTINGS $SETTINGS.bak || exit 1
			cat $SETTINGS.bak \
			| sed -e 's@^[	 ]*User[	 ]*=[	 ]*$@User='"$USERNAME"'@' \
			| sed -e 's@^[	 ]*Session[	 ]*=[	 ]*plasmax11[	 ]*$@Session=plasma@' \
				> $SETTINGS
			if test '!' -f $SETTINGS; then
				echo "$0": Failed to change kde_settings.conf >&2
				mv $SETTINGS.bak $SETTINGS
				exit 0
			fi
			chmod 644 $SETTINGS
		else
			echo "---- zfsbootmenu-installer: TUXEDO-OS: Unexpected $SETTINGS, falling back to typical...."
			# Fallback. Move the current settings
			# if any.
			mv $SETTINGS $SETTINGS.bak > /dev/null 2>&1
			exec "$0" typical-enable-auto-login
		fi

		exit 0
		;;

	tuxedo-install-chroot)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires BASE RELEASE argument >&2
			exit 1
		fi
		BASE="$2"
		RELEASE="$3"
		"$0" tuxedo-reset-sources "$BASE" "$RELEASE" || exit 1

		"$0" tuxedo-install-chroot-clean-live || exit 1

		"$0" iso-debian-derivative-install-chroot-pre-zfs-dkms || exit 1

		echo "---- zfsbootmenu-installer: TUXEDO-OS: Install ZFS packages."
		# If it is based on ubuntu, we don't
		# need zfs-dkms.
		# The Ubuntu-based kernel (modified
		# by TUXEDO) has a ZFS module that is
		# signed by the kernel's own building
		# key, which it always accepts, so
		# doesn't need MOK signing.
		# Otherwise, assume it's Debian-based
		# and use zfs-dkms.
		case $BASE in
		ubuntu)
			"$0" debian-derivative-install-chroot-zfs-inside "initramfs" || exit 1
			;;

		*)
			"$0" debian-derivative-install-chroot-zfs-the-dkms "initramfs" || exit 1
			;;

		esac

		"$0" iso-debian-derivative-install-chroot-post-zfs-dkms || exit 1

		# We removed FLL packages,
		# let's clean up.
		"$0" iso-debian-derivative-install-chroot-final-cleanup || exit 1

		# Fix up some things that magically get broken
		"$0" tuxedo-install-chroot-final-fixup || exit 1

		exec "$0" tuxedo-enable-auto-login
		;;

	# PureOS

	pure-download-validate)
		if test X${6+set} '!=' Xset; then
			echo require RELEASE YEARMONTH RNUM DATE HASH arguments >&2
			exit 1
		fi
		RELEASE="$2"
		YEARMONTH="$3"
		RNUM="$4"
		DATE="$5"
		HASH="$6"

		URL="https://storage.puri.sm/pureos/images/${RELEASE}/${YEARMONTH}/gnome/pureos-${RNUM}-gnome-live-${DATE}_amd64.iso"

		echo "---- zfsbootmenu-installer: PureOS$RNUM: Download and validate ISO."
		"$0" iso-download-validate-by-hash \
			"$URL" "$HASH" || exit 1

		echo "---- zfsbootmenu-installer: PureOS$RNUM: Extracting from ISO"
		exec "$0" iso-extract-from-installer casper filesystem.squashfs
		;;

	pure-install-chroot-clean-live)
		if test X${2+set} '!=' Xset; then
			echo require RNUM arguments >&2
			exit 1
		fi
		RNUM="$2"
		echo "---- zfsbootmenu-installer: PureOS$RNUM: Mark Live packages for later removal"
		for KILL_PKG in adwaita-qt pureos-live-settings; do
			apt-mark auto $KILL_PKG > /dev/null 2>&1
		done
		exit 0
		;;

	pure-install-chroot)
		if test X${2+set} '!=' Xset; then
			echo require RNUM arguments >&2
			exit 1
		fi
		RNUM="$2"

		"$0" pure-install-chroot-clean-live "$RNUM" || exit 1
		exec "$0" iso-debian-derivative-install-chroot-nikkei 'none' 'initramfs' || exit 1
		;;

	# zfsbootmenu-installer hooks

	# Hook this on adding a new file, or modifying
	# a file, to the system:
	# install, upgrade, downgrade
	zbmi-post-new-hook)
		# TODO find unsigned kernel modules and
		# sign them with the MOK
		exit 0
		;;

	# Hook this on a change in the system:
	# install, upgrade, downgrade, uninstall
	zbmi-post-change-hook)
		exec "$0" follow-grub-cmdline-linux-default
		;;

	# Prints out a small shell script that only
	# calls into zfsbootmenu-installer if DPKG is
	# installing, removing, or purging.
	# We use this instead of calling drectly into
	# /usr/local/bin/zfsbootmenu-installer zbmi-post-add-hook et al
	# so that other dpkg actions like
	# configure etc do not require loading the
	# 2000-line zfsbootmenu-installer
	zbmi-print-dpkg-post-hook)
		cat <<SCRIPT
#! /bin/sh
case \$DPKG_HOOK_ACTION in
install)
	/usr/local/bin/zfsbootmenu-installer zbmi-post-new-hook &&
	/usr/local/bin/zfsbootmenu-installer zbmi-post-change-hook
	exit \$?
	;;

remove|purge)
	exec /usr/local/bin/zfsbootmenu-installer zbmi-post-change-hook
	;;

esac
exit 0
SCRIPT
		;;

	zbmi-install-dpkg-post-hook)
		"$0" mkdir-p /usr/local/lib/zfsbootmenu-installer
		"$0" zbmi-print-dpkg-post-hook > /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		chmod +x /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		exec test -x /usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
		;;

	################################################# distro

	################################################# ...FromISO

	# Extract the squashfs files from the ISO.
	install-fromiso-extract-from-iso)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO arg >&2
			exit 1
		fi
		ISO="$2"
		rm -rf $WORKDIR/assess > /dev/null 2>&1
		rm -rf $WORKDIR/iso-report > /dev/null 2>&1
		rm -rf $WORKDIR/prepare
		"$0" mkdir-p $WORKDIR/prepare || exit 1

		"$0" assess-iso-main-structure "$ISO" || exit 1

		. $WORKDIR/iso-report

		if test X"$isomain" '=' Xunknown; then
			echo "$0": ISO layout not recognized >&2
			exit 1
		fi

		cp $WORKDIR/mnt/"$isomain" $WORKDIR/prepare/"$isomainbase" || exit 1
		if test X"$isosecond" '!=' Xnone; then
			cp $WORKDIR/mnt/"$isosecond" $WORKDIR/prepare/"$isosecondbase" || exit 1
		fi
		if test X"$isoremove" '!=' Xnone; then
			cp $WORKDIR/mnt/"$isoremove" $WORKDIR/prepare/"$isoremovebase" || exit 1
		fi
		umount -qnR $WORKDIR/mnt > /dev/null 2>&1

		exit 0
		;;

	# Expand the squashfs files indicated in the
	# iso-report to the $WORKDIR/mnt
	install-fromiso-unsquash)
		if test '!' -d $WORKDIR/mnt; then
			echo "$0": No $WORKDIR/mnt directory >&2
			exit 1
		fi

		. $WORKDIR/iso-report

		unsquashfs -f -d $WORKDIR/mnt $WORKDIR/prepare/"$isomainbase" || exit 1
		if test X"$isosecond" '!=' Xnone; then
			unsquashfs -f -d $WORKDIR/mnt $WORKDIR/prepare/"$isosecondbase" || exit 1
		fi
		if test X"$isoremove" '!=' Xnone; then
			cp $WORKDIR/prepare/"$isoremovebase" $WORKDIR/mnt/filesystem.manifest-remove || exit 1
		fi

		"$0" assess-iso-read-rootfs $WORKDIR/mnt || exit 1
		"$0" install-fromiso-check-iso-report || exit 1
		cp $WORKDIR/iso-report $WORKDIR/mnt/iso-report || exit 1

		exit 0
		;;

	# Check the $WORKDIR/iso-report if we
	# support the squashfs from the ISO
	# file.
	install-fromiso-check-iso-report)
		. $WORKDIR/iso-report

		case "$packager" in
		apt)
			;;

		*)
			echo "$0": Unsupported packager: $packager >&2
			exit 1
			;;

		esac
		case "$init" in
		systemd)
			;;

		*)
			echo "$0": Unsupported init system: $init >&2
			exit 1
			;;

		esac
		case "$initrdmaker" in
		initramfs|dracut)
			;;

		*)
			echo "$0": Unsupported initrd maker: $initrdmaker >&2
			exit 1
			;;

		esac
		exit 0
		;;

	# Prepares live packages for uninstallation,
	# reading the list from stdin.
	install-fromiso-uninstall-stdin)
		if test X"${2+set}" '!=' Xset; then
			echo "$0": requires PKGR argument >&2
			exit 1
		fi
		PKGR="$2"
		case "$PKGR" in
		apt)
			while read line; do
				echo Marking for removal: $line
				apt-mark auto $line || exit 1
			done
			;;

		esac
		exit 0
		;;

	# performs ISO install within the
	# rootfs chroot.
	# /iso-report must exist
	install-fromiso-chroot)
		if test '!' -f /iso-report; then
			echo "$0": No /iso-report file >&2
			exit 1
		fi
		. /iso-report
		rm -rf /iso-report > /dev/null 2>&1

		case "$packager" in
		apt)
			LISTINSTALLED="apt-mark showmanual"
			NIKKEI="iso-debian-derivative-install-chroot-nikkei"
			;;

		esac

		echo "---- zfsbootmenu-installer: FromISO: Marking live packages for uninstallation later..."
		$LISTINSTALLED | \
		"$0" guess-live-filter $packager | \
		"$0" install-fromiso-uninstall-stdin $packager
		if test $? '!=' 0; then
			echo "$0": Unmarking failed.
			exit 1
		fi

		# Handle TUXEDO-specific pre-install tasks.
		if test X"$tuxedo" '=' Xyes; then
			echo "---- zfsbootmenu-installer: FromISO: TUXEDO-specific pre-install tasks."
			apt modernize-sources
			"$0" tuxedo-install-chroot-clean-live || exit 1
		fi

		# TODO: pass in the `init` system.
		"$0" "$NIKKEI" "$zfs" "$initrdmaker" || exit 1

		# Handle TUXEDO-specific post-install tasks.
		if test X"$tuxedo" '=' Xyes; then
			echo "---- zfsbootmenu-installer: FromISO: TUXEDO-specific post-install tasks."
			"$0" tuxedo-install-chroot-final-fixup || exit 1
			"$0" tuxedo-enable-auto-login || exit 1
		fi

		# Handle SlimbookOS-specific post-install tasks
		if test X"$slimbook" '=' Xyes; then
			echo "---- zfsbootmenu-installer: FromISO: SlimbookOS-specific post-install tasks"
			"$0" slimbook-install-chroot-device-specific || exit 1
		fi

		exit 0
		;;

	# Install the given $ISO into a new
	# $TANK_NAME/ROOT/$BE dataset,
	# taking files from $WORKDIR/config.
	# Does not clean up workdir or unmount
	# or change mountpoint of new dataset
	# if installation fails.
	# TODO: unify with install-distro-core
	install-fromiso-core)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires ISO BE argument >&2
			exit 1
		fi
		ISO="$2"
		BE="$3"
		if test '!' -f "$ISO"; then
			echo "$0": Not found: "$ISO" >&2
			exit 1
		fi
		"$0" check-distro-not-installed "$BE" || exit 1

		echo "---- zfsbootmenu-installer: FromISO: Preparing to install '$ISO' -> '$BE'."
		"$0" install-fromiso-extract-from-iso "$ISO" || exit 1

		echo "---- zfsbootmenu-installer: FromISO: Initial install."
		zfs create -o mountpoint=$WORKDIR/mnt -o canmount=noauto \
			$TANK_NAME/ROOT/"$BE" || exit 1
		zfs mount $TANK_NAME/ROOT/"$BE" || exit 1
		"$0" install-fromiso-unsquash || exit 1

		"$0" copy-config-to-new-distro || exit 1
		"$0" mount-magic-to-new-distro || exit 1

		echo "---- zfsbootmenu-installer: FromISO: Chroot install."
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer \
				install-fromiso-chroot || exit 1

		# Final signing and log compression.
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer \
				sign-all-kernels || exit 1
		echo "---- zfsbootmenu-installer: FromISO: Disable log compression if possible (best effort)"
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer \
				typical-no-compress-logs || exit 1

		# Restore /etc/resolv.conf if there
		# was a backup.
		mv $WORKDIR/mnt/etc/resolv.conf.bak $WORKDIR/mnt/etc/resolv.conf > /dev/null 2>&1

		exit 0
		;;

	# Given an .iso file, infer a Boot Environment
	# name for it.
	install-fromiso-infer-be)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO argument >&2
			exit 1
		fi
		ISO="$2"
		BE="`"$0" install-fromiso-infer-be-core "$ISO"`"
		if test $? '!=' 0 -o X"$BE" '=' X; then
			BE=GNULinux
		fi
		echo "$BE"
		exit 0
		;;

	install-fromiso-infer-be-core)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO argument >&2
			exit 1
		fi
		ISO="$2"
		"$0" ensure isoinfo || exit 1
		isoinfo -d -i "$ISO" | \
		grep '^Volume id:' | \
		sed -e 's@^Volume id:[ 	]*@@' | \
		sed -e 's@[ 	]*$@@' | \
		sed -e 's@[^-_.A-Za-z0-9]@@g' | \
		sed -e 's@^[^A-Za-z0-9]@@'
		exit $?
		;;

	# Use `whiptail` to ask the user for
	# the name to use for the boot environment
	# from an ISO.
	# Write out the boot env to $WORKDIR/config/be
	install-fromiso-ask-be)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO argument >&2
			exit 1
		fi
		ISO="$2"

		INI="`"$0" install-fromiso-infer-be "$ISO"`"
		exec "$0" install-fromiso-ask-be-loop "$INI"
		;;

	install-fromiso-ask-be-loop)
		if test X${2+set} '!=' Xset; then
			echo "$0": require BE argument >&2
			exit 1
		fi
		BE="$2"
		"$0" mkdir-p $WORKDIR/config || exit 1
		rm -rf $WORKDIR/config/be > /dev/null 2>&1
		whiptail --inputbox 'Give name for Boot Environment' 0 45 "$BE" 2> $WORKDIR/config/be
		if test $? '!=' 0; then
			exit 1
		fi
		BE="`cat $WORKDIR/config/be`"
		if grep '^[A-Za-z0-9][-A-Za-z0-9_.]*$' $WORKDIR/config/be > /dev/null 2>&1; then :; else
			whiptail --msgbox 'Boot Environment name must start with basic Latin letter or digit, and cannot be empty.

Beyond the first character, you can also use . - _
Spaces are not allowed.' 0 0
			exec "$0" install-fromiso-ask-be-loop "$BE"
		fi
		if zfs list $TANK_NAME/ROOT/"$BE" > /dev/null 2>&1; then
			whiptail --msgbox 'Boot Environment with that name exists.

Please provide another name.' 0 0
			exec "$0" install-fromiso-ask-be-loop "$BE"
		fi
		exit 0
		;;

	################################################# ...FromISO

	################################################# Live Env Package heuristics

	# Given a package manager and a package name,
	# infer if we should NOT consider the package
	# as being part of a live environment.
	# exit 0 if we think it should be kept,
	# exit 1 if we think it should be removed.
	guess-live-keep)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires PKGR PKGNAME args >&2
			exit 1
		fi
		PKGR="$2"
		PKGNAME="$3"
		# Currently only support `apt`
		if test X"$PKGR" '!=' Xapt; then
			echo "$0": TODO only support apt now >&2
			exit 1
		fi
		case "$PKGNAME" in
		deepin-deb-installer)
			exit 0
			;;

		diaspora-installer|diaspora-installer-*)
			exit 0
			;;

		# Could be part of live env, but can also
		# be used in prod to change for various
		# age groups.
		edubuntu-installer)
			exit 0
			;;

		firmware-*-installer)
			exit 0
			;;

		google-android-*-installer)
			exit 0
			;;

		josm-installer|lxd-installer)
			exit 0
			;;

		mintinstall|opam-installer)
			exit 0
			;;

		plasma-runner-installer|pokemmo-installer)
			exit 0
			;;

		publicfile-installer)
			exit 0
			;;

		python*-installer*)
			exit 0
			;;

		qapt-deb-installer)
			exit 0
			;;

		steam-installer|ttf-*-installer)
			exit 0
			;;

		ubuntustudio-installer)
			exit 0
			;;

		#        __ ___ _
		# I (\/)  / |_ (_
		# I  \/  /_ |   _)
		zfs-*|zfsutils*|*-zfs|zfsbootmenu-installer)
			exit 0
			;;

		esac
		exit 1
		;;

	# Given a package manager and a package name,
	# infer if we should consider the package
	# potentially part of a live environment,
	# unless `guess-live-keep` say it's not.
	# exit 0 if we think it should be removed,
	# exit 1 if we think it should be kept.
	guess-live-remove)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires PKGR PKGNAME args >&2
			exit 1
		fi
		PKGR="$2"
		PKGNAME="$3"
		# Currently only support `apt`
		if test X"$PKGR" '!=' Xapt; then
			echo "$0": TODO only support apt now >&2
			exit 1
		fi
		case "$PKGNAME" in
		calamares-branding-*|calamares-modules-*|calamares-settings-*)
			exit 0
			;;

		*-casper-settings)
			exit 0
			;;

		fll-*)
			exit 0
			;;

		*-installer|*-installer-*)
			exit 0
			;;

		*-live-settings|*-livesettings|*-live-session|*-livesession)
			exit 0
			;;

		ubiquity|ubiquity-*)
			exit 0
			;;

		# Known distro-specific live envs

		tuxedo-repair*)
			exit 0
			;;

		*ubuntu*-live)
			exit 0
			;;

		zorin-os*-live|*-zorin-live)
			exit 0
			;;

		esac
		exit 1
		;;

	# Gets input packages from stdin
	# and outputs to stdout the package
	# names of packages we think are
	# from a live environment and
	# ought to be removed.
	# The expected use-case is that
	# the output of `apt-mark showmanual`
	# is fed to this.
	guess-live-filter)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires PKGR arg >&2
			exit 1
		fi
		PKGR="$2"
		while read line; do
			for PKGNAME in $line; do
				# Keep is higher priority.
				# See the "*-installer"
				# packages we allow because
				# they're not DISTRO
				# installers.
				if "$0" guess-live-keep "$PKGR" "$PKGNAME"; then
					:
				elif "$0" guess-live-remove "$PKGR" "$PKGNAME"; then
					echo $PKGNAME
				fi
			done
		done
		exit 0
		;;

	################################################# Live Env Package heuristics

	################################################# OpenZFS Direct Compile

	openzfs-info)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires SUBCOMMAND argument >&2
			exit 1
		fi
		SUBCOMMAND="$2"
		case $SUBCOMMAND in
		url)
			echo 'https://github.com/openzfs/zfs/releases/download/zfs-2.3.9/zfs-2.3.9.tar.gz'
			;;

		basename)
			echo 'zfs-2.3.9.tar.gz'
			;;

		dir)
			echo 'zfs-2.3.9'
			;;

		hash)
			echo '26b0c7d433ebc3cbea5289b9d06792d628aff13c2c6e5ce70096db1b026c5699'
			;;

		*)
			echo "$0": Unknown subcommand $SUBCOMMAND >&2
			exit 1
			;;

		esac
		exit 0
		;;

	# Download the tarball into the $DIR,
	# validate it, and extract it.
	openzfs-download-validate)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DIR argument >&2
			exit 1
		fi
		DIR="$2"
		ZFS_URL="`"$0" openzfs-info url`"
		ZFS_BASENAME="`"$0" openzfs-info basename`"
		ZFS_DIR="`"$0" openzfs-info dir`"
		ZFS_SHA256="`"$0" openzfs-info hash`"
		if test X"$DIR" '=' Xnone; then
			echo "$ZFS_DIR"
			exit 0
		fi

		"$0" ensure gzip || exit 1
		"$0" ensure tar || exit 1
		"$0" ensure wget || exit 1

		echo "---- zfsbootmenu-installer: Download and validate $ZFS_DIR"

		cd "$DIR"
		wget --no-verbose "$ZFS_URL" --output-document=./"$ZFS_BASENAME" > /dev/null
		echo "$ZFS_SHA256" "$ZFS_BASENAME" | sha256sum -c
		if test $? '!=' 0; then
			echo "$0": Failed validation >&2
			exit 1
		fi
		tar xzf "$ZFS_BASENAME"
		if test '!' -d "$ZFS_DIR"; then
			echo "$0": Failed to extract archive >&2
			exit 1
		fi
		rm -rf ./"$ZFS_BASENAME" > /dev/null 2>&1
		exit 0
		;;

	# Install dependencies needed to compile
	# OpenZFS
	openzfs-debian-derivative-install-deps)
		echo "---- zfsbootmenu-installer: Installing OpenZFS dependencies..."
		exec \
		apt install -y\
			alien autoconf automake build-essential \
			debhelper-compat dh-dkms dh-python dkms \
			fakeroot gawk libaio-dev libattr1-dev \
			libblkid-dev libcurl4-openssl-dev libelf-dev \
			libffi-dev libpam0g-dev libssl-dev libtirpc-dev \
			libtool libudev-dev linux-headers-generic \
			po-debconf python3 python3-all-dev python3-cffi \
			python3-dev python3-packaging python3-setuptools \
			python3-sphinx uuid-dev zlib1g-dev
		;;

	# Compiles ZFS in the ZFS_DIR.
	# Note that OpenZFS weirdly enough
	# puts its .deb files one layer out.
	# Also specify whether you use
	# initramfs or dracut as the second
	# argument.
	openzfs-debian-derivative-compile)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires ZFS_DIR INITRD_MAKER argument >&2
			exit 1
		fi
		ZFS_DIR="$2"
		INITRD_MAKER="$3"
		case "$INITRD_MAKER" in
		initramfs|dracut)
			;;

		*)
			echo "$0": Unrecognized INITRD_MAKER $INITRD_MAKER >&2
			exit 1
			;;
		esac
		echo "---- zfsbootmenu-installer: Compile OpenZFS: configure, please wait..."
		cd $ZFS_DIR
		./configure --enable-systemd --enable-silent-rules --silent || exit 1
		echo "---- zfsbootmenu-installer: Compile OpenZFS: compiling, please wait..."
		make -j8 native-deb-utils || exit 1

		# Delete the INITRD_MAKER that is not selected.
		if test "$INITRD_MAKER" '=' initramfs; then
			cd ..
			rm -f openzfs-zfs-dracut_*.deb > /dev/null 2>&1
		else
			cd ..
			rm -f openzfs-zfs-initramfs_*.deb > /dev/null 2>&1
		fi
		# Delete the ZFS libpam, it's more trouble than
		# it's worth.
		rm -f openzfs-libpam-zfs_* > /dev/null 2>&1
		rm -f openzfs-libpam-zfs-dbgsym_* > /dev/null 2>&1
		exit 0
		;;

	# Download OpenZFS and build it
	# locally.
	# Give INITRD_MAKER as either initramfs
	# or dracut.
	openzfs-debian-derivative-download-build)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires INITRD_MAKER argument >&2
			exit 1
		fi
		INITRD_MAKER="$2"

		SRCDIR="$LOCALSRCDIR"/openzfs
		CACHE=$SRCDIR/cache
		ZFS_VER="`"$0" openzfs-info dir`"

		echo "---- zfsbootmenu-installer: Debian derivative: Download and build OpenZFS."

		# Download
		"$0" mkdir-p $CACHE || exit 1
		"$0" openzfs-download-validate "$CACHE" || exit 1

		# Move it to its own directory.
		"$0" mkdir-p $SRCDIR/build-$ZFS_VER || exit 1
		mv $CACHE/$ZFS_VER $SRCDIR/build-$ZFS_VER/$ZFS_VER || exit 1

		# Install dependencies
		"$0" openzfs-debian-derivative-install-deps || exit 1

		# Compile
		"$0" openzfs-debian-derivative-compile "$SRCDIR/build-$ZFS_VER/$ZFS_VER" "$INITRD_MAKER" || exit 1

		exit 0
		;;

	# Install our OpenZFS from the
	# above.
	openzfs-debian-derivative-install)
		ZFS_VER="`"$0" openzfs-info dir`"
		cd "$LOCALSRCDIR/openzfs/build-$ZFS_VER" || exit 1
		exec apt install --fix-missing -y ./openzfs-*.deb
		;;

	# Just complete the downloading, validation, compilation
	# and installation of OpenZFS.
	openzfs-debian-derivative-nikkei)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires INITRD_MAKER argument >&2
			exit 1
		fi
		INITRD_MAKER="$2"
		"$0" openzfs-debian-derivative-download-build "$INITRD_MAKER" || exit 1
		"$0" openzfs-debian-derivative-install || exit 1
		exit 0
		;;

	################################################# OpenZFS Direct Compile

	################################################# zfs-auto-snapshot installation

	# Unfortunately, zfs-auto-snapshot does not
	# have a tarball.
	# The nearest you can get is a github zip
	# file, but we don't know if github generates
	# it dynamically; if github generates it
	# dynamically and they change tooling, the
	# exact bytes might get changed.
	# Since we need to validate that the
	# zfs-auto-snapshot is what we expect,
	# we focus on just the biggest file, the
	# actual zfs-auto-snapshot, and embed the
	# crontab files ourselves.
	zas-info)
		case $2 in
		url)
			echo 'https://raw.githubusercontent.com/zfsonlinux/zfs-auto-snapshot/92db087bb019957166ee70c88c6c967e5fd28a70/src/zfs-auto-snapshot.sh'
			;;

		hash)
			echo '70d1974c21d50f43dd0dd768544fae42302489fb2d6e42d77973b77e15056967'
			;;

		date)
			echo '2019-09-30'
			;;

		*)
			echo "$0": unrecognized subcommand "$2" >&2
			exit 1
			;;

		esac
		exit 0
		;;

	# Download and validate the core
	# script, and generate the
	# crontab files.
	zas-download-validate)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DIR argument >&2
			exit 1
		fi
		DIR="$2"
		"$0" ensure wget || exit 1

		cd "$DIR" || exit 1

		echo '---- zfsbootmenu-installer: zfs-auto-snapshot download and validate'
		wget --no-verbose "`"$0" zas-info url`" --output-document=./zfs-auto-snapshot || exit 1
		echo "`"$0" zas-info hash`" zfs-auto-snapshot | sha256sum -c
		if test $? '!=' 0; then
			rm ./zfs-auto-snapshot
			echo "$0": Validation failed >&2
			exit 1
		fi
		chmod 755 ./zfs-auto-snapshot || exit 1

		cat > ./zfs-auto-snapshot.cron.frequent <<SCRIPT
PATH="/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

*/15 * * * * root which zfs-auto-snapshot > /dev/null || exit 0 ; zfs-auto-snapshot --quiet --syslog --label=frequent --keep=4 //
SCRIPT
		for SPEC in hourly/24 daily/31 weekly/8 monthly/12; do
			LABEL=`echo $SPEC | sed -e 's@/.*$@@'`
			KEEP=`echo $SPEC | sed -e 's@^[^/]*/@@'`
			cat > ./zfs-auto-snapshot.cron.$LABEL <<SCRIPT
#!/bin/sh

# Only call zfs-auto-snapshot if it's available
which zfs-auto-snapshot > /dev/null || exit 0

exec zfs-auto-snapshot --quiet --syslog --label=$LABEL --keep=$KEEP //
SCRIPT
			chmod 755 ./zfs-auto-snapshot.cron.$LABEL || exit 1
		done
		exit 0
		;;

	zas-typical-download-install)
		INSTALLDIR=/usr/local/lib/zfs-auto-snapshot
		"$0" mkdir-p $INSTALLDIR || exit 1
		"$0" zas-download-validate $INSTALLDIR || exit 1

		"$0" mkdir-p /usr/local/sbin || exit 1
		ln -s $INSTALLDIR/zfs-auto-snapshot /usr/local/sbin || exit 1
		chmod 755 /usr/local/sbin/zfs-auto-snapshot || exit 1

		"$0" mkdir-p /usr/local/bin || exit 1
		cat > /usr/local/bin/zfs-auto-snapshot-activate <<SCRIPT
#! /bin/sh
echo zfs-auto-snapshot-activate
mkdir -p /etc/cron.d || exit 1
ln -sf	$INSTALLDIR/zfs-auto-snapshot.cron.frequent \
	/etc/cron.d/zfs-auto-snapshot || exit 1
for LABEL in hourly daily weekly monthly; do
	mkdir -p /etc/cron.\$LABEL || exit 1
	ln -sf	$INSTALLDIR/zfs-auto-snapshot.cron.\$LABEL \
		/etc/cron.\$LABEL/zfs-auto-snapshot || exit 1
	chmod 755 /etc/cron.\$LABEL/zfs-auto-snapshot || exit 1
done
exit 0
SCRIPT
		chmod 755 /usr/local/bin/zfs-auto-snapshot-activate || exit 1

		cat > /usr/local/bin/zfs-auto-snapshot-deactivate <<SCRIPT
#! /bin/sh
echo zfs-auto-snapshot-deactivate
rm -f /etc/cron.d/zfs-auto-snapshot || exit 1
for LABEL in hourly daily weekly monthly; do
	rm -f /etc/cron.\$LABEL/zfs-auto-snapshot || exit 1
done
exit 0
SCRIPT
		chmod 755 /usr/local/bin/zfs-auto-snapshot-deactivate || exit 1

		exit 0
		;;

	# Just download, validate, install, and activate
	# zfs-auto-snapshot
	zas-typical-nikkei)
		"$0" zas-typical-download-install || exit 1
		exec /usr/local/bin/zfs-auto-snapshot-activate
		;;

	################################################# zfs-auto-snapshot installation

	################################################# ISO-squashfs Install support

	# Download an ISO and validate it
	# against a keyring embedded in
	# this script.
	# If validation succeeds, leaves
	# the file: $WORKDIR/installer.iso
	iso-download-validate)
		if test X"${6+set}" '!=' Xset; then
			echo "$0": requires KEYRING ISO_URL ISO_BASENAME SHA256_URL SHA256_SIGN_URL >&2
			exit 1
		fi
		KEYRING="$2"
		ISO_URL="$3"
		ISO_BASENAME="$4"
		SHA256_URL="$5"
		SHA256_SIGN_URL="$6"
		"$0" ensure gpg || exit 1
		"$0" ensure sha256sum || exit 1

		"$0" mkdir-p $WORKDIR/iso || exit 1
		rm -rf $WORKDIR/iso/* $WORKDIR/installer.iso > /dev/null 2>&1

		echo "---- zfsbootmenu-installer: Downloading $ISO_BASENAME..."
		wget "$ISO_URL" --output-document=$WORKDIR/iso/"$ISO_BASENAME" || exit 1
		wget --no-verbose "$SHA256_URL" --output-document=$WORKDIR/iso/sha256 || exit 1
		wget --no-verbose "$SHA256_SIGN_URL" --output-document=$WORKDIR/iso/sha256.sig || exit 1

		if test '!' -f $WORKDIR/iso/"$ISO_BASENAME" || \
				test '!' -f $WORKDIR/iso/sha256 || \
				test '!' -f $WORKDIR/iso/sha256.sig; then
			echo "$0": Downloading failed >&2
			exit 1
		fi

		echo "---- zfsbootmenu-installer: Validating $ISO_BASENAME"
		"$0" keyring "$KEYRING" || exit 1
		"$0" mkdir-p $WORKDIR/gnupg || exit 1
		chmod 700 $WORKDIR/gnupg

		gpg --keyring gnupg-ring:$WORKDIR/keyring.gpg --no-default-keyring \
			--homedir $WORKDIR/gnupg \
			--verify \
				$WORKDIR/iso/sha256.sig \
				$WORKDIR/iso/sha256
		if test $? '!=' 0; then
			echo "$0": Failed to validate signature for checksum file: $ISO_BASENAME >&2
			exit 1
		fi
		# Since we will use --ignore-missing, make
		# absolutely sure the ISO file is included
		# in the sha256 file.
		grep -F "$ISO_BASENAME" $WORKDIR/iso/sha256 > /dev/null 2>&1
		if test $? '!=' 0; then
			echo "$0": Failed to see "$ISO_BASENAME" in checksum file >&2
			exit 1
		fi
		cd $WORKDIR/iso
		cat ./sha256 | sha256sum -c --ignore-missing
		if test $? '!=' 0; then
			echo "$0": "$ISO_BASENAME" checksum validation failed >&2
			exit 1
		fi
		cd $WORKDIR

		# We are good!
		mv $WORKDIR/iso/"$ISO_BASENAME" $WORKDIR/installer.iso
		rm -rf $WORKDIR/iso $WORKDIR/gnupg $WORKDIR/keyring.gpg > /dev/null 2>&1
		echo "---- zfsbootmenu-installer: $ISO_BASENAME downloaded and valid!"

		exit 0
		;;

	# Downloads an ISO file and validates
	# it against the given hash.
	# Puts the file into $WORKDIR/installer.iso
	iso-download-validate-by-hash)
		if test X"${3+set}" '=' set; then
			echo "$0": requires URL HASH args >&2
			exit 1
		fi
		URL="$2"
		HASH="$3"
		"$0" ensure sha256sum || exit 1
		"$0" ensure wget || exit 1

		NAME="`echo "$URL" | grep -o '[^/]*$'`"

		echo "---- zfsbootmenu-installer: Downloading ISO $NAME"
		wget "$URL" --output-document=$WORKDIR/installer.iso || exit 1
		if test '!' -f $WORKDIR/installer.iso; then
			echo "$0": Download failed >&2
			exit 1
		fi
		echo "---- zfsbootmenu-installer: Validating ISO $NAME"
		cd $WORKDIR || exit 1
		echo "$HASH" installer.iso | sha256sum -c
		if test $? '!=' 0; then
			echo "$0": Validation failed >&2
			exit 1
		fi
		exit 0
		;;

	iso-mount)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO arg >&2
			exit 1
		fi
		ISO="$2"
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		exec mount -o loop "$ISO" $WORKDIR/mnt
		;;

	# Copies out files from
	# $WORKDIR/installer.iso
	# First arg is the directory inside the ISO
	# to extract from, followed by all the
	# files to extract from that directory.
	# The files are put in the directory
	# $WORKDIR/prepare
	iso-extract-from-installer)
		if test X"${3+set}" '!=' Xset; then
			echo "$0": requires SUBDIR FILE... arguments >&2
			exit 1
		fi
		if test '!' -f $WORKDIR/installer.iso; then
			echo "$0": No installer.iso >&2
			exit 1
		fi
		SUBDIR="$2"
		shift; shift
		"$0" mkdir-p $WORKDIR/prepare || exit 1

		echo "---- zfsbootmenu-installer: Extracting from installer ISO"
		"$0" iso-mount $WORKDIR/installer.iso
		for FILE in "$@"; do
			cp $WORKDIR/mnt/"$SUBDIR"/"$FILE" $WORKDIR/prepare/"$FILE"
			if test '!' -f $WORKDIR/prepare/"$FILE"; then
				umount -qnR $WORKDIR/mnt > /dev/null 2>&1
				echo "$0": Failed to get "$SUBDIR"/"$FILE" >&2
				exit 1
			fi
		done
		umount -qnR $WORKDIR/mnt > /dev/null 2>&1
		exit 0
		;;

	# Unsquashes the squashfs directly into
	# the given directory.
	iso-unsquash)
		if test X"${3+set}" '!=' Xset; then
			echo "$0": requires SUBDIR FILE... arguments >&2
			exit 1
		fi
		SQUASHFS="$2"
		DIR="$3"
		if test '!' -d "$DIR"; then
			echo "$0": Expect $DIR to be directory >&2
			exit 1
		fi
		if test '!' -f $WORKDIR/prepare/"$SQUASHFS"; then
			echo "$0": Expect $WORKDIR/prepare/"$SQUASHFS" to be file >&2
			exit 1
		fi
		# Force it since the directory
		# should exist.
		exec unsquashfs -f -d "$DIR" $WORKDIR/prepare/"$SQUASHFS"
		;;

	################################################# ISO-squashfs Install support

	################################################# Grub cmdline Linux Default

	find-grub-cmdline-linux-default-core)
		for DIR in /etc/grub.d /etc/default/grub.d; do
			cd "$DIR"
			for FILE in [0-9][0-9]_* *.cfg; do
				# Nonexistent? Maybe posix-me-harder
				# shell letting the * pass through
				# when the dir is empty.
				if test '!' -f $FILE; then
					: # skip
				else
					grep '^[ 	]*GRUB_CMDLINE_LINUX_DEFAULT[ 	]*=[ 	]*"$GRUB_CMDLINE_LINUX_DEFAULT  *[^"]*"[ 	]*$' $FILE | \
					sed -e 's@^[ 	]*GRUB_CMDLINE_LINUX_DEFAULT[ 	]*=[ 	]*"$GRUB_CMDLINE_LINUX_DEFAULT  *\([^"]*\)"[ 	]*$@\1@'
				fi
			done
		done
		;;

	find-grub-cmdline-linux-default)
		echo `"$0" find-grub-cmdline-linux-default-core`
		;;

	# Intended to be used in a package manager
	# post-install hook.
	# This changes the `org.zfsbootmenu:commandline`
	# option of the currently mounted root dataset.
	follow-grub-cmdline-linux-default)
		MY_BE="`"$0" find-current-boot-environment`"
		if test $? '!=' 0; then
			"$0" ensure logger
			logger --id=$$ --priority=user.warning 'zfsbootmenu-installer follow-grub-cmdline-linux-default: Unable to find our current boot environment'
			exit 1
		fi
		if zfs list "$MY_BE" > /dev/null 2>&1; then :; else
			"$0" ensure logger
			logger --id=$$ --priority=user.warning 'zfsbootmenu-installer follow-grub-cmdline-linux-default: Current / is not a ZFS dataset'
			exit 1
		fi
		CMDLINE="`"$0" find-grub-cmdline-linux-default`"
		SETTING='%{parent} '"$CMDLINE"
		CUR_SETTING="`zfs get -H -o value org.zfsbootmenu:commandline $MY_BE`"
		if test X"$CUR_SETTING" '!=' X"$SETTING"; then
			zfs set org.zfsbootmenu:commandline="$SETTING" "$MY_BE"
			logger --id=$$ --priority=user.debug "zfsbootmenu-installer follow-grub-cmdline-linux-default: Linux commandline for $MY_BE changed to $CMDLINE"
		fi
		exit 0
		;;

	################################################# Grub cmdline Linux Default

        ################################################# install Boot Environment

	check-distro-not-installed)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if zfs list $TANK_NAME/ROOT/"$DISTRO" > /dev/null 2>&1; then
			echo "$0": Boot environment exists: $DISTRO >&2
			echo "$0": If you want to force-reinstall it, destroy it first: >&2
			echo "$0":'     'zfs destroy -r $TANK_NAME/ZROOT/$DISTRO >&2
			exit 1
		fi
		exit 0
		;;

	# Used by AddBootEnvironment to set up
	# $WORKDIR/config from an existing
	# installation.
	prepare-work-from-existing)
		if "$0" detect-installed; then :; else
			echo "$0": not on an existing zfsbootmenu-installer system >&2
			exit 1
		fi
		"$0" mkdir-p ${WORKDIR}/config || exit 1
		rm -rf ${WORKDIR}/config/* > /dev/null 2>&1
		for FILE in /etc/hostid /etc/hostname /etc/zfs/zroot.key \
				 /usr/local/mok /usr/local/username
		do
			DSTFILE=`echo "$FILE" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
			echo $DSTFILE
			cp -R --reflink=auto $FILE ${WORKDIR}/config
			if test '!' -e ${WORKDIR}/config/$DSTFILE; then
				echo "$0": Failed to copy $FILE into workdir? >&2
				exit 1
			fi
		done
		exit 0
		;;

	# Introduce our config into the target.
	copy-config-to-new-distro)
		"$0" mkdir-p $WORKDIR/mnt/etc/zfs || exit 1
		"$0" mkdir-p $WORKDIR/mnt/usr/local/bin || exit 1
		"$0" mkdir-p $WORKDIR/mnt/usr/local/mok || exit 1

		# Juggle files that might already exist in the
		# mounted dir.
		# We need to do this because some ISO-squashfs
		# LiveCDs that we use might include these as
		# symlinks to absolute paths.
		# Because the symlinks are absolute paths, they
		# will not exist on the hosting system, and they
		# will be broken symlinks, which will cause
		# cp to balk at overwriting them.
		rm -rf $WORKDIR/mnt/etc/hostid > /dev/null 2>&1
		rm -rf $WORKDIR/mnt/etc/hostname > /dev/null 2>&1
		rm -rf $WORKDIR/mnt/etc/zfs/zroot.key > /dev/null 2>&1
		# Move this out of the way at this point; we will
		# restore it later.
		# mv works on broken symlinks.
		mv $WORKDIR/mnt/etc/resolv.conf $WORKDIR/mnt/etc/resolv.conf.bak > /dev/null 2>&1

		# Proper OSs would not put anything in /usr/local
		# so no need to juggle files there.

		cp $WORKDIR/config/hostid $WORKDIR/mnt/etc/hostid && \
		cp $WORKDIR/config/hostname $WORKDIR/mnt/etc/hostname && \
		cp $WORKDIR/config/zroot.key $WORKDIR/mnt/etc/zfs/zroot.key && \
		cp $WORKDIR/config/mok/MOK.priv $WORKDIR/mnt/usr/local/mok/MOK.priv && \
		cp $WORKDIR/config/mok/MOK.der $WORKDIR/mnt/usr/local/mok/MOK.der && \
		cp $WORKDIR/config/mok/MOK.pem $WORKDIR/mnt/usr/local/mok/MOK.pem && \
		cp $WORKDIR/config/username $WORKDIR/mnt/usr/local/username && \
		cp "$0" $WORKDIR/mnt/usr/local/bin/zfsbootmenu-installer && \
		cp /etc/resolv.conf $WORKDIR/mnt/etc/resolv.conf
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to copy into new distro >&2
			exit $EXIT_CODE
		fi
		# Add hostname to hosts.
		printf '127.0.0.1 ' >> $WORKDIR/mnt/etc/hosts
		cat $WORKDIR/config/hostname >> $WORKDIR/mnt/etc/hosts
		echo >> $WORKDIR/mnt/etc/hosts
		# Make sure all the permissions are aight
		chmod 644 $WORKDIR/mnt/etc/hostid $WORKDIR/mnt/etc/hostname $WORKDIR/mnt/etc/hosts \
			$WORKDIR/mnt/usr/local/mok/MOK.der $WORKDIR/mnt/usr/local/mok/MOK.pem \
			$WORKDIR/mnt/usr/local/username && \
		chmod 000 $WORKDIR/mnt/etc/zfs/zroot.key && \
		chmod 600 $WORKDIR/mnt/usr/local/mok/MOK.priv && \
		chmod 755 $WORKDIR/mnt/usr/local/bin/zfsbootmenu-installer && \
		chmod 777 $WORKDIR/mnt/etc/resolv.conf
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to chmod files in new distro >&2
			exit $EXIT_CODE
		fi
		exit 0
		;;

	# Mount the special devices into new distro.
	mount-magic-to-new-distro)
		mount --make-rslave -t proc proc $WORKDIR/mnt/proc && \
		mount --make-rslave -t sysfs sys $WORKDIR/mnt/sys && \
		mount --make-rslave -B /dev $WORKDIR/mnt/dev && \
		mount --make-rslave -t devpts pts $WORKDIR/mnt/dev/pts
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed to mount magic devices in new distro >&2
			exit $EXIT_CODE
		fi
		exit 0
		;;

	# Install the given DISTRO into a new
	# $TANK_NAME/ROOT/$DISTRO dataset,
	# taking files from $WORKDIR/config
	# This does not clean up the workdir,
	# and does not unmount the dataset
	# or change its mountpoint.
	install-distro-core)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if "$0" distro check "$DISTRO"; then :; else
			echo "$0": Unknown DISTRO: $DISTRO >&2
			exit 1
		fi
		"$0" check-distro-not-installed "$DISTRO" || exit 1
		echo "---- zfsbootmenu-installer: Preparing to install '$DISTRO'."
		"$0" mkdir-p $WORKDIR/prepare && \
		"$0" distro pre-install "$DISTRO"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Installation preparation failed. >&2
			exit $EXIT_CODE
		fi
		echo "---- zfsbootmenu-installer: Initial install."
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		zfs create -o mountpoint=$WORKDIR/mnt -o canmount=noauto \
			$TANK_NAME/ROOT/"$DISTRO" && \
		zfs mount $TANK_NAME/ROOT/"$DISTRO" && \
		"$0" distro install-outside "$DISTRO" $WORKDIR/mnt
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Initial installation failed. >&2
			exit $EXIT_CODE
		fi
		"$0" copy-config-to-new-distro || exit 1
		"$0" mount-magic-to-new-distro || exit 1
		echo "---- zfsbootmenu-installer: Chroot install."
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer \
				distro install-chroot "$DISTRO"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Chroot installation failed. >&2
			exit $EXIT_CODE
		fi
		# Do a final signing of any kernels, in case
		# the installation process screwed up the
		# ordering.
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer sign-all-kernels
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Final kernel signing failed. >&2
			exit $EXIT_CODE
		fi
		# Disable log compression: ZFS already
		# compresses them.
		echo "---- zfsbootmenu-installer: Disable log compression if possible (best effort)"
		chroot $WORKDIR/mnt \
			/usr/local/bin/zfsbootmenu-installer typical-no-compress-logs || exit 1

		# Restore /etc/resolv.conf if there
		# was a backup.
		mv $WORKDIR/mnt/etc/resolv.conf.bak $WORKDIR/mnt/etc/resolv.conf > /dev/null 2>&1

		exit 0
		;;

	# Wrapper function for install-distro-core or
	# install-fromiso-core.
	# Cleans up the work directory if there is
	# a failure and destroys the created dataset.
	install-distro-or-fromiso)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISTRO argument >&2
			exit 1
		fi
		DISTRO="$2"
		if test -f "$DISTRO"; then
			"$0" install-fromiso-ask-be "$DISTRO"
			if test $? '!=' 0; then
				echo '---- zfsbootmenu-installer: install FromISO: Cancelled'
				exit 0
			fi
			BE="`cat $WORKDIR/config/be`"
		else
			if "$0" distro check "$DISTRO"; then :; else
				echo "$0": Unknown DISTRO: $DISTRO >&2
				exit 1
			fi
			"$0" check-distro-not-installed "$DISTRO" || exit 1
			BE="$DISTRO"
		fi
		if test '!' -d $WORKDIR/config; then
			echo "$0": requires $WORKDIR/config >&2
			exit 1
		fi
		if test -f "$DISTRO"; then
			"$0" install-fromiso-core "$DISTRO" "$BE"
		else
			"$0" install-distro-core "$DISTRO"
		fi
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			# Clean up.
			echo "$0": Install "$DISTRO" failed, destroying. >&2
			umount -qnR $WORKDIR/mnt
			if zfs list $TANK_NAME/ROOT/"$BE" > /dev/null 2>&1; then
				zfs destroy -r $TANK_NAME/ROOT/"$BE" > /dev/null 2>&1
			fi
			exit $EXIT_CODE
		fi
		umount -qnR $WORKDIR/mnt
		zfs set mountpoint=/ $TANK_NAME/ROOT/"$BE"
		zfs set org.zfsbootmenu:active=on $TANK_NAME/ROOT/"$BE"
		sync
		echo "---- zfsbootmenu-installer: Enabled '$BE' Boot Environment."
		exit 0
		;;

        ################################################# install Boot Environment

	clean-up-work)
		umount -qnR $WORKDIR/mnt > /dev/null 2>&1
		umount -qnR $WORKDIR > /dev/null 2>&1
		rm -rf $WORKDIR > /dev/null 2>&1
		exit 0
		;;

	sign-all-kernels)
		"$0" ensure sbsign || exit 1
		"$0" ensure sbverify || exit 1
		cd /boot
		for KERNEL in vmlinuz* vmlinux* linux* linuz* kernel*;
		do
			# POSIX specifies that globs that
			# match nothing will be passed
			# through.
			# If the file doesn't exist, it is
			# a glob that didn't match and we
			# should skip it.
			if test '!' -e "$KERNEL"; then
				# skip
				:
			# skip symbolic links
			elif test -L "$KERNEL"; then
				:
			# skip already-signed
			elif sbverify --cert /usr/local/mok/MOK.pem "$KERNEL" > /dev/null 2>&1; then
				:
			else
				echo "---- zfsbootmenu-installer: Sign /boot/$KERNEL"
				if sbsign --key /usr/local/mok/MOK.priv --cert /usr/local/mok/MOK.pem "$KERNEL" --output "$KERNEL";
				then
					:
				else
					echo "$0": Failed to sign /boot/$KERNEL >&2
					exit 1
				fi
			fi
		done
		exit 0
		;;

	select-vdev)
		printf 'single\nmirror\nraidz1\nraidz2\nraidz3\n' | fzf --layout=reverse-list --no-sort --border --border-label='Select ZFS Pool Type' --preview="$0"' preview-vdev {}'
		exit 0
		;;

	preview-vdev)
		case $2 in
			single)
				cat <<DESC
Create a pool with just one disk.
You can expand this later to 'mirror' with 'zpool attach'.
DESC
				;;

			mirror)
				cat <<DESC
Create a pool with 2 or 3 disks which can tolerate the
loss of all but one disk, i.e. RAID1.
You can expand this later with more mirrored disks with
'zpool attach', or expand to a RAID10 by adding another
mirror with 'zpool add ${TANK_NAME} mirror'.
DESC
				;;

			raidz1)
				cat <<DESC
Create a pool with 3 or more disks, which can tolerate
the loss of up to one disk, i.e. RAID5.
DESC
				;;

			raidz2)
				cat <<DESC
Create a pool with 4 or more disks, which can tolerate
the loss of up to two disks, i.e. RAID6.
DESC
				;;

			raidz3)
				cat <<DESC
Create a pool with 5 or more disks, which can tolerate
the loss of up to three disks.
DESC
				;;

			*)
				echo "$0": Unknown vdev type: $2 >&2
				exit 1
				;;

		esac
		exit 0
		;;

	select-disks)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires REASON DANGER arguments >&2
			exit 1
		fi
		REASON="$2"
		DANGER="$3"
		"$0" lsdisk |  fzf --layout=reverse-list --border --multi --border-label='Select disks '"$REASON" --preview="$0"' preview-disk {} '"$DANGER"
		exit 0
		;;

	lsdisk)
		"$0" ensure lsblk > /dev/null 2>&1
		lsblk -e 7 -o PATH,TYPE -nPd | grep '"disk"$'  | sed -e 's/^PATH="//' -e 's/".*$//'
		exit 0
		;;

	describe-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure lsblk > /dev/null 2>&1
		echo 'Disk: ' $DISK
		printf 'Model: '; lsblk -nd -o MODEL $DISK
		printf 'Serial: '; lsblk -nd -o SERIAL $DISK
		printf 'Size: '; lsblk -nd -o SIZE $DISK
		printf 'Connection: '; lsblk -nd -o TRAN $DISK
		exit 0
		;;

	preview-disk)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires DISK DANGER arguments >&2
			exit 1
		fi
		DISK="$2"
		DANGER="$3"
		"$0" describe-disk "$DISK"
		cat <<HELP

Press [tab] to select/deselect, [enter] to finish selection
Press [esc] twice to abort
HELP
		if test X"$DANGER" '=' Xyes; then
			cat <<DANGER

SELECTED DISKS WILL BE FORMATTED AND LOSE ALL THEIR DATA.
DANGER
		fi
		exit 0
		;;

	# Check if the given vdev option in $2 has
	# the correct number of disks in $3... onwards
	# Exit code 0 if OK, non-zero otherwise.
	check-vdev-num-disks)
		VDEV=$2
		shift
		shift
		case $VDEV in
			single)
				if test $# -eq 1; then
					:
				else
					echo "$0": "'"single"'" pool requires exactly one disk >&2
					exit 1
				fi
				;;

			mirror)
				if test $# -eq 2 || test $# -eq 3; then
					:
				else
					echo "$0": "'"mirror"'" pool requires two or three disks >&2
					exit 1
				fi
				;;

			raidz1)
				if test $# -ge 3; then
					:
				else
					echo "$0": "'"raidz1"'" pool requires at least three disks >&2
					exit 1
				fi
				;;

			raidz2)
				if test $# -ge 4; then
					:
				else
					echo "$0": "'"raidz2"'" pool requires at least four disks >&2
					exit 1
				fi
				;;

			raidz3)
				if test $# -ge 5; then
					:
				else
					echo "$0": "'"raidz3"'" pool requires at least five disks >&2
					exit 1
				fi
				;;

			*)
				echo "$0": Unrecognized vdev type: $VDEV >&2
				exit 1
				;;
		esac
		exit 0
		;;

	# Ask user to select a vdev pool option,
	# and disks to put in it.
	select-vdev-disks)
		VDEV=`"$0" select-vdev`
		# Did user cancel?
		if "$0" preview-vdev "$VDEV" > /dev/null 2>&1; then
			:
		else
			exit 1
		fi
		# Assumes device paths don't have spaces T.T
		DISKS="`"$0" select-disks "to install in '$VDEV'" yes`"
		if "$0" check-vdev-num-disks $VDEV $DISKS; then
			:
		else
			exit 1
		fi
		echo $VDEV $DISKS
		exit 0
		;;

	################################################# Initialize Interview

	# The part of Initialize where it
	# asks what the user wants.
	initialize-interview)
		"$0" mkdir-p $WORKDIR/config || exit 1
		"$0" ensure cracklib-check || exit 1
		"$0" ensure grep || exit 1
		"$0" ensure whiptail || exit 1

		"$0" initialize-interview-hostname && \
		"$0" initialize-interview-username && \
		"$0" initialize-interview-password
		if test $? '!=' 0; then
			exit 1
		fi

		"$0" select-vdev-disks > $WORKDIR/config/vdev_disks
		if test $? '!=' 0; then
			exit 1
		fi
		"$0" select-distro > $WORKDIR/config/distro
		if test -f "`cat $WORKDIR/config/distro`"; then
			# ISO
			:
		elif "$0" distro check "`cat $WORKDIR/config/distro`"; then
			:
		else
			exit 1
		fi

		"$0" initialize-prepare-vdev-disks
		"$0" initialize-interview-to-confirm

		exit 0
		;;

	initialize-interview-hostname)
		whiptail --inputbox 'Enter machine name (hostname)' 0 0 2> $WORKDIR/config/hostname
		if test $? '!=' 0; then
			exit 1
		fi
		if grep '^[A-Za-z0-9][-A-Za-z0-9_.]*$' $WORKDIR/config/hostname > /dev/null 2>&1; then :; else
			whiptail --msgbox 'Machine name must start with basic Latin letter or digit, and cannot be empty.

Beyond the first character, you can also use . - _
Spaces are not allowed.' 0 0
			exec "$0" initialize-interview-hostname
		fi
		exit 0
		;;

	initialize-interview-username)
		whiptail --inputbox 'Enter user name' 0 0 2> $WORKDIR/config/username
		if test $? '!=' 0; then
			exit 1
		fi
		if grep '^[A-Za-z0-9][-A-Za-z0-9_.]*$' $WORKDIR/config/username > /dev/null 2>&1; then :; else
			whiptail --msgbox 'User name must start with basic Latin letter or digit, and cannot be empty.
It is not your real name.

Beyond the first character, you can also use . - _
Spaces are not allowed.' 0 0
			exec "$0" initialize-interview-username
		fi
		exit 0
		;;

	initialize-interview-password)
		whiptail --title 'Create your password' --passwordbox 'XXXXXXXXXXXXXXXXXXX' 0 0 '' 2> $WORKDIR/config/zroot.key
		if test $? '!=' 0; then
			exit 1
		fi

		# ZFS requires at least 8 bytes
		LEN=`cat $WORKDIR/config/zroot.key | wc --bytes`
		if test $LEN -lt 8; then
			whiptail --msgbox 'Password must be at least 8 characters!' 0 0
			exec "$0" initialize-interview-password
		fi

		# Check against cracklib, otherwise PAM pam_unix will
		# complain later in the actual installation.
		cat $WORKDIR/config/zroot.key | cracklib-check > $WORKDIR/config/cracklib-whine
		if grep ': OK$' $WORKDIR/config/cracklib-whine > /dev/null 2>&1; then :; else
			# Not OK.
			COMPLAINT="`cat $WORKDIR/config/cracklib-whine | grep -o ':[^:]*$'`"
			rm -rf $WORKDIR/config/cracklib-whine > /dev/null 2>&1
			whiptail --msgbox 'Password insecure'"$COMPLAINT" 0 0
			exec "$0" initialize-interview-password
		fi
		rm -rf $WORKDIR/config/cracklib-whine > /dev/null 2>&1

		whiptail --title 'Re-enter same password' --passwordbox "XXXXXXXXXXXXXXXXXXX" 0 0 '' 2> $WORKDIR/config/zroot2.key
		if test $? '!=' 0; then
			exit 1
		fi
		if cmp -s $WORKDIR/config/zroot.key $WORKDIR/config/zroot2.key; then :; else
			whiptail --msgbox 'Passwords do not match!
Please try again.' 0 0
			exec "$0" initialize-interview-password
		fi
		rm $WORKDIR/config/zroot2.key
		# whiptail on my system doesn't add a newline.
		echo >> $WORKDIR/config/zroot.key
		exit 0
		;;

	# Create a to-confirm file from the
	# data we gathered in `initialize-interview`
	initialize-interview-to-confirm)
		rm -rf $WORKDIR/to-confirm > /dev/null 2>&1
		echo hostname:  "`cat $WORKDIR/config/hostname`" >> $WORKDIR/to-confirm
		echo username:  "`cat $WORKDIR/config/username`" >> $WORKDIR/to-confirm
		echo distro: "`cat $WORKDIR/config/distro`" >> $WORKDIR/to-confirm

		IS_VDEV_FLAG=yes
		for WORD in `cat $WORKDIR/config/vdev_disks`; do
			if test $IS_VDEV_FLAG '=' yes; then
				echo 'zpool:' "$WORD" >> $WORKDIR/to-confirm
				echo >> $WORKDIR/to-confirm
				echo ANY DATA ON THESE DISKS WILL BE DESTROYED. >> $WORKDIR/to-confirm

				IS_VDEV_FLAG=no
			else
				echo >> $WORKDIR/to-confirm
				"$0" describe-disk "$WORD" >> $WORKDIR/to-confirm
			fi
		done
		exit 0
		;;

	# Split the vdev_disks file into
	# vdev and disks, and convert every
	# disk into by-id
	initialize-prepare-vdev-disks)
		rm -rf $WORKDIR/config/vdev $WORKDIR/config/disks > /dev/null 2>&1
		IS_VDEV_FLAG=yes
		for WORD in `cat $WORKDIR/config/vdev_disks`; do
			if test $IS_VDEV_FLAG '=' yes; then
				echo $WORD > $WORKDIR/config/vdev
				IS_VDEV_FLAG=no
			else
				"$0" get-disk-id "$WORD" >> $WORKDIR/config/disks
			fi
		done
		exit 0
		;;

	################################################# Initialize Interview

	################################################# Initialize Processing

	initialize-processing)
		echo "---- zfsbootmenu-installer: Initialize: Begin."
		# See: https://github.com/zbm-dev/zfsbootmenu/discussions/465
		zgenhostid -f 0x00bab10c
		cp /etc/hostid $WORKDIR/config/hostid
		"$0" create-mok-inner "`cat $WORKDIR/config/hostname`" $WORKDIR/config/mok && \
		"$0" initialize-submit-mok && \
		"$0" prepare-esp-in-work && \
		"$0" initialize-format-disks && \
		"$0" initialize-find-parts
		if test $? '!=' 0; then
			exit 1
		fi
		DISTRO="`cat $WORKDIR/config/distro`"
		"$0" initialize-zpool-create || exit 1

		# It's likely this is a Live environment,
		# where the rootfs is an `overlayfs` in
		# memory.
		# In that case, we can't afford to download
		# an .iso and extract the .squashfs, since
		# that ends up in memory, which would cause
		# problems.
		# What we do is create a temporary dataset
		# to host $WORKDIR, so that the download is
		# stored on the installation disk.
		# Also, delete $WORKDIR/esp
		rm -rf $WORKDIR/esp > /dev/null 2>&1

		# Move $WORKDIR/config out, create temp
		# dataset.
		mv $WORKDIR/config /work-config || exit 1
		rm -rf $WORKDIR/* > /dev/null 2>&1
		zfs create -o mountpoint=$WORKDIR -o canmount=on $TANK_NAME/tmp || exit 1
		# Put back $WORKDIR/config
		mv /work-config $WORKDIR/config || exit 1

		# Is it an ISO?
		if test -f "$DISTRO"; then
			BE="`"$0" install-fromiso-infer-be "$DISTRO"`"
			if test $? '!=' 0; then
				exit $?
			fi
			"$0" install-fromiso-core "$DISTRO" "$BE" || exit 1
		else
			BE="$DISTRO"
			"$0" install-distro-core "$DISTRO" || exit 1
		fi
		umount -qnR $WORKDIR/mnt
		umount -qnR $WORKDIR > /dev/null 2>&1

		# Destroy temporary dataset.
		zfs destroy -rf $TANK_NAME/tmp

		zfs set mountpoint=/ $TANK_NAME/ROOT/"$BE"
		zfs set org.zfsbootmenu:active=on $TANK_NAME/ROOT/"$BE"
		zpool set bootfs=$TANK_NAME/ROOT/"$BE" $TANK_NAME
		sync
		zpool export $TANK_NAME
		sync
		sleep 1
		udevadm trigger
		echo "---- zfsbootmenu-installer: Installed '$BE' into $TANK_NAME"
		cat <<MSG

Congratulations, installation has completed!

NOTE!

When you next restart your new system, the
"MOK Management" interface will appear.

You can then "Enrol MOK" there.
Select that, then "Continue" and enter your password.

This registers your Machine Operator Key (MOK) so
you can run bootloaders, kernels, and kernel modules
that you install, while the machine has Secure Boot
enabled.

You can also "Enroll key from disk" and search for
"MOK.cer", which is a certificate of your Machine
Operator Key.

When booting, you will be asked to
"Enter passphrase for 'zroot'".
This is where you enter your password.
The password will not be displayed, not even as
asterisks, but it will be checked, just type it in
and trust it.
MSG
		exit 0
		;;

	initialize-submit-mok)
		"$0" ensure mokutil || exit 1
		# pipe the password in.
		cat $WORKDIR/config/zroot.key $WORKDIR/config/zroot.key | \
		mokutil --import $WORKDIR/config/mok/MOK.der > /dev/null
		exit $?
		;;

	initialize-format-disks)
		exec "$0" format-disks `cat $WORKDIR/config/disks`
		;;

	# Find the partition names that we will put
	# into the pool, and load $WORKDIR/config/parts
	# We always set the ZFS pool member as the
	# second partition of the disk.
	initialize-find-parts)
		echo "---- zfsbootmenu-installer: Initialize: Preparing parts file."
		"$0" ensure lsblk || exit 1
		rm -rf $WORKDIR/config/parts > /dev/null 2>&1
		for DISK in `cat $WORKDIR/config/disks`; do
			"$0" initialize-find-part-try \
				"$DISK"-part2 \
				"$DISK"p2 \
				"$DISK"2 >> $WORKDIR/config/parts
			if test $? '!=' 0; then
				echo "$0": Unable to find parttion 2 of $DISK >&2
				exit 1
			fi
		done
		exit 0
		;;

	# This iterates over each of its arguments,
	# printing the first argument it finds that
	# is a block device that is a partition.
	initialize-find-part-try)
		if test X${2+set} '!=' Xset; then
			# out of arguments.
			exit 1
		fi
		shift
		TRY_PART="$1"
		lsblk -o TYPE -nd "$TRY_PART" > $WORKDIR/thing-type
		if test $? '=' 0; then
			# is some kind of block device,
			# but is it a 'part'?
			if test "`cat $WORKDIR/thing-type`" '=' "part"; then
				rm -rf $WORKDIR/thing-type > /dev/null 2>&1
				echo "$TRY_PART"
				# found it, stop processing.
				exit 0
			fi
		fi
		rm -rf $WORKDIR/thing-type > /dev/null 2&1

		# Above check failed, move to next.
		shift
		# Some shells might make "$@" into
		# "" if there are no more arguments.
		if test X${1+set} '!=' Xset; then
			# out of arguments.
			exit 1
		fi
		# tail call optimization considered awesome
		exec "$0" initialize-find-part-try "$@"
		;;

	initialize-zpool-create)
		"$0" ensure whiptail || exit 1
		whiptail --msgbox 'About to create ZFS Pool.

On some Live CD environments, a pop-up may appear,
telling you that something went wrong with the system.

It is benign and you can ignore it.
Installation will continue successfully regardless.
' 0 0
		# Put the zroot.key in the expected place.
		"$0" mkdir-p /etc/zfs || exit 1
		cp $WORKDIR/config/zroot.key /etc/zfs/zroot.key
		chmod 000 /etc/zfs/zroot.key
		if test "`cat $WORKDIR/config/vdev`" '=' single; then
			zpool create -f \
				-o ashift=12 \
				-O compression=lz4 \
				-O acltype=posixacl \
				-O xattr=sa \
				-O relatime=on \
				-O encryption=aes-256-gcm \
				-O keylocation=file:///etc/zfs/zroot.key \
				-O keyformat=passphrase \
				-O org.zfsbootmenu:commandline='quiet splash' \
				-o autotrim=on \
				-o compatibility=openzfs-2.3 \
				-m none $TANK_NAME \
				`cat $WORKDIR/config/parts`
			EXIT_CODE=$?
		else
			zpool create -f \
				-o ashift=12 \
				-O compression=lz4 \
				-O acltype=posixacl \
				-O xattr=sa \
				-O relatime=on \
				-O encryption=aes-256-gcm \
				-O keylocation=file:///etc/zfs/zroot.key \
				-O keyformat=passphrase \
				-O org.zfsbootmenu:commandline='quiet splash' \
				-o autotrim=on \
				-o compatibility=openzfs-2.3 \
				-m none $TANK_NAME \
				`cat $WORKDIR/config/vdev` \
				`cat $WORKDIR/config/parts`
			EXIT_CODE=$?
		fi
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Unable to create ZFS Pool >&2
			exit 1
		fi
		sync
		zfs load-key -L file://$WORKDIR/config/zroot.key "$TANK_NAME" > /dev/null 2>&1
		zfs create -o mountpoint=none "$TANK_NAME"/ROOT
		# Create the home directory with canmount=noauto
		# at first.
		# If we create it canmount=on here (the default)
		# the dataset will be mounted now, but this is
		# executing within the Live environment and
		# replace the /home of the Live environment.
		# If the user downloaded zfsbootmenu-installer
		# to /home, it would get lost.
		# Instead, we keep `canmount=noauto` to prevent
		# it from being mounted NOW.
		# We instead do the `canmount=on` setting inside
		# the `chroot` jail, where the `/home` would be
		# truly empty.
		zfs create -o mountpoint=/home -o canmount=noauto "$TANK_NAME"/home
		echo "---- zfsbootmenu-installer: Created ZFS Pool."
		udevadm trigger
		sync
		exit 0
		;;

	################################################# Initialize Processing

	################################################# Confirmation

	confirm)
		if test '!' -f $WORKDIR/to-confirm; then
			echo "$0": need to-confirm file in wokrdir >&2
			exit 1
		fi
		SEL=`printf 'No\nYes\n' | fzf --layout=reverse-list --no-sort --border --border-label='ARE YOU SURE?' --preview="$0"' preview-confirm'`
		rm $WORKDIR/to-confirm > /dev/null 2>&1
		if test X"$SEL" '=' XYes; then
			exit 0
		else
			exit 1
		fi
		;;

	preview-confirm)
		cat $WORKDIR/to-confirm
		;;

	################################################# Confirmation

        ################################################# ESP search

	lsdisk-with-esp)
		for DISK in `"$0" lsdisk`; do
			if "$0" disk-has-esp $DISK; then
				echo $DISK
			fi
		done
		exit 0
		;;

	disk-has-esp)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK=$2
		"$0" ensure lsblk
		if lsblk -o NAME "$DISK" > /dev/null 2>&1; then :; else
			# not a disk
			exit 1
		fi
		if test X"`lsblk -e 7 -o PARTTYPENAME $DISK -n | grep 'EFI System'`" '=' X; then
			exit 1
		else
			exit 0
		fi
		;;

	get-disk-esp)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		DISK=$2
		lsblk -e 7 -o PATH,PARTTYPENAME -nP "$DISK" | grep '"EFI System"$' | sed -e 's/^PATH="//' -e 's/".*$//'
		exit 0
		;;

	select-disk-reflash-esp)
		"$0" lsdisk-with-esp | fzf --layout=reverse-list --border --border-label='Select disk to Reflash ESP' --preview="$0"' preview-disk {} no'
		exit 0
		;;

        ################################################# ESP search

        ################################################# ESP flashing

	# Needs $WORKDIR/esp
	flash-esp-from-work)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires DISK argument >&2
			exit 1
		fi
		if test '!' -d $WORKDIR/esp; then
			echo "$0": no prepared ESP in workdir >&2
			exit 1
		fi
		DISK=$2
		ESP=`"$0" get-disk-esp "$DISK"`
		echo "---- zfsbootmenu-installer: Flashing ESP: $DISK"
		"$0" ensure rsync || exit 1
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		mount -t vfat "$ESP" $WORKDIR/mnt || exit 1
		# The `/` after `/esp` is significant!
		rsync -r $WORKDIR/esp/ $WORKDIR/mnt

		sync
		sleep 1
		umount -qnR $WORKDIR/mnt

		echo "---- zfsbootmenu-installer: ESP flashed: $DISK"
		exit 0
		;;

        ################################################# ESP flashing

        ################################################# Disk ID

	# Given a /dev/sdfoo or /dev/hdfoo or /dev/nvmefoo,
	# get the path from /dev/disk/by-id/foo
	get-disk-id)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure readlink || exit 1
		:
		NAME=`echo "$DISK" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
		for ID in /dev/disk/by-id/*; do
			if test -L "$ID"; then
				DEST=`readlink -e "$ID" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
				if test X"$DEST" '=' X"$NAME"; then
					echo "$ID"
					exit 0
				fi
			fi
		done
		echo "$DISK"
		exit 1
		;;

        ################################################# Disk ID

        ################################################# Disk formatting

	erase-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure blkdiscard
		"$0" ensure sgdisk
		"$0" ensure wipefs
		"$0" ensure udevadm

		wipefs -a "$DISK" || exit $?

		blkdiscard -f "$DISK"
		EXIT_CODE=$?
		# 0 = okay, 2 = device doesn't support TRIM
		# everything else, we treat as error.
		if test $EXIT_CODE '=' 0 -o $EXIT_CODE '=' 2; then :; else
			exit $EXIT_CODE
		fi

		sgdisk ---zap-all "$DISK" || exit $?
		sync
		sleep 1
		udevadm trigger

		exit 0
		;;

	partition-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		DISK="$2"
		"$0" ensure mkfs.vfat
		"$0" ensure sgdisk
		"$0" ensure udevadm

		# 1:1m:+512m - Create Partition 1 starting at
		# absolute offset 1Mbyte, and end it +512Mbytes
		# later.
		# 2:0:0 - Create Partition 2 starting at
		# the remaining space (the first "0") and go
		# all the way until you reach the end (the
		# second "0").
		# EFI System Partition: ef00
		# Solaris Root: bf00
		sgdisk -n "1:1m:+512m" -t "1:ef00" \
			-n "2:0:0" -t "2:bf00" "$DISK"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		sync
		sleep 1
		udevadm trigger

		DISK_BY_ID="`"$0" get-disk-id "$DISK"`"
		BOOT_PART="$DISK_BY_ID"-part1
		if test '!' -e "$BOOT_PART"; then
			echo "$0": Could not find partition 1 of $DISK: $BOOT_PART >&2
			exit 1
		fi
		mkfs.vfat -v -F32 "$BOOT_PART"
		EXIT_CODE=$?
		if test $EXIT_CODE '!=' 0; then
			exit $EXIT_CODE
		fi

		sync
		sleep 1

		exit 0
		;;

	format-disk)
		if test X${2+set} '!=' Xset; then
			echo "$0": require DISK argument >&2
			exit 1
		fi
		if test '!' -d $WORKDIR/esp; then
			echo "$0": no prepared ESP in workdir >&2
			exit 1
		fi
		DISK="$2"
		echo "---- zfsbootmenu-installer: Formatting: $DISK"
		"$0" erase-disk "$DISK" && \
		"$0" partition-disk "$DISK" && \
		"$0" flash-esp-from-work "$DISK"
		exit $?
		;;

	format-disks)
		shift
		for DISK in "$@"; do
			if "$0" format-disk "$DISK"; then :; else
				exit 1
			fi
		done
		echo "---- zfsbootmenu-installer: Formatting completed."
		exit 0
		;;

        ################################################# Disk formatting

	################################################# Boot Environment

	list-boot-environments)
		# List the bootfs first if it is a valid
		# dataset.
		BOOTFS="`zpool get bootfs -o value -H $TANK_NAME`"
		if zfs list "$BOOTFS" > /dev/null 2>&1; then
			echo "$BOOTFS"
		fi
		BOOTFS_NAME=`echo "$BOOTFS" | sed -e 's@\([^/]*\)$@ \1@' | sed -e 's@^[^ ]* @@'`
		# Otherwise sort alphabetically and filter
		# out the base $TANK_NAME/ROOT dataset.
		zfs list -s name -t filesystem -H -d 1 -o name $TANK_NAME/ROOT | \
			sed -e '/^'"$TANK_NAME"'\/ROOT\/'"$BOOTFS_NAME"'$/ d' | \
			sed -e '/^'"$TANK_NAME"'\/ROOT$/ d'
		exit 0
		;;

	preview-boot-environment)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires BE argument >&2
			exit 1
		fi
		BE="$2"
		echo $BE; echo
		printf 'Created: '; zfs get -H -o value creation "$BE"
		printf 'Used: '; zfs get -H -o value used "$BE"
		if test X"`zpool get -H -o value bootfs $TANK_NAME`" '=' X"$BE"; then
			echo
			echo This is the current default Boot Environment.
		fi
		if test X"`zfs get -H -o value mounted "$BE"`" '=' Xyes; then
			echo
			echo You are running in this Boot Environment.
		fi
		exit 0
		;;

	select-boot-environment)
		if test X${2+set} '!=' Xset; then
			echo "$0": requires REASON argument >&2
			exit 1
		fi
		REASON=$2
		"$0" list-boot-environments | fzf --layout=reverse-list --no-sort --border --border-label='Select Boot Environment '"$REASON" --preview="$0"' preview-boot-environment {}'
		exit 0
		;;

	# Determine which boot environment is the
	# currently booted one.
	find-current-boot-environment)
		"$0" ensure df
		"$0" ensure tail
		# The nice thing about using
		# df here is that it works even
		# in a chroot jail.
		df --output=source / | tail -n 1
		exit $?
		;;

	################################################# Boot Environment

	################################################# Browse for ISO

	select-iso)
		if test X${2+set} '!=' Xset; then
			CURPATH="`pwd`"
		else
			CURPATH="$2"
		fi
		if echo "$CURPATH" | grep '^/' > /dev/null 2>&1; then :; else
			echo "$0": CURPATH must begin with /: "$CURPATH" >&2
			exit 1
		fi
		DIR="$CURPATH"

		"$0" ensure file

		SEL=`ls "$DIR" | \
		"$0" select-iso-filter "$CURPATH" | \
		fzf --layout=reverse-list --no-sort --border --border-label="$DIR" --preview="$0"' preview-iso "'"$CURPATH"'" {}'`
		if test X"$SEL" '=' X; then
			exit 1
		elif test X"$SEL" '=' 'X..'; then
			PARENT="`echo "$CURPATH" | sed -e 's@/[^/]*$@@'`"
			if test X"$PARENT" '=' 'X'; then
				PARENT=/
			fi
			exec "$0" select-iso "$PARENT"
		elif test -d "$CURPATH/$SEL"; then
			if test X"$CURPATH" '=' 'X/'; then
				exec "$0" select-iso "$CURPATH$SEL"
			else
				exec "$0" select-iso "$CURPATH/$SEL"
			fi
		fi
		echo "$CURPATH/$SEL"
		exit 0
		;;

	preview-iso)
		if test X${3+set} '!=' Xset; then
			echo "$0": requires CURPATH ITEM arg >&2
			exit 1
		fi
		CURPATH="$2"
		ITEM="$3"
		if test X"$ITEM" '=' 'X..'; then
			echo Go to parent directory
		elif test -d "$CURPATH/$ITEM"; then
			echo Enter directory "$ITEM"
		else
			file -b "$CURPATH/$ITEM" | sed -e 's@ 9660 CD-ROM filesystem data@@'
		fi
		;;

	select-iso-filter)
		if test X${2+set} '!=' Xset; then
			echo "$0": require CURPATH arg >&2
			exit 1
		fi
		CURPATH="$2"
		if test X"${CURPATH}" '!=' 'X/'; then
			echo ..
		fi
		while read line; do
			if test -d "$CURPATH/$line"; then
				echo "$line"
			elif echo "$line" | grep '\.iso$' > /dev/null 2>&1; then
				echo "$line"
			fi
		done
		;;

	################################################# Browse for ISO

	################################################# Assess ISO

	assess-iso)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO arg >&2
			exit 1
		fi
		ISO="$2"
		rm -rf $WORKDIR/assess > /dev/null 2>&1
		"$0" mkdir-p $WORKDIR/assess/squashfs || exit 1

		REPORT="$WORKDIR"/iso-report
		rm -rf "$REPORT" > /dev/null 2>&1

		"$0" assess-iso-main-structure "$ISO"

		. "$REPORT"

		# Did it even have a structure we recognized?
		if test X"$isomain" '=' Xunknown; then
			# No, back out.
			exit 0
		fi

		SQUASHFS_OK=yes
		# Extract the squashfs files.
		cp $WORKDIR/mnt/$isomain $WORKDIR/assess/squashfs
		if test $? '!=' 0; then
			SQUASHFS_OK=no
		fi
		if test X"$isosecond" '!=' Xnone; then
			cp $WORKDIR/mnt/$isosecond $WORKDIR/assess/squashfs
			if test $? '!=' 0; then
				SQUASHFS_OK=no
			fi
		fi
		if test $SQUASHFS_OK '!=' yes; then
			echo 'squashfsok='\''no'\' >> "$REPORT"
			exit 0
		fi
		# Done with the ISO.
		umount -qnR $WORKDIR/mnt

		# Extract the rootfs from the squashfs.
		ROOTDIR=$WORKDIR/assess/root
		"$0" mkdir-p "$ROOTDIR" || exit 1
		unsquashfs -f -d "$ROOTDIR" $WORKDIR/assess/squashfs/$isomainbase
		if test $? '!=' 0; then
			SQUASHFS_OK=no
		fi
		if test X"$isosecond" '!=' Xnone; then
			unsquashfs -f -d "$ROOTDIR" $WORKDIR/assess/squashfs/$isosecondbase
			if test $? '!=' 0; then
				SQUASHFS_OK=no
			fi
		fi
		echo 'squashfsok='\'$SQUASHFS_OK\' >> "$REPORT"
		if test $SQUASHFS_OK '!=' yes; then
			exit 0
		fi
		# Delete the squashfs
		rm -rf $WORKDIR/assess/squashfs > /dev/null 2>&1

		# Assess the rootfs.
		exec "$0" assess-iso-read-rootfs "$ROOTDIR"
		exit 0
		;;

	# Assess the main structure of the ISO.
	assess-iso-main-structure)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ISO arg >&2
			exit 1
		fi
		ISO="$2"
		REPORT="$WORKDIR"/iso-report

		# Try to mount the ISO
		"$0" iso-mount "$ISO"
		if test $? '!=' 0; then
			echo 'isomain='\''unknown'\' >> "$REPORT"
			exit 0
		fi

		# Determine main structure of .iso
		if test -f $WORKDIR/mnt/casper/filesystem.squashfs; then
			echo 'isomain='\''casper/filesystem.squashfs'\' >> "$REPORT"
			echo 'isomainbase='\''filesystem.squashfs'\' >> "$REPORT"
			echo 'tuxedo='\''no'\' >> "$REPORT"
		elif test -f $WORKDIR/mnt/tuxedo/tuxedo.amd64; then
			echo 'isomain='\''tuxedo/tuxedo.amd64'\' >> "$REPORT"
			echo 'isomainbase='\''tuxedo.amd64'\' >> "$REPORT"
			echo 'tuxedo='\''yes'\' >> "$REPORT"
		elif test -f $WORKDIR/mnt/live/filesystem.squashfs; then
			echo 'isomain='\''live/filesystem.squashfs'\' >> "$REPORT"
			echo 'isomainbase='\''filesystem.squashfs'\' >> "$REPORT"
			echo 'tuxedo='\''no'\' >> "$REPORT"
		else
			echo 'isomain='\''unknown'\' >> "$REPORT"
			umount -qnR $WORKDIR/mnt
			exit 0
		fi
		# Determine if it is a slimbookos ISO with
		# filesystem.gnome.squashfs
		if test -f $WORKDIR/mnt/slimbookos-*.release.txt -a -f $WORKDIR/mnt/casper/filesystem.gnome.squashfs > /dev/null 2>&1; then
			echo 'isosecond='\''casper/filesystem.gnome.squashfs'\' >> "$REPORT"
			echo 'isosecondbase='\''filesystem.gnome.squashfs'\' >> "$REPORT"
			echo 'slimbook='\''yes'\' >> "$REPORT"
		else
			echo 'isosecond='\''none'\' >> "$REPORT"
			echo 'slimbook='\''no'\' >> "$REPORT"
		fi
		# Determine if there is a .manifest-remove
		# file.
		if test -f $WORKDIR/mnt/casper/filesystem.manifest-remove; then
			echo 'isoremove='\''casper/filesystem.manifest-remove'\' >> "$REPORT"
			echo 'isoremovebase='\''filesystem.manifest-remove'\' >> "$REPORT"
		elif test -f $WORKDIR/mnt/live/filesystem.manifest-remove; then
			echo 'isoremove='\''live/filesystem.manifest-remove'\' >> "$REPORT"
			echo 'isoremovebase='\''filesystem.manifest-remove'\' >> "$REPORT"
		else
			echo 'isoremove='\''none'\' >> "$REPORT"
		fi
		exit 0
		;;

	assess-iso-read-os-release)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		REPORT="$WORKDIR"/iso-report
		for FILE in /etc/os-release /usr/lib/os-release; do
			if test -f "$ROOTDIR"$FILE; then
				printf 'osreleasename='\' >> $REPORT
				cat "$ROOTDIR"$FILE | \
				grep '^[ 	]*NAME=' | \
				sed -e 's@^[ 	]*NAME=@@' | \
				sed -e 's@"@@g' | \
				sed -e "s@'@@g" | \
				sed -e 's@$@'\''@' >> $REPORT

				printf 'osreleaseversion='\' >> $REPORT
				cat "$ROOTDIR"$FILE | \
				grep '^[ 	]*VERSION_ID='  | \
				sed -e 's@^[ 	]*VERSION_ID=@@' | \
				sed -e 's@"@@g' | \
				sed -e "s@'@@g" | \
				sed -e 's@$@'\''@' >> $REPORT
				exit 0
			fi
		done
		echo 'osreleasename='\''unknown'\' >> $REPORT
		echo 'osreleaseversion='\''0'\' >> $REPORT
		exit 0
		;;

	assess-iso-find-packager)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		REPORT=$WORKDIR/iso-report
		if test '(' -d $ROOTDIR/etc/apt/sources.list.d -o \
				-f $ROOTDIR/etc/apt/sources.list ')' -a \
			'(' -x $ROOTDIR/bin/apt -o -x $ROOTDIR/usr/bin/apt ')'; then
			echo 'packager='\''apt'\' >> $REPORT
			exit 0
		fi

		# Unknown.
		echo 'packager='\''unknown'\' >> $REPORT
		exit 0
		;;

	assess-iso-find-init)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		REPORT=$WORKDIR/iso-report
		"$0" ensure readlink

		SBIN_INIT=`readlink -q "$ROOTDIR"/sbin/init`
		if echo "$SBIN_INIT" | grep 'systemd' > /dev/null 2>&1; then
			if test '(' -x "$ROOTDIR"/bin/systemctl -o -x "$ROOTDIR"/usr/bin/systemctl ')'; then
				echo 'init='\''systemd'\' >> "$REPORT"
				echo 'initmanager='\''systemctl'\' >> "$REPORT"
				exit 0
			fi
		fi

		echo 'init='\''unknown'\' >> "$REPORT"
		echo 'initmanager='\''unknown'\' >> "$REPORT"
		exit 0
		;;

	# Figure out ZFS installation:
	# 'inside' - builtin to the kernel.
	# 'dkms' - has `zfs-dkms` package.
	# 'none' - needs to download OpenZFS.
	assess-iso-find-zfs)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		REPORT=$WORKDIR/iso-report
		"$0" ensure modinfo

		# Determine if kernel has it naturally.
		for KOFILE in \
				$ROOTDIR/lib/modules/*/kernel/zfs/zfs.ko* \
				$ROOTDIR/lib/modules/*/ubuntu/dkms/zfs/zfs.ko* \
				$ROOTDIR/usr/lib/modules/*/kernel/zfs/zfs.ko*; do
			SIGNER='none'
			if test -f "$KOFILE"; then
				SIGNER="`modinfo "$KOFILE" | grep '^signer:' | sed -e 's@^signer:[ 	]*@@' | sed -e 's@[ 	]*$@@'`"
			fi
			if test '(' X"$SIGNER" '=' 'XCanonical Ltd. Kernel Module Signing' ')' -o \
				'(' X"$SIGNER" '=' 'XBuild time autogenerated kernel key' ')'; then
				echo 'zfs='\''inside'\' >> "$REPORT"
				exit 0
			fi
		done

		# Determine packager.
		. "$REPORT"

		if test X"$packager" '=' 'Xapt'; then
			if chroot "$ROOTDIR" /usr/bin/env apt show zfs-dkms > /dev/null 2>&1; then
				echo 'zfs='\''dkms'\' >> "$REPORT"
				exit 0
			fi
		fi

		echo 'zfs='\''none'\' >> "$REPORT"
		exit 0
		;;

	assess-iso-find-initrd-maker)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		REPORT=$WORKDIR/iso-report

		# TODO: Find better way to check.
		if test -f "$ROOTDIR"/etc/initramfs-tools/initramfs.conf -a \
				-f "$ROOTDIR"/etc/kernel/postinst.d/initramfs-tools -a \
				'(' -x "$ROOOTDIR"/sbin/mkinitramfs \
				-o -x "$ROOTDIR"/usr/sbin/mkinitramfs \
				-o -x "$ROOOTDIR"/bin/mkinitramfs \
				-o -x "$ROOTDIR"/usr/bin/mkinitramfs \
				')'; then
			echo 'initrdmaker='\''initramfs'\' >> "$REPORT"
			exit 0
		elif test -d "$ROOTDIR"/etc/dracut.conf.d -a \
				-f "$ROOTDIR"/etc/kernel/postinst.d/dracut -a \
				'(' -x "$ROOTDIR"/sbin/dracut \
				-o -x "$ROOTDIR"/usr/sbin/dracut \
				-o -x "$ROOTDIR"/bin/dracut \
				-o -x "$ROOTDIR"/usr/bin/dracut \
				')'; then
			echo 'initrdmaker='\''dracut'\' >> "$REPORT"
			exit 0
		fi

		echo 'initrdmaker='\''unknown'\' >> "$REPORT"
		exit 0
		;;

	assess-iso-read-rootfs)
		if test X${2+set} '!=' Xset; then
			echo "$0": require ROOTDIR arg >&2
			exit 1
		fi
		ROOTDIR="$2"
		"$0" assess-iso-read-os-release "$ROOTDIR" || exit 1
		"$0" assess-iso-find-packager "$ROOTDIR" || exit 1
		"$0" assess-iso-find-init "$ROOTDIR" || exit 1
		"$0" assess-iso-find-zfs "$ROOTDIR" || exit 1
		"$0" assess-iso-find-initrd-maker "$ROOTDIR" || exit 1
		exit 0
		;;

	# Convert the $WORKDIR/iso-report to a
	# human-understandable $WORKDIR/iso-report-human
	assess-iso-report-human)
		REPORTHUMAN=$WORKDIR/iso-report-human
		if test '!' -f $WORKDIR/iso-report; then
			echo "$0": No $WORKDIR/iso-report >&2
			exit 1
		fi
		rm -rf $REPORTHUMAN > /dev/null 2>&1
		. $WORKDIR/iso-report
		if test $isomain '=' unknown; then
			cat >> "$REPORTHUMAN" <<REPORT
ISO is not recognized as a Live environment
Cannot install
REPORT
			exit 1
		elif test $squashfsok '!=' yes; then
			cat >> "$REPORTHUMAN" <<REPORT
Extraction of files from Live environment failed
Cannot install
REPORT
			exit 1
		fi

		# Check packager
		case "$packager" in
		apt)
			;;

		*)
			cat >> "$REPORTHUMAN" <<REPORT
Unsupported package manager: $packager
Cannot install
REPORT
			exit 1
			;;

		esac

		# Check init system
		case "$init" in
		systemd)
			;;

		*)
			cat >> "$REPORTHUMAN" <<REPORT
Unsupported init system: $init
Cannot install
REPORT
			exit 1
			;;

		esac

		# Check initrdmaker
		case "$initrdmaker" in
		dracut|initramfs)
			;;

		*)
			cat >> "$REPORTHUMAN" <<REPORT
Unsupported initrd maker: $initrdmaker
Cannot install
REPORT
			exit 1
			;;

		esac

		echo 'Distro:' "$osreleasename" "$osreleaseversion" >> "$REPORTHUMAN"
		if test $tuxedo = yes; then
			echo '(TUXEDO-OS detected)' >> "$REPORTHUMAN"
		fi
		if test $slimbook = yes; then
			echo '(SlimbookOS detected)' >> "$REPORTHUMAN"
		fi
		echo >> "$REPORTHUMAN"
		echo 'packager='$packager 'init='$init 'initrd='$initrdmaker >> "$REPORTHUMAN"
		echo >> "$REPORTHUMAN"

		case $zfs in
		inside)
			echo "Kernel includes ZFS" >> "$REPORTHUMAN"
			;;

		dkms)
			echo "Repositories include ZFS as DKMS" >> "$REPORTHUMAN"
			;;

		none)
			echo "No ZFS; will build ZFS from source" >> "$REPORTHUMAN"
			;;

		esac

		cat >> "$REPORTHUMAN" <<REPORT

Likely can be installed.
REPORT

		exit 0
		;;

	################################################# Assess ISO

        ################################################# Main Menu

	Initialize)
		"$0" initialize-interview &&
		"$0" confirm
		if test $? '!=' 0; then
			echo "---- zfsbootmenu-installer: Initialize: cancelled"
			exit 0
		fi

		"$0" initialize-processing $TANK_NAME
		EXIT_CODE=$?
		$0 clean-up-work
		if test $EXIT_CODE '!=' 0; then
			echo "$0": Failed, destroying zpool $TANK_NAME >&2
			zpool destroy $TANK_NAME
		fi
		exit $EXIT_CODE
		;;

	AddBootEnvironment)
		DISTRO=`"$0" select-distro "Add Boot Environment"`
		if test -f "$DISTRO"; then
			:
		elif "$0" distro check "$DISTRO"; then
			"$0" check-distro-not-installed "$DISTRO" || exit 1
		else
			echo "---- zfsbootmenu-installer: AddBootEnvironment: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: AddBootEnvironment: $DISTRO"
		"$0" prepare-work-from-existing
		if test $? '!=' 0; then
			"$0" clean-up-work
			exit 1
		fi
		"$0" install-distro-or-fromiso "$DISTRO"
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

	ChangeDefaultBoot)
		NEWBOOTFS=`"$0" select-boot-environment 'to set as default'`
		if zfs list "$NEWBOOTFS" > /dev/null 2>&1; then :; else
			echo "---- zfsbootmenu-installer: ChangeDefaultBoot: cancelled"
			exit 0
		fi
		zpool set bootfs="$NEWBOOTFS" $TANK_NAME
		echo "---- zfsbootmenu-installer: ChangeDefaultBoot: Default set to $NEWBOOTFS"
		exit 0
		;;

	ReflashESP)
		DISK=`"$0" select-disk-reflash-esp`
		if "$0" disk-has-esp "$DISK"; then :; else
			echo "---- zfsbootmenu-installer: ReflashESP: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: ReflashESP: $DISK"
		"$0" prepare-esp-in-work && \
		"$0" flash-esp-from-work $DISK
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

	PrepareNewDisk)
		DISKS="`"$0" select-disks 'to format for array (Prepare New Disk)' yes`"
		OK=no
		# Assumes paths don't have spaces T.T
		for DISK in $DISKS; do
			OK=yes
			# assumes break doesn't exist yet
		done
		if test "$OK" '=' 'no'; then
			echo "---- zfsbootmenu-installer: PrepareNewDisk: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: PrepareNewDisk: $DISKS"

		"$0" mkdir-p $WORKDIR
		rm -rf $WORKDIR/to-confirm > /dev/null 2>&1
		echo ANY DATA ON THESE DISKS WILL BE DESTROYED.  > $WORKDIR/to-confirm
		for DISK in $DISKS; do
			echo >> $WORKDIR/to-confirm
			"$0" describe-disk "$DISK" >> $WORKDIR/to-confirm
		done
		if "$0" confirm; then :; else
			"$0" clean-up-work
			echo "---- zfsbootmenu-installer: PrepareNewDisk: cancelled"
			exit 0
		fi

		"$0" prepare-esp-in-work && \
		"$0" format-disks $DISKS
		EXIT_CODE=$?
		"$0" clean-up-work
		exit $EXIT_CODE
		;;

	ChrootIntoBootEnvironment)
		BE=`"$0" select-boot-environment 'to chroot into'`
		if zfs list "$BE" > /dev/null 2>&1; then :; else
			echo "---- zfsbootmenu-installer: ChrootIntoBootEnvironment: cancelled"
			exit 0
		fi
		if test X"`zfs get -H -o value mounted $BE`" '=' Xyes; then
			echo "---- zfsbootmenu-installer: ChrootIntoBootEnvironment: Already mounted: $BE"
			exit 1
		fi
		echo "---- zfsbootmenu-installer: ChrootIntoBootEnvironment: $BE"
		"$0" mkdir-p $WORKDIR/mnt || exit 1
		zfs set mountpoint=legacy $BE
		mount -t zfs $BE $WORKDIR/mnt
		if test $? '!=' 0; then
			echo "$0": Could not mount >&2
			umount -qnR $WORKDIR/mnt
			rm -rf $WORKDIR
			exit 1
		fi

		"$0" mount-magic-to-new-distro
		if test $? '!=' 0; then
			echo "$0": Could not mount magic devices >&2
			umount -qnR $WORKDIR/mnt
			rm -rf $WORKDIR
			exit 1
		fi

		"$0" chroot-into-mnt

		umount -qnR $WORKDIR/mnt
		zfs set mountpoint=/ $BE
		rm -rf $WORKDIR
		exit 0
		;;

	chroot-into-mnt)
		# Find a shell
		for SHELL in /bin/bash /usr/bin/bash /bin/fish /usr/bin/fish /bin/dash /usr/bin/dash /bin/sh; do
			if test -x $WORKDIR/mnt$SHELL; then
				exec chroot $WORKDIR/mnt $SHELL
			fi
		done
		;;

	AssessISO)
		ISO="`"$0" select-iso`"
		if test $? '!=' 0; then
			echo "---- zfsbootmenu-installer: AssessISO: cancelled"
			exit 0
		fi
		echo "---- zfsbootmenu-installer: AssessISO: Extracting and assessing..."
		"$0" assess-iso "$ISO"
		if test -f $WORKDIR/iso-report; then
			"$0" assess-iso-report-human
			if test -f "$WORKDIR"/iso-report-human; then
				ISONAME="`echo "$ISO" | grep -o '[^/]*$'`"
				whiptail --title "$ISONAME" --textbox $WORKDIR/iso-report-human 18 64 2> /dev/null
			fi
		fi
		echo "---- zfsbootmenu-installer: AssessISO: cleaning up..."
		"$0" clean-up-work
		exit 0
		;;

        ################################################# Main Menu

	*)
		echo "$0": Unknown sub-command: "$1" >&2
		exit 1
		;;


	esac

	exit 0
fi

if test X${EUID:-$(id -u)} '!=' X0; then
	echo "$0": not running as superuser, aborting >&2
	exit 1
fi
if test '!' -x "$0"; then
	chmod a+x "$0"
fi
if test -e $WORKDIR; then
	cat >&2 <<ERR
$0: $WORKDIR present, aborting
$0: If you are sure no other instance is running, do as superuser:
$0:     umount -qnR $WORKDIR/mnt
$0:     rm -rf $WORKDIR
ERR
	exit 1
fi

MAINMENU='Exit\nAbout\n'

if "$0" detect-installed; then
	MAINMENU="$MAINMENU"'AddBootEnvironment\nChangeDefaultBoot\nReflashESP\nPrepareNewDisk\nChrootIntoBootEnvironment\n'
else
	MAINMENU="$MAINMENU"'Initialize\n'
fi

MAINMENU="$MAINMENU"'AssessISO\n'

if which fzf > /dev/null 2>&1; then :; else
	echo "---- zfsbootmenu-installer: Installing needed tools"
	for TOOL in fzf whiptail wget cracklib-check isoinfo; do
		if "$0" ensure "$TOOL"; then :; else
			echo "$0": Unable to ensure needed tools >&2
			exit 1
		fi
	done
fi
FZF_DEFAULT_COMMAND=
FZF_DEFAULT_OPTS=
FZF_DEFAULT_OPTS_FILE=
FZF_API_KEY=
export FZF_DEFAULT_COMMAND
export FZF_DEFAULT_OPTS
export FZF_DEFAULT_OPTS_FILE
export FZF_API_KEY

SEL=`printf "$MAINMENU" | fzf --layout=reverse-list --no-sort --border --border-label='zfsbootmenu-installer '"$VERSION"' Main Menu'  --preview="$0"' preview-mainmenu {}'`

case $SEL in
	Initialize|AddBootEnvironment|ChangeDefaultBoot|ReflashESP|PrepareNewDisk|ChrootIntoBootEnvironment|AssessISO)
		;;

	*)
		exit 0
		;;

esac

exec "$0" "$SEL"
