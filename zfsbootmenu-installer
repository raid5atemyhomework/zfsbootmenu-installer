	typical-install-chroot-make-user-homedir-only)
		USERNAME="`cat /usr/local/username`"
		# If it already exists, don't mess with it!
		if test -d /home/"${USERNAME}"; then
			echo "---- zfsbootmenu-installer: typical: /home/${USERNAME} exists, NOT messing with it."
			sleep 1
		# If there's a skel, copy it!
		elif test -d /etc/skel; then
			echo "---- zfsbootmenu-installer: typical: /etc/skel -> /home/${USERNAME}"
			cp -a /etc/skel /home/"${USERNAME}"
			if test '!' -d /home/"${USERNAME}"; then
				echo "$0": Failed to create user homedir >&2
				exit 1
			fi
			chown -R "${USERNAME}":"${USERNAME}" /home/"${USERNAME}"
		# No skel, make empty homedir
		else
			echo "---- zfsbootmenu-installer: typical: No /etc/skel, making empty /home/${USERNAME}"
			mkdir /home/"${USERNAME}"
			if test '!' -d /home/"${USERNAME}"; then
				echo "$0": Failed to create user homedir >&2
				exit 1
			fi
			chown -R "${USERNAME}":"${USERNAME}" /home/"${USERNAME}"
		fi
		exit 0
		;;

