	typical-install-chroot-juggle-home-dataset)
		echo "---- zfsbootmenu-installer: typical: Mounting /home"
		zfs mount $TANK_NAME/home || exit 1
		# If the canmount property is not `on`,
		# set it to `on` here while inside the
		# chroot.
		# This is necessary as the home dataset
		# is first created with canmount=noauto
