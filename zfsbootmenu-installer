			if test X$EXIT_CODE '!=' X0; then
				echo "$0": Could not add user $USERNAME to $GROUP >&2
				exit $EXIT_CODE
			fi
		done
		echo "${USERNAME} ALL=(ALL) NOPASSWD: ALL" >/etc/sudoers.d/"${USERNAME}"
		chown root:root /etc/sudoers.d/"${USERNAME}"
		chmod 400 /etc/sudoers.d/"${USERNAME}"
		exit 0
		;;

