	# Debian Derivative

	# Installs our hooks to changes in the system.
	debian-derivative-install-zbmi-hooks)
		echo "---- zfsbootmenu-installer: typical: Enabling dpkg hooks for ZFSBootMenu and Secure Boot integration."
		# Make sure df and tail are available
		# since zbmi hooks use them.
		apt install -y --no-install-recommends coreutils || exit 1
		"$0" zbmi-install-dpkg-post-hook || exit 1
		"$0" mkdir-p /etc/dpkg/dpkg.cfg.d || exit 1
		cat > /etc/dpkg/dpkg.cfg.d/zz-zbmi-dpkg-hooks <<CONFIG
post-invoke=/usr/local/lib/zfsbootmenu-installer/dpkg-post-hook
CONFIG
		exec test -f /etc/dpkg/dpkg.cfg.d/zz-zbmi-dpkg-hooks
		;;


	debian-derivative-override-mok)
		echo "---- zfsbootmenu-installer: debian derivative: Overriding distro MOKs"
		# Ubuntu creates these /var/lib/shim-signed/mok/MOK.priv and MOK.der
		"$0" mkdir-p /var/lib/shim-signed/mok || exit 1
		cp --reflink=auto /usr/local/mok/MOK.priv /var/lib/shim-signed/mok/MOK.priv
		cp --reflink=auto /usr/local/mok/MOK.der /var/lib/shim-signed/mok/MOK.der
		chmod 600 /var/lib/shim-signed/mok/MOK.priv
		# Debian creates these /var/lib/dkms/mok.key and mok.pub
		"$0" mkdir-p /var/lib/dkms || exit 1
		cp --reflink=auto /usr/local/mok/MOK.priv /var/lib/dkms/mok.key
		cp --reflink=auto /usr/local/mok/MOK.der /var/lib/dkms/mok.pub
		chmod 600 /var/lib/dkms/mok.key
		exit 0
		;;

	# Sets up DKMS to sign with the MOK.
	# This is technically incomplete --- the distribution
	# might include closed-source (or even open-source, but
	# precompiled) kernel modules that are not signed by
	# Microsoft or Canonical (sometimes called `kmod`, but
	# `kmod` is a tool that inserts and removes kernel
	# modules from the running kernel...), and those have
	# to be signed by the MOK.
	# No idea how to automate *those*, maybe hack into
	# apt hooks?
	dkms-mok-auto-sign)
		echo "---- zfsbootmenu-installer: DKMS: setup kernel module autosign"
		"$0" mkdir-p /etc/dkms/framework.conf.d || exit 1
		# Newer DKMS will NOT sign in a chroot unless
		# `try_sign_modules=true`.
		# Older DKMS should ignore the setting, I hope.
		cat > /etc/dkms/framework.conf.d/00-0-sign-with-mok.conf <<FILE
try_sign_modules=true
mok_signing_key=/usr/local/mok/MOK.priv
mok_certificate=/usr/local/mok/MOK.der
FILE
		if test -f /etc/dkms/framework.conf.d/00-0-sign-with-mok.conf; then
			exit 0
		else
			exit 1
		fi
		;;

	# Try to sign all the DKMS modules in
	# their build envs, then install them
	# to the correct place using dkms.
	# sbsigntool and dkms must be installed
	# before this.
	# If we somehow can't find the build dir
	# and the signer binary, fallback to
	# doing dkms build --force
	dkms-sign-all-modules)
		echo "---- zfsbootmenu-installer: Can we just sign DKMS modules?"
		if which kmodsign > /dev/null 2>&1; then :; else
			# Use fallback
			echo "---- zfsbootmenu-installer: No kmodsign.  Rebuild instead."
			exec "$0" dkms-force-rebuild
		fi
		for DIR in /var/lib/dkms; do
			if test -d "$DIR"; then
				exec "$0" dkms-sign-all-modules-in "$DIR"
			fi
		done
		echo "---- zfsbootmenu-installer: Don't know build dir.  Rebuild instead."
		exec "$0" dkms-force-rebuild
		;;

	dkms-sign-all-modules-in)
		if test X"${2+set}" '!=' Xset; then
			echo "$0": require DIR argument >&2
			exit 1
		fi
		DIR="$2"
		echo "---- zfsbootmenu-installer: Try looking for and signing modules in $DIR"
		"$0" dkms-status-commandline | \
		while read line; do
			MODULE=`echo "$line" | grep -o '^[^ ]*'`
			KERVERSION=`echo "$line" | sed -e 's@^[^ ]* -k \(.*\)$@\1@'`
			echo "---- zfsbootmenu-installer: Processing $MODULE for kerversion $KERVERSION"
			SIGNED=no
			HASH_ALGO=unknown

			# Find CONFIG_MODULE_SIG_HASH in the
			# corresponding kernel config
			KERBLD=/lib/modules/$KERVERSION/build
			KERCONF=unknown
			for MAYBEKERCONF in "$KERBLD"/.config "$KERBLD"/include/config/auto.conf; do
				if test -f "$MAYBEKERCONF"; then
					KERCONF="$MAYBEKERCONF"
				fi
			done
			if test $KERCONF '!=' unknown; then
				HASH_ALGO=`grep '^CONFIG_MODULE_SIG_HASH=' "$KERCONF"| cut -f 2 -d= | sed 's@"@@g'`
			fi

			MODULEDIR="$DIR"/$MODULE/$KERVERSION/x86_64/module
			if test $HASH_ALGO '!=' unknown -a -d "$MODULEDIR"; then
				"$0" dkms-sign-kmods-in "$MODULEDIR" "$HASH_ALGO"
				if test $? '=' 0; then
					SIGNED=yes
				fi
			fi

			# Could not sign it?
			# Fall back to a full rebuild.
			if test $SIGNED '=' no; then
				echo "---- zfsbootmenu-installer: Failed to sign. Rebuilding."
				dkms build $MODULE -k $KERVERSION --force
			fi
			dkms install $MODULE -k $KERVERSION --force --no-depmod
		done
		exit 0
		;;

	dkms-sign-kmods-in)
		if test X"${3+set}" '!=' Xset; then
			echo "$0": require MODULEDIR HASH argument >&2
			exit 1
		fi
		MODULEDIR="$2"
		HASH="$3"
		echo "---- zfsbootmenu-installer: Signing in $MODULEDIR with $HASH"
		for FILE in "$MODULEDIR"/*.ko "$MODULEDIR"/*.ko.zst "$MODULEDIR"/*.ko.xz "$MODULEDIR"/*.ko.gz; do
			if test -f $FILE; then
				# Decompress to /to-sign.ko
				case "$FILE" in
				*.ko)
					cp "$FILE" /to-sign.ko
					;;

				*.ko.zst)
					zstd -q -T0 -d "$FILE" -o /to-sign.ko
					;;

				*.ko.xz)
					cat "$FILE" | xz -d - > /to-sign.ko
					;;

				*.ko.gz)
					cat "$FILE" | gzip -d -c > /to-sign.ko
					;;

				esac

				# sign
				kmodsign "$HASH" \
					/usr/local/mok/MOK.priv \
					/usr/local/mok/MOK.der \
					/to-sign.ko || exit 1

				rm -rf "$FILE" > /dev/null 2>&1

				# Compress from /to-sign.ko
				# to original.
				case "$FILE" in
				*.ko)
					cp /to-sign.ko "$FILE"
					;;

				*.ko.zst)
					zstd -q -T0 -z /to-sign.ko -o "$FILE"
					;;

				*.ko.xz)
					cat /to-sign.ko | xz --check=crc32 --lzma2=dict=1MiB -z - > "$FILE"
					;;

				*.ko.gz)
					cat /to-sign.ko | gzip -c > "$FILE"

				esac

				rm -rf /to-sign.ko > /dev/null 2>&1
			fi
		done
		;;

	# Fallback: we scan dkms status and
	# force build and install of every
	# line.
	dkms-force-rebuild)
		echo "---- zfsbootmenu-installer: Rebuild all DKMS modules"
		"$0" dkms-status-commandline | \
		while read line; do
			echo "---- zfsbootmenu-installer: Rebuild $line"
			dkms build $line --force
			dkms install $line --force --no-depmod
		done
		exit 0
		;;

	# outputs a sequence of:
	#   module/0.8.0 -k 7.0.0-42-generic
	dkms-status-commandline)
		dkms status | \
		grep -o '^[^,][^,]*, [^,][^,]*,' | \
