	# Grub elimination (debian derivative)

	# Eliminate grub and other lesser bootloaders.
	#
	# Our problems are:
	#
	# - If `grub-common` remains installed, it will
	#   keep triggering `grub-probe`, which searches
	#   for `vmlinuz` files... including in our
	#   snapshots, which makes it take a LONG time,
	#   for something that is not actually useful
	#   in our Grub-free environment.
	# - If we explicitly `apt remove --allow-remove-essential grub-common`
	#   then some distros, such as TUXEDO and Zorin
	#   OS, will fail to install correctly, because
	#   they have packages that strongly `Depends:`
	#   on `grub-common`.
	# - We can mark `grub-common` and friends as
	#   `apt-mark auto`, but they won't be
	#   `apt autremove`d because they are "essential"
	#   system packages.
	#   The only way to remove them is by explicit
	#   `apt remove --allow-remove-essential`, but
	#   see above.
	#   (`apt autoremove` ignores `--allow-remove-essential`)
	#
	# Thus, we need to do tracking of `apt-mark showmanual`
	# and `apt-cache rdepends` ourselves.
	debian-derivative-eliminate-grub)
		# Prepare the list of manually-installed
		# packages.
		rm -rf /.showmanual > /dev/null 2>&1
		apt-mark showmanual > /.showmanual

		# Perform our processing.
		"$0" debian-derivative-eliminate-grub-core
		EXIT_CODE=$?
		# Remove our temporary file.
		rm -rf /.showmanual > /dev/null 2>&1
		exit $EXIT_CODE
		;;

	debian-derivative-eliminate-grub-core)
		echo "---- zfsbootmenu-installer: debian derivative: Eliminating lesser bootloaders: finding safely removable packages"
		rm -rf /.toeliminate > /dev/null 2>&1
		printf '' > /.toeliminate

		# We list both grub-efi-amd64 and
		# grub-pc because by default, if you
		# remove one, it'll install the other.
		# You need to explicitly tell it to
		# remove both.
		for CANDIDATE in \
			kernelstub \
			grub-common grub2-common \
			shim shim-signed \
			os-prober \
			grub-efi-amd64 grub-efi \
			grub-efi-amd64-unsigned \
			grub-efi-amd64-dbg \
			grub-pc grub-pc-dbg \
			grub-efi-ia32 \
			grub-efi-ia32-unsigned \
			grub-efi-ia32-dbg \
			nullboot \
			; do
			# Is it even in the repos?
			if apt show $CANDIDATE > /dev/null 2>&1; then
				# We do NOT check if the $CANDIDATE
				# is installed!
				# As mentioned above, by default, if
				# you uninstall grub-efi-amd64 then
				# the system will install grub-pc.
				# It's important to explicitly
				# specify EVERY candidate listed above
				# so apt knows not to install
				# replacements.

				# The apt-cache command below will
				# search for reverse dependencies
				# (i.e. packages that need the
				# $CANDIDATE) and print them out.
				# We feed it into the helper
				# -find-manual function, which takes
				# stdin and looks for packages in
				# /.showmanual to see if there are
				# matches.
				# If there are none, the helper
				# then adds it to the
				# /.toeliminate
				apt-cache rdepends \
					--recurse --installed \
					--no-recommends --no-suggests \
					$CANDIDATE | \
				grep '^[^ ]' | \
				grep -iv 'reverse depends' | \
				$0 debian-derivative-eliminate-grub-find-manual "$CANDIDATE"
			fi
		done
		TOELIM="`cat /.toeliminate`"
		if test X"$TOELIM" '!=' X; then
			echo "---- zfsbootmenu-installer: debian derivative: Eliminating lesser bootloaders: removing" $TOELIM
			yes | apt remove -y --allow-remove-essential $TOELIM
			EXIT_CODE=$?
		else
			EXIT_CODE=0
		fi
		rm -rf /.toeliminate /.showmanual > /dev/null 2>&1
		exit $EXIT_CODE
		;;

	debian-derivative-eliminate-grub-find-manual)
		if test X"${2+set}" '!=' Xset; then
			echo "$0": require CANDIDATE arg >&2
			exit 1
		fi
		CANDIDATE="$2"
		if test '!' -f /.showmanual; then
			echo "$0": No /.showmanual file >&2
			exit 1
		fi
		while read line; do
			for PKG in $line; do
				MPKG="`grep '^'"$PKG"'$' /.showmanual`"
				if test X"$PKG" '=' X"$MPKG"; then
					echo "$CANDIDATE needed by $MPKG"
					# Found matching
					# package, not a
					# candidate for
					# removal
					exit 0
				fi
			done
		done
		echo Eliminate: $CANDIDATE
		echo "$CANDIDATE" >> /.toeliminate
		exit 0
		;;

