VERSION=1.1.0

# Convenient names.
# These are NOT intended to be modifiable.

WORKDIR="/zfsbootmenu-installer-work"
TANK_NAME=zroot
LOCALSRCDIR="/usr/local/src"

# For best portability, we assume shell functions are not supported.
# For code organization purposes, the case $1 below is effectively
# our "shell functions", and has the advantage that we can easily
# invoke them from the command line for development testing.

if test X${1+set} '=' Xset; then
	case $1 in
	--help|-h)
		cat <<HELP
[sudo] zfsbootmenu-installer

   Launches an interactive wizard for ZFSBootMenu
   installation and creation of a ZFS pool, and
   installs a supported distro as the first Boot
   Environment.

   If you are already in a ZFSBootMenu setup with a
   ZFS pool, you can add a new Boot Environment with
   an install of a supported distro, or prepare new
   disks to add or replace into your array.

   This command must be run as root.
   When initially installing, you should use an Ubuntu
   Live CD or rescue disk, or a similar Debian
   derivative with a ZFS kernel.
   Boot Environments installed by this tool will also
   have this tool (and its dependencies) installed so
   that you can add alternate Boot Environments,
   regardless of the distro in that Boot Environment.

zfsbootmenu-installer --help

   Display this help

zfsbootmenu-installer --version

   Display the version

zfsbootmenu-installer <command> <args>....

   Run an internal part of this tool; this is not
   intended for end-users.

Send bug reports to raid5atemyhomework@protonmail.com
This tool is released under an MIT license.
HELP
		exit 0
		;;
	--version|-v)
		cat <<VERSION
zfsbootmenu-installer ${VERSION}
Copyright 2026 raid5atemyhomework
This tool is released under an MIT license.
VERSION
		exit 0
		;;

	preview-mainmenu)
		case $2 in
			Initialize)
				cat <<DESC
Format one or more block devices, install ZFSBootMenu
bootloader on all of them with Secure Boot support, and
create a ZFS Pool '${TANK_NAME}' from them, then install
one supported distro:

DESC
				"$0" distro list
				cat <<DESC

This can also install from a Live .iso from many
Debian-derived or Ubuntu-derived distros.
DESC
				;;

			AddBootEnvironment)
				cat <<DESC
Add a new Boot Environment, installing one supported
distro:

DESC
				"$0" distro list
				cat <<DESC

This can also install from a Live .iso from many
Debian-derived or Ubuntu-derived distros.
DESC
				;;

			ChangeDefaultBoot)
				cat <<DESC
Change the Boot Environment that ZFSBootMenu will default
to booting the machine into.
DESC
				;;

			ReflashESP)
				cat <<DESC
Re-download ZFSBootMenu and install it into the EFI
System Partition of a block device.
DESC
				;;

			PrepareNewDisk)
				cat <<DESC
Format a block device, creating an EFI System Partition
on it, and re-download and install ZFSBootMenu on it.

Use this to prepare a device before adding it to your
ZFS Pool array to replace a broken device or to
increase the pool's capacity.
DESC
				;;

			ChrootIntoBootEnvironment)
				cat <<DESC
Temporarily mount another Boot Environment and run a
chroot shell inside it.

While inside the shell, its mountpoint will be
legacy and it will be unbootable if you force
turning off the running Boot Environment.

On normal exit, it will be unmounted and its
mountpoint returned to normal /
DESC
				;;

			AssessISO)
				cat <<DESC
Analyze a selected .iso file and give a prognosis
on whether 'zfsbootmenu-installer' can install
it successfully.

Use this before selecting an .iso file to
install with Initialize or AddBootEnvironment.
DESC
				;;

			Exit)
				cat <<DESC
Exit this tool.
DESC
				;;

			About)
				cat <<DESC
'zfsbootmenu-installer' is a tool to set up a ZFS
array and install a bootable GNU/Linux distro on
it, with the root as a dataset on the ZFS array
and '/home' as a separate ZFS dataset.

ZFSBootMenu is used as the bootloader, and the
installed system can be run with Secure Boot.

After initializing your system with 'Initialize',
'zfsbootmenu-installer' will also install itself
in '/usr/local/bin'.
You can then use it to install additional
GNU/Linux distros on the same ZFS array (sharing
the same '/home', and allowing you to multi-boot
between them), select the default distro to boot,
or prepare new disks to add or replace into your
array.
DESC
				;;

		esac
		exit 0
		;;

	mkdir-p)
		DIRNAME="$2"
		mkdir -p "$DIRNAME" || exit 1
		if test -d "$DIRNAME"; then :; else
			echo "$0": Unable to create "'$DIRNAME'" >&2
			exit 1
		fi
		exit 0
		;;

        ################################################# ensures

	# TODO: Adapt to the system's package manager.
	ensure)
		if test X${2+set} '!=' Xset; then
			echo "$0": require TOOL argument >&2
			exit 1
		fi
		TOOL="$2"
		if which "$TOOL" > /dev/null 2>&1; then
			# Already installed.
			exit 0
		fi
		# TODO: figure out the system's package manager
		exec "$0" ensure-apt "$TOOL"
		;;

	ensure-apt)
		if test X${2+set} '!=' Xset; then
			echo "$0": require TOOL argument >&2
			exit 1
		fi
		TOOL="$2"
		case "$TOOL" in
			# Add special cases here where
			# the tool name is not the same
			# as the package name.
			# Note that various distros might
			# have different package namings
			# too.... SIGH
			# Worse, some distros might put
			# some tools together, that other
			# distros keep in separate packages.
			# This is why 'ensure' names tools
			# and not packages.

			# For tools whose package has
			# different names depending on
			# distro, we could do:
			#      apt install -y distro1-package > /dev/null 2>&1
			#      apt install -y package-distro2 > /dev/null 2>&1
			#      if which "$TOOL" > /dev/null 2>&1; then
			#          exit 0
			#      else
			#          echo "$0": Failed to install $TOOL >&2
			#          exit 1
			#      fi

			ar)
				PACKAGE=binutils
				;;

			awk)
				PACKAGE=gawk
				;;

			blkdiscard|logger|lsblk|wipefs)
				PACKAGE=util-linux
				;;

			cracklib-check)
				PACKAGE=cracklib-runtime
				;;

			df|readlink|sha256sum|sort|tail)
				PACKAGE=coreutils
				;;

			iconv)
				PACKAGE=libc-bin
				;;

			isoinfo)
				PACKAGE=genisoimage
				;;

			mkfs.vfat)
				PACKAGE=dosfstools
				;;

			modinfo)
				PACKAGE=kmod
				;;

			pacstrap)
				PACKAGE=arch-install-scripts
				;;

			sbsign|sbverify)
				PACKAGE=sbsigntool
				;;

			sgdisk)
				PACKAGE=gdisk
				;;

			udevadm)
				PACKAGE=udev
				;;

			unsquashfs)
				PACKAGE=squashfs-tools
				;;

			xz)
				PACKAGE=xz-utils
				;;

			*)
				PACKAGE="$TOOL"
				;;

		esac
		apt install -y "$PACKAGE" > /dev/null 2>&1
		if test $? '!=' 0; then
			echo "$0": Failed to ensure "'"$TOOL"'" installed. >&2
			exit 1
		fi
		;;

        ################################################# ensures

	################################################# Detect Installation

	detect-installed)
		if test '!' '(' -d /usr/local/mok -a \
				-f /usr/local/mok/MOK.priv -a \
				-f /usr/local/mok/MOK.pem -a \
				-f /usr/local/mok/MOK.der -a \
				-f /usr/local/username -a \
				-f /etc/zfs/zroot.key \
				')'; then
			exit 1
		fi
		if which zpool > /dev/null 2>&1; then :; else
			exit 1
		fi
		if zpool list "$TANK_NAME" > /dev/null 2>&1; then :; else
			exit 1
		fi
		exit 0
		;;

	################################################# Detect Installation

	################################################# Keyrings

	keyring)
		if test X${2+set} '!=' Xset; then
			echo "$0": Need KEYRING arguments >&2
			exit 1
		fi
		KEYRING=$2
		"$0" ensure gpg || exit 1

		rm -rf $WORKDIR/keyring.gpg $WORKDIR/gnupg > /dev/null 2>&1

		"$0" mkdir-p $WORKDIR/gnupg || exit 1
		chmod 700 $WORKDIR/gnupg

		"$0" keyring-asc $KEYRING $WORKDIR/keyring.asc || exit 1
		gpg --keyring gnupg-ring:$WORKDIR/keyring.gpg --no-default-keyring \
			--homedir $WORKDIR/gnupg \
			--import $WORKDIR/keyring.asc
		EXIT_CODE=$?
		rm -rf $WORKDIR/keyring.asc $WORKDIR/gnupg > /dev/null 2>&1
		if test $? '!=' 0; then
			rm -rf $WORKDIR/keyring.gpg > /dev/null >&2
			echo "$0": Failed to import keyring >&2
			exit 1
		fi
		exit 0
		;;

	keyring-asc)
